---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="RKMIDIGILABS — Company Profile & Official Corporate Brochure"
  description="Official company profile, capability brochure, and verified social media channels for RKMIDIGILABS. Specializing in AI Governance (AIGP), Enterprise GRC, and Corporate Training."
>
  <!-- Dedicated Print Styling for PDF Brochure Export -->
  <style is:inline>
    @media print {
      header, footer, nav, #social-channels, .no-print {
        display: none !important;
      }
      body {
        background: white !important;
        color: black !important;
        font-family: Calibri, 'Carlito', Arial, sans-serif !important;
      }
      .brochure-container {
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        box-shadow: none !important;
        border: none !important;
      }
      .page-break {
        page-break-before: always;
      }
    }
  </style>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-16">
    
    <!-- Top Breadcrumb & Actions Bar (Hidden on Print) -->
    <div class="no-print flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-8 mb-8 border-b border-slate-200">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 border border-slate-300 text-xs font-mono font-bold uppercase text-slate-700">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Verified Corporate Capability Showcase
        </div>
        <h1 class="text-2xl sm:text-4xl font-black text-black tracking-tight mt-2">
          RKMIDIGILABS Profile & Corporate Brochure
        </h1>
      </div>

      <!-- Action Buttons: Print PDF & Book Consultation -->
      <div class="flex items-center gap-3 w-full sm:w-auto">
        <button 
          type="button" 
          onclick="window.print()" 
          class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg text-xs sm:text-sm font-bold bg-[#112649] hover:bg-[#1d3d75] text-white shadow-sm transition-all"
          title="Print or Save Official Brochure as PDF"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
          <span>Download Brochure (PDF)</span>
        </button>

        <a 
          href="/contact" 
          class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg text-xs sm:text-sm font-bold bg-[#16A34A] hover:bg-[#15803D] text-white shadow-sm transition-all"
        >
          <span>Book Consultation</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>
    </div>

    <!-- 1. Executive Summary & Company Identity Card -->
    <div class="bg-white rounded-2xl border border-slate-300 p-6 sm:p-10 shadow-sm mb-12">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 pb-8 border-b border-slate-200">
        <div class="flex items-center gap-4">
          <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-xl overflow-hidden bg-white p-1 border border-slate-300 shadow-sm shrink-0">
            <img 
              src="/images/rkmidigilabs-logo.jpg" 
              alt="RKMIDIGILABS Logo" 
              class="w-full h-full object-contain"
            />
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h2 class="text-2xl sm:text-3xl font-black text-black tracking-tight">
                RKMIDIGILABS
              </h2>
              <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">
                OFFICIAL PRACTICE
              </span>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 font-semibold mt-1">
              AI Governance (AIGP) • Enterprise GRC • Corporate Training Practice
            </p>
          </div>
        </div>

        <!-- Official Contact Details -->
        <div class="w-full md:w-auto bg-slate-50 border border-slate-200 rounded-xl p-4 text-xs font-mono space-y-1.5 shrink-0">
          <div class="flex items-center justify-between md:justify-start gap-3">
            <span class="text-slate-500 font-bold uppercase">Organization:</span>
            <span class="text-black font-extrabold">RKMIDIGILABS</span>
          </div>
          <div class="flex items-center justify-between md:justify-start gap-3">
            <span class="text-slate-500 font-bold uppercase">Direct Email:</span>
            <a href="mailto:rkmvedant@gmail.com" class="text-emerald-700 hover:underline font-bold">rkmvedant@gmail.com</a>
          </div>
          <div class="flex items-center justify-between md:justify-start gap-3">
            <span class="text-slate-500 font-bold uppercase">Direct Phone:</span>
            <a href="tel:+919371650121" class="text-emerald-700 hover:underline font-bold">+91 9371650121</a>
          </div>
          <div class="flex items-center justify-between md:justify-start gap-3">
            <span class="text-slate-500 font-bold uppercase">Advisory Scope:</span>
            <span class="text-black font-bold">Global / Enterprise Engagements</span>
          </div>
        </div>
      </div>

      <div class="pt-6">
        <h3 class="text-lg font-black text-black mb-3">Corporate Mission & Practice Vision</h3>
        <p class="text-slate-700 text-sm sm:text-base leading-relaxed">
          <strong>RKMIDIGILABS</strong> is an executive advisory practice established to resolve the critical tension between aggressive artificial intelligence deployment and stringent regulatory compliance. We provide deep technical audits, cross-functional risk frameworks, and high-impact training that empower modern organizations to safely scale LLMs, generative AI tools, and enterprise automation while satisfying global regulators, institutional investors, and enterprise enterprise boards.
        </p>
      </div>
    </div>

    <!-- 2. Verified Social Media & Official Broadcast Channels (No Print) -->
    <div id="social-channels" class="no-print mb-14">
      <div class="mb-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-slate-100 border border-slate-300 text-xs font-mono font-bold uppercase text-slate-700">
          Connected Official Accounts
        </div>
        <h2 class="text-2xl sm:text-3xl font-black text-black tracking-tight mt-1">
          Official Social Media & Media Dispatches
        </h2>
        <p class="text-xs sm:text-sm text-slate-600">
          Connect directly with RKMIDIGILABS on official channels for daily framework breakdowns, executive video briefings, and regulatory alerts.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        
        <!-- LinkedIn -->
        <div id="linkedin" class="p-5 rounded-xl bg-white border border-slate-200 shadow-sm hover:border-blue-400 transition-all flex flex-col justify-between">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-lg bg-[#0077B5] text-white flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.67a1.66 1.66 0 1 0 1.66 1.66 1.67 1.67 0 0 0-1.66-1.66z"/></svg>
            </div>
            <div>
              <h3 class="font-extrabold text-black text-sm">LinkedIn Official</h3>
              <span class="text-xs text-slate-500 font-mono">@RKMIDIGILABS</span>
            </div>
          </div>
          <p class="text-xs text-slate-600 mb-4 leading-normal">
            Executive articles, regulatory commentary, AIGP insights, and enterprise GRC advisory updates.
          </p>
          <a 
            href="https://www.linkedin.com/company/rkmidigilabs" 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full text-center py-2 px-3 rounded-lg text-xs font-bold bg-[#0077B5] hover:bg-[#005f93] text-white transition-colors flex items-center justify-center gap-1.5"
          >
            <span>Connect on LinkedIn</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>

        <!-- X (Twitter) -->
        <div id="twitter" class="p-5 rounded-xl bg-white border border-slate-200 shadow-sm hover:border-black transition-all flex flex-col justify-between">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-lg bg-black text-white flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </div>
            <div>
              <h3 class="font-extrabold text-black text-sm">X (Twitter) Official</h3>
              <span class="text-xs text-slate-500 font-mono">@rkmidigilabs</span>
            </div>
          </div>
          <p class="text-xs text-slate-600 mb-4 leading-normal">
            Real-time compliance alerts, EU AI Act enforcement tracking, and rapid industry commentary.
          </p>
          <a 
            href="https://x.com/rkmidigilabs" 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full text-center py-2 px-3 rounded-lg text-xs font-bold bg-black hover:bg-slate-800 text-white transition-colors flex items-center justify-center gap-1.5"
          >
            <span>Follow @rkmidigilabs</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>

        <!-- YouTube -->
        <div id="youtube" class="p-5 rounded-xl bg-white border border-slate-200 shadow-sm hover:border-red-500 transition-all flex flex-col justify-between">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-lg bg-red-600 text-white flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </div>
            <div>
              <h3 class="font-extrabold text-black text-sm">YouTube Channel</h3>
              <span class="text-xs text-slate-500 font-mono">@rkmidigilabs</span>
            </div>
          </div>
          <p class="text-xs text-slate-600 mb-4 leading-normal">
            Daily video breakdowns, framework walk-throughs, and technical conformity architecture.
          </p>
          <a 
            href="https://www.youtube.com/@rkmidigilabs" 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full text-center py-2 px-3 rounded-lg text-xs font-bold bg-red-600 hover:bg-red-700 text-white transition-colors flex items-center justify-center gap-1.5"
          >
            <span>Watch Video Dispatches</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>

        <!-- WhatsApp Business Hotline -->
        <div id="whatsapp" class="p-5 rounded-xl bg-white border border-slate-200 shadow-sm hover:border-emerald-500 transition-all flex flex-col justify-between">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-lg bg-[#25D366] text-white flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
            </div>
            <div>
              <h3 class="font-extrabold text-black text-sm">WhatsApp Business</h3>
              <span class="text-xs text-slate-500 font-mono">+91 9371650121</span>
            </div>
          </div>
          <p class="text-xs text-slate-600 mb-4 leading-normal">
            Direct priority hotline for corporate advisory, workshop scheduling, and confidential inquiries.
          </p>
          <a 
            href="https://wa.me/919371650121?text=Hello%20RKMIDIGILABS%2C%20I%20am%20interested%20in%20your%20AI%20Governance%20and%20GRC%20Advisory%20Services." 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full text-center py-2 px-3 rounded-lg text-xs font-bold bg-[#25D366] hover:bg-[#1ebc59] text-white transition-colors flex items-center justify-center gap-1.5"
          >
            <span>Message on WhatsApp</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>

        <!-- Facebook -->
        <div id="facebook" class="p-5 rounded-xl bg-white border border-slate-200 shadow-sm hover:border-blue-600 transition-all flex flex-col justify-between">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-lg bg-[#1877F2] text-white flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </div>
            <div>
              <h3 class="font-extrabold text-black text-sm">Facebook Page</h3>
              <span class="text-xs text-slate-500 font-mono">/rkmidigilabs</span>
            </div>
          </div>
          <p class="text-xs text-slate-600 mb-4 leading-normal">
            Corporate news, community webinars, enterprise training sessions, and announcements.
          </p>
          <a 
            href="https://www.facebook.com/rkmidigilabs" 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full text-center py-2 px-3 rounded-lg text-xs font-bold bg-[#1877F2] hover:bg-[#0c65d8] text-white transition-colors flex items-center justify-center gap-1.5"
          >
            <span>Visit Facebook Page</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>

        <!-- Direct Email Dispatch -->
        <div class="p-5 rounded-xl bg-white border border-slate-200 shadow-sm hover:border-[#112649] transition-all flex flex-col justify-between">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-lg bg-[#112649] text-white flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 fill-none stroke-current" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <div>
              <h3 class="font-extrabold text-black text-sm">Direct Advisory Email</h3>
              <span class="text-xs text-slate-500 font-mono">rkmvedant@gmail.com</span>
            </div>
          </div>
          <p class="text-xs text-slate-600 mb-4 leading-normal">
            Request formal proposals, customized NDAs, enterprise Master Service Agreements, or RFP responses.
          </p>
          <a 
            href="mailto:rkmvedant@gmail.com?subject=Strategic%20Advisory%20Inquiry%20-%20RKMIDIGILABS" 
            class="w-full text-center py-2 px-3 rounded-lg text-xs font-bold bg-[#112649] hover:bg-[#1d3d75] text-white transition-colors flex items-center justify-center gap-1.5"
          >
            <span>Send Direct Email</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>

      </div>
    </div>

    <!-- 3. OFFICIAL CORPORATE CAPABILITY BROCHURE (Printable Document Area) -->
    <div class="brochure-container bg-white border-2 border-slate-300 rounded-2xl p-6 sm:p-12 shadow-md">
      
      <!-- Brochure Header Banner -->
      <div class="border-b-2 border-black pb-6 mb-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <span class="text-xs font-mono font-bold tracking-widest uppercase text-emerald-800 bg-emerald-100 px-2.5 py-1 rounded">
            Official Capability Brochure • 2026 Edition
          </span>
          <h2 class="text-2xl sm:text-4xl font-black text-black tracking-tight mt-2">
            RKMIDIGILABS Corporate Capability Brochure
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 font-medium mt-1">
            Enterprise AI Governance • Regulatory Auditing • Risk Assurance Architecture
          </p>
        </div>
        <div class="text-left sm:text-right text-xs font-mono text-slate-600">
          <div>Doc Ref: <strong class="text-black">RKM-CAP-2026-V1</strong></div>
          <div>Authorized By: <strong class="text-black">RKMIDIGILABS Practice Lead</strong></div>
          <div>Contact: <strong class="text-black">+91 9371650121</strong></div>
        </div>
      </div>

      <!-- Core Practice Pillars -->
      <div class="mb-10">
        <h3 class="text-lg sm:text-xl font-black text-black border-l-4 border-[#112649] pl-3 mb-4">
          Core Advisory & Technical Capabilities
        </h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          
          <!-- Pillar 1 -->
          <div class="p-5 rounded-xl bg-slate-50 border border-slate-200">
            <span class="text-xs font-mono font-bold text-emerald-700 uppercase">Pillar 1: AI Governance</span>
            <h4 class="text-base font-black text-black mt-1 mb-2">AIGP & Global AI Regulation</h4>
            <p class="text-xs text-slate-700 leading-relaxed mb-3">
              Full lifecycle guidance to align machine learning architectures with binding international mandates:
            </p>
            <ul class="space-y-1.5 text-xs text-slate-800 list-disc list-inside">
              <li><strong>EU AI Act:</strong> High-Risk classification, Article 50 watermarking, Annex III conformity.</li>
              <li><strong>FRIA:</strong> Fundamental Rights Impact Assessments for deployed models.</li>
              <li><strong>NIST AI RMF 1.0:</strong> Blueprint implementation across Govern, Map, Measure, Manage.</li>
              <li><strong>ISO/IEC 42001:</strong> Artificial Intelligence Management System (AIMS) setup.</li>
            </ul>
          </div>

          <!-- Pillar 2 -->
          <div class="p-5 rounded-xl bg-slate-50 border border-slate-200">
            <span class="text-xs font-mono font-bold text-blue-700 uppercase">Pillar 2: Enterprise GRC</span>
            <h4 class="text-base font-black text-black mt-1 mb-2">Audit Assurance & Risk Programs</h4>
            <p class="text-xs text-slate-700 leading-relaxed mb-3">
              Transforming compliance from a checklist burden into a defensible competitive asset:
            </p>
            <ul class="space-y-1.5 text-xs text-slate-800 list-disc list-inside">
              <li><strong>ISO 27001:2022 & SOC 2:</strong> Readiness audits, remediation, evidence pipelines.</li>
              <li><strong>Third-Party AI Risk (TPRM):</strong> Vendor evaluation questionnaires & model vetting.</li>
              <li><strong>Risk Registers:</strong> Quantitative risk scoring, KRI tracking, board reporting.</li>
              <li><strong>Internal AI Guardrails:</strong> Shadow AI policies and acceptable use guidelines.</li>
            </ul>
          </div>

          <!-- Pillar 3 -->
