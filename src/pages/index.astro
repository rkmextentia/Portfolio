---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import PostCard from '../components/PostCard.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).filter(p => p.data.published !== false);
const sortedPosts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const featuredPost = sortedPosts.find(p => p.data.featured) || sortedPosts[0];
const recentPosts = sortedPosts.filter(p => p.id !== featuredPost?.id).slice(0, 3);
---

<BaseLayout 
  title="RKMIDIGILABS — Enterprise AI Governance & GRC Practice"
  description="Executive AI Governance, Enterprise GRC Advisory, and Corporate Training by RKMIDIGILABS. Translating the EU AI Act, NIST AI RMF, and ISO 42001 into audit-ready systems."
>
  <!-- Hero Section with black fonts, grey highlights, green buttons -->
  <Hero />

  <!-- Featured "Dispatch of the Day" Section -->
  {featuredPost && (
    <section id="home-featured-section" data-slug={featuredPost.slug} class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
      <div class="p-6 sm:p-10 rounded-2xl bg-white border border-slate-300 shadow-md relative">
        
        <!-- Header -->
        <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
          <div>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded text-xs font-bold uppercase tracking-wider bg-slate-100 text-slate-800 border border-slate-300 mb-2">
              <span class="w-2 h-2 rounded-full bg-[#16A34A]"></span>
              Featured Blog Article
            </span>
            <h2 class="text-2xl sm:text-3xl font-black text-black tracking-tight">
              {featuredPost.data.title}
            </h2>
          </div>
          <a 
            href={`/blog/${featuredPost.slug}`}
            class="inline-flex items-center gap-2 text-sm font-bold text-[#16A34A] hover:text-[#15803D]"
          >
            Read Full Article →
          </a>
        </div>

        <!-- Video Player & Executive Summary Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          
          <div class="lg:col-span-7">
            {featuredPost.data.youtubeUrl ? (
              <YouTubeEmbed 
                url={featuredPost.data.youtubeUrl} 
                title={featuredPost.data.title}
              />
            ) : null}
          </div>

          <div class="lg:col-span-5 flex flex-col justify-between space-y-6">
            <div>
              <h3 class="text-xs font-mono uppercase tracking-wider text-slate-500 mb-2 font-bold">Executive Summary:</h3>
              <p class="text-slate-700 text-sm sm:text-base leading-relaxed font-normal">
                {featuredPost.data.summary}
              </p>
            </div>

            <div class="space-y-3 pt-4 border-t border-slate-200">
              <div class="flex items-center gap-2 text-xs font-mono text-slate-600">
                <span class="font-bold text-black">Category:</span>
                <span>{featuredPost.data.category}</span>
                <span>•</span>
                <span>{featuredPost.data.readTime}</span>
              </div>
              <div class="flex flex-wrap gap-1.5">
                {featuredPost.data.tags.map(tag => (
                  <span class="text-xs bg-slate-100 text-slate-700 px-2.5 py-1 rounded border border-slate-300">
                    #{tag}
                  </span>
                ))}
              </div>
            </div>

            <!-- Green Action Button -->
            <div class="pt-2">
              <a 
                href={`/blog/${featuredPost.slug}`}
                class="w-full text-center block py-3.5 px-4 rounded-lg font-bold text-sm bg-[#16A34A] hover:bg-[#15803D] text-white transition-colors shadow-sm"
              >
                Read Article & Review Framework Notes
              </a>
            </div>

          </div>

        </div>

      </div>
    </section>
  )}

  <!-- Core Services & Corporate Training Preview -->
  <section class="bg-slate-50 border-y border-slate-200 py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-mono font-bold tracking-widest uppercase bg-slate-200 text-slate-800 px-3 py-1 rounded-full">
          RKMIDIGILABS Services
        </span>
        <h2 class="text-3xl font-black text-black tracking-tight mt-3">
          Consulting & Corporate Training
        </h2>
        <p class="mt-3 text-sm text-slate-700 font-normal">
          Bridging high-level regulatory mandates into concrete engineering, data governance, and enterprise risk controls.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <ServiceCard 
          title="AI Governance Consultancy"
          badge="Regulatory Advisory"
          audience="For Product & Legal Teams"
          description="Comprehensive readiness assessments, model classifications, and governance framework design."
          deliverables={[
            "EU AI Act High-Risk (Annex III) Classification",
            "Fundamental Rights Impact Assessments (FRIA)",
            "NIST AI RMF 1.0 & ISO 42001 (AIMS) Alignment",
            "Shadow AI & Generative AI Corporate Policies"
          ]}
          inquirySubject="Consulting Inquiry to RKMIDIGILABS: AI Governance & EU AI Act"
          highlight={true}
        />

        <ServiceCard 
          title="Enterprise GRC Advisory"
          badge="Risk & Audit Assurance"
          audience="For CISOs & Risk Leaders"
          description="Building scalable risk management architectures and preparing systems for rigorous compliance audits."
          deliverables={[
            "ISO 27001 & SOC 2 Type II Audit Readiness",
            "Third-Party AI & Vendor Risk Management (TPRM)",
            "Enterprise Risk Registers & Impact Scoring",
            "Continuous Compliance & Evidence Automation"
          ]}
          inquirySubject="Consulting Inquiry to RKMIDIGILABS: Enterprise GRC & Audit Readiness"
        />

        <ServiceCard 
          title="Corporate Training & Workshops"
          badge="Team Upskilling"
          audience="For C-Suite, Engineers & Risk Teams"
          description="Interactive, real-world workshops educating your workforce on AI risk, compliance habits, and safety."
          deliverables={[
            "Executive & Board Briefings on Global AI Laws",
            "Hands-On AI Risk & Red-Teaming for Engineers",
            "GRC Fundamentals for Emerging Leaders",
            "Custom Internal Policy Training Sessions"
          ]}
          inquirySubject="Corporate Training Inquiry to RKMIDIGILABS: AI Governance Masterclass"
        />

      </div>

      <div class="text-center mt-10">
        <a href="/services" class="inline-flex items-center gap-2 text-sm font-bold text-[#16A34A] hover:text-[#15803D]">
          View Full Services & SOC Roadmap →
        </a>
      </div>
    </div>
  </section>

  <!-- Recent Blog Articles & Video Episodes -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-10">
      <div>
        <span class="text-xs font-mono font-bold tracking-widest uppercase text-slate-500">RKMIDIGILABS Media Hub</span>
        <h2 class="text-3xl font-black text-black tracking-tight mt-2">
          Recent Blog Articles & Video Episodes
        </h2>
        <p class="text-sm text-slate-700 mt-1 font-normal">Daily analysis of emerging AI regulations and risk management frameworks.</p>
      </div>
      <a href="/blog" class="text-sm font-bold text-[#16A34A] hover:text-[#15803D] flex items-center gap-1">
        Browse Full Blog Archive
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8" id="home-recent-grid">
      {recentPosts.map(post => (
        <div class="home-recent-wrapper transition-all duration-200" data-slug={post.slug}>
          <PostCard 
            slug={post.slug}
            title={post.data.title}
            date={post.data.date}
            summary={post.data.summary}
            category={post.data.category}
            tags={post.data.tags}
            youtubeUrl={post.data.youtubeUrl}
            readTime={post.data.readTime}
          />
        </div>
      ))}
    </div>
  </section>

  <script is:inline>
    (function() {
      var API_BASE = 'http://localhost:4322';

      async function syncHomePosts() {
        try {
          var res = await fetch(`${API_BASE}/api/public/posts?_t=${Date.now()}`);
          if (!res.ok) return;
          var data = await res.json();
          if (!data.success || !Array.isArray(data.posts)) return;

          var postsMap = {};
          data.posts.forEach(function(p) {
            postsMap[p.slug] = p;
          });

          // 1. Featured Section check
          var featuredSection = document.getElementById('home-featured-section');
          if (featuredSection) {
            var featSlug = featuredSection.getAttribute('data-slug');
            if (featSlug && postsMap[featSlug]) {
              if (postsMap[featSlug].published === false) {
                featuredSection.style.display = 'none';
              } else {
                featuredSection.style.display = '';
              }
            }
          }

          // 2. Recent Cards check
          var recentCards = document.querySelectorAll('.home-recent-wrapper');
          recentCards.forEach(function(card) {
            var slug = card.getAttribute('data-slug');
            if (slug && postsMap[slug]) {
              if (postsMap[slug].published === false) {
                card.style.display = 'none';
                card.classList.add('hidden');
              } else {
                card.style.display = '';
                card.classList.remove('hidden');
              }
            }
          });
        } catch(e) {}
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', syncHomePosts);
      } else {
        syncHomePosts();
      }

      try {
        var bc = new BroadcastChannel('rkmidigi_blog_channel');
        bc.onmessage = function() { syncHomePosts(); };
      } catch(e) {}

      window.addEventListener('storage', function(e) {
        if (e.key === 'rkmidigi_post_toggle' || e.key === 'rkmidigi_post_update') {
          syncHomePosts();
        }
      });
      window.addEventListener('focus', syncHomePosts);
    })();
  </script>

  <!-- Direct Inquiries & Contact Banner -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mb-8">
    <div class="p-8 sm:p-12 rounded-2xl bg-[#112649] text-white text-center shadow-lg">
      <div class="max-w-2xl mx-auto space-y-4">
        <span class="text-xs font-mono font-bold uppercase tracking-widest text-emerald-400">Direct Inquiries</span>
        <h2 class="text-3xl font-black tracking-tight">
          Ready to Connect with RKMIDIGILABS?
        </h2>
        <p class="text-sm text-slate-200 leading-relaxed font-normal">
          Whether you need an EU AI Act assessment, SOC 2 guidance, or a corporate training workshop—reach out directly via email or phone.
        </p>
        <div class="text-xs font-mono text-emerald-300 py-2">
          📞 Mobile: +91 9371650121 • ✉️ Email: rkmvedant@gmail.com
        </div>
        <div class="pt-3 flex flex-wrap items-center justify-center gap-4">
          <a 
            href="/contact" 
            class="px-6 py-3.5 rounded-lg font-bold text-sm bg-[#16A34A] hover:bg-[#15803D] text-white shadow-sm transition-colors"
          >
            Contact RKMIDIGILABS
          </a>
          <a 
            href="mailto:rkmvedant@gmail.com" 
            class="px-6 py-3.5 rounded-lg font-bold text-sm bg-[#0b1a33] hover:bg-slate-800 text-white border border-slate-600 transition-colors"
          >
            Email: rkmvedant@gmail.com
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>