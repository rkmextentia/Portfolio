---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const initialPublished = sortedPosts.filter(p => p.data.published !== false);

const totalCount = initialPublished.length;
const videoCount = initialPublished.filter(p => !!p.data.youtubeUrl).length;
const aiGovCount = initialPublished.filter(p => p.data.category === 'AI Governance').length;
const grcCount = initialPublished.filter(p => p.data.category === 'Enterprise GRC').length;
const trainingCount = initialPublished.filter(p => p.data.category === 'Corporate Training').length;
const alertsCount = initialPublished.filter(p => p.data.category === 'Regulatory Alerts').length;

const filterTabs = [
  { id: 'All', label: 'All Articles', count: totalCount },
  { id: 'Videos Only', label: 'Videos Only', count: videoCount, isVideo: true },
  { id: 'AI Governance', label: 'AI Governance', count: aiGovCount },
  { id: 'Enterprise GRC', label: 'Enterprise GRC', count: grcCount },
  ...(trainingCount > 0 ? [{ id: 'Corporate Training', label: 'Corporate Training', count: trainingCount }] : []),
  ...(alertsCount > 0 ? [{ id: 'Regulatory Alerts', label: 'Regulatory Alerts', count: alertsCount }] : []),
];
---

<BaseLayout 
  title="Blog & Video Analysis"
  description="Official RKMIDIGILABS Blog — Daily articles, regulatory updates, and YouTube video breakdowns on AI Governance, EU AI Act, NIST AI RMF, and Enterprise GRC."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
    
    <!-- Page Header -->
    <div class="max-w-3xl mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-bold uppercase tracking-wider bg-slate-100 text-slate-800 border border-slate-300 mb-3">
        <span class="w-2 h-2 rounded-full bg-[#16A34A]"></span>
        RKMIDIGILABS Knowledge Hub
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-black tracking-tight leading-tight">
        RKMIDIGILABS Blog & Articles
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-700 leading-relaxed font-normal">
        Daily articles, framework breakdowns, and YouTube video analyses on Artificial Intelligence Governance, EU AI Act enforcement, NIST AI RMF, and enterprise compliance.
      </p>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="mb-10 pb-6 border-b border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-4">
      
      <!-- Category Filter Buttons -->
      <div class="flex flex-wrap items-center gap-2" id="filter-tabs-container">
        {filterTabs.map((tab, idx) => (
          <button 
            type="button" 
            class={`filter-btn px-3.5 py-2 rounded-lg text-xs sm:text-sm font-bold transition-all flex items-center gap-2 border ${
              idx === 0 
                ? 'active-filter bg-[#112649] text-white border-[#112649] shadow-sm' 
                : 'bg-white text-slate-700 hover:bg-slate-100 border-slate-300'
            }`}
            data-category={tab.id}
          >
            {tab.isVideo && (
              <svg class="w-3.5 h-3.5 text-red-500 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            )}
            <span>{tab.label}</span>
            <span class={`tab-badge text-[11px] px-1.5 py-0.2 rounded-full font-mono font-bold ${
              idx === 0 ? 'bg-slate-700 text-white' : 'bg-slate-100 text-slate-600'
            }`}>
              {tab.count}
            </span>
          </button>
        ))}
      </div>

      <!-- Quick Search Bar -->
      <div class="relative w-full md:w-72 shrink-0">
        <input 
          type="text" 
          id="blog-search" 
          placeholder="Search by topic, framework, tag..." 
          class="w-full pl-9 pr-4 py-2 rounded-lg border border-slate-300 text-xs text-slate-800 bg-white focus:outline-none focus:ring-2 focus:ring-[#16A34A] focus:border-transparent placeholder-slate-400 font-medium shadow-sm"
        />
        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </div>

    </div>

    <!-- Active Filter Status Indicator -->
    <div id="filter-status-bar" class="mb-6 flex items-center justify-between text-xs text-slate-500 font-mono">
      <span>Showing <strong id="visible-post-count" class="text-black font-bold">{totalCount}</strong> of <span id="total-published-count" class="font-bold text-slate-800">{totalCount}</span> published dispatches</span>
      <button type="button" id="reset-filter-btn" class="hidden text-[#16A34A] font-bold hover:underline">Reset Filters</button>
    </div>

    <!-- Posts Grid -->
    <div id="posts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sortedPosts.map(post => {
        const isPub = post.data.published !== false;
        return (
          <div 
            class={`post-wrapper transition-all duration-200 ${!isPub ? 'hidden' : ''}`}
            data-slug={post.slug}
            data-category={post.data.category} 
            data-has-video={post.data.youtubeUrl ? "true" : "false"}
            data-title={post.data.title.toLowerCase()}
            data-summary={post.data.summary.toLowerCase()}
            data-tags={post.data.tags.join(' ').toLowerCase()}
            data-published={isPub ? "true" : "false"}
            style={!isPub ? "display: none;" : ""}
          >
            <PostCard 
              slug={post.slug}
              title={post.data.title}
              date={post.data.date}
              summary={post.data.summary}
              category={post.data.category}
              tags={post.data.tags}
              youtubeUrl={post.data.youtubeUrl}
              image={post.data.image}
              readTime={post.data.readTime}
            />
          </div>
        );
      })}
    </div>

    <!-- Empty State -->
    <div id="empty-state" class="hidden text-center py-16 bg-slate-50 border border-slate-200 rounded-2xl my-8 p-8">
      <div class="w-12 h-12 rounded-full bg-slate-200 flex items-center justify-center mx-auto mb-3 text-slate-500">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
      <h3 class="text-base font-bold text-black mb-1">No Articles Found</h3>
      <p class="text-slate-600 text-xs max-w-sm mx-auto mb-4">No published dispatches match your selected filter or search query.</p>
      <button 
        type="button" 
        id="empty-reset-btn" 
        class="px-4 py-2 rounded-lg bg-[#112649] text-white text-xs font-bold hover:bg-[#1a3666] shadow-sm transition-colors"
      >
        View All Articles
      </button>
    </div>

  </div>

  <script>
    import { supabase } from '../../lib/supabase';

    function initBlogLiveSync() {
      const buttons = document.querySelectorAll('.filter-btn');
      const searchInput = document.getElementById('blog-search') as HTMLInputElement | null;
      const emptyState = document.getElementById('empty-state');
      const visibleCountEl = document.getElementById('visible-post-count');
      const totalPublishedCountEl = document.getElementById('total-published-count');
      const resetBtn = document.getElementById('reset-filter-btn');
      const emptyResetBtn = document.getElementById('empty-reset-btn');
      const postsGrid = document.getElementById('posts-grid');

      let currentCategory = 'All';

      function updateBadgeCounts() {
        const allWrappers = document.querySelectorAll('.post-wrapper');
        const publishedWrappers = Array.from(allWrappers).filter(w => w.getAttribute('data-published') === 'true');

        const totalPub = publishedWrappers.length;
        const videoPub = publishedWrappers.filter(w => w.getAttribute('data-has-video') === 'true').length;
        const aiGovPub = publishedWrappers.filter(w => w.getAttribute('data-category') === 'AI Governance').length;
        const grcPub = publishedWrappers.filter(w => w.getAttribute('data-category') === 'Enterprise GRC').length;
        const trainingPub = publishedWrappers.filter(w => w.getAttribute('data-category') === 'Corporate Training').length;
        const alertsPub = publishedWrappers.filter(w => w.getAttribute('data-category') === 'Regulatory Alerts').length;

        buttons.forEach(btn => {
          const cat = btn.getAttribute('data-category');
          const badge = btn.querySelector('.tab-badge') || btn.querySelector('span:last-child');
          if (!badge) return;
          if (cat === 'All') badge.textContent = totalPub.toString();
          else if (cat === 'Videos Only') badge.textContent = videoPub.toString();
          else if (cat === 'AI Governance') badge.textContent = aiGovPub.toString();
          else if (cat === 'Enterprise GRC') badge.textContent = grcPub.toString();
          else if (cat === 'Corporate Training') badge.textContent = trainingPub.toString();
          else if (cat === 'Regulatory Alerts') badge.textContent = alertsPub.toString();
        });

        if (totalPublishedCountEl) {
          totalPublishedCountEl.textContent = totalPub.toString();
        }
      }

      function applyFilter() {
        const allWrappers = document.querySelectorAll('.post-wrapper');
        const query = searchInput ? searchInput.value.trim().toLowerCase() : '';
        let visibleCount = 0;

        allWrappers.forEach(w => {
          const isPublished = w.getAttribute('data-published') === 'true';
          if (!isPublished) {
            w.classList.add('hidden');
            (w as HTMLElement).style.display = 'none';
            return;
          }

          const itemCat = w.getAttribute('data-category') || '';
          const hasVideo = w.getAttribute('data-has-video') === 'true';
          const title = w.getAttribute('data-title') || '';
          const summary = w.getAttribute('data-summary') || '';
          const tags = w.getAttribute('data-tags') || '';

          let categoryMatch = false;
          if (currentCategory === 'All') {
            categoryMatch = true;
          } else if (currentCategory === 'Videos Only') {
            categoryMatch = hasVideo;
          } else {
            categoryMatch = (itemCat === currentCategory);
          }

          const searchMatch = !query || 
            title.indexOf(query) !== -1 || 
            summary.indexOf(query) !== -1 || 
            tags.indexOf(query) !== -1;

          if (categoryMatch && searchMatch) {
            w.classList.remove('hidden');
            (w as HTMLElement).style.display = '';
            visibleCount++;
          } else {
            w.classList.add('hidden');
            (w as HTMLElement).style.display = 'none';
          }
        });

        if (visibleCountEl) visibleCountEl.textContent = visibleCount.toString();

        if (emptyState) {
          if (visibleCount === 0) emptyState.classList.remove('hidden');
          else emptyState.classList.add('hidden');
        }

        if (resetBtn) {
          if (currentCategory !== 'All' || query.length > 0) resetBtn.classList.remove('hidden');
          else resetBtn.classList.add('hidden');
        }
      }

      // Real-time synchronization with Supabase, LocalStorage, and Admin API
      async function syncLivePosts() {
        const livePostsMap: Record<string, any> = {};

        // 1. Load custom posts from localStorage (instant, client-side)
        try {
          const customPosts = JSON.parse(localStorage.getItem('rkmidigi_custom_posts') || '[]');
          if (Array.isArray(customPosts)) {
            customPosts.forEach((p: any) => {
              if (p.slug) livePostsMap[p.slug] = p;
            });
          }
        } catch(e) {}

        // 2. Load published posts from Supabase database (cloud sync)
        try {
          const sbPromise = supabase.from('posts').select('*');
          const timeoutPromise = new Promise(r => setTimeout(r, 2000));
          const res: any = await Promise.race([sbPromise, timeoutPromise]);
          if (res && Array.isArray(res.data)) {
            res.data.forEach((sp: any) => {
              livePostsMap[sp.slug] = {
                slug: sp.slug,
                title: sp.title,
                category: sp.category,
                date: sp.date,
                readTime: sp.read_time,
                featured: sp.featured,
                published: sp.published,
                youtubeUrl: sp.youtube_url,
                image: sp.image,
                summary: sp.summary,
                tags: Array.isArray(sp.tags) ? sp.tags : [],
                body: sp.body,
                author: sp.author || 'RKMIDIGILABS'
              };
            });
          }
        } catch(e) {}

        // 3. If local development server is active, also sync from disk
        const isLocal = ['localhost', '127.0.0.1'].includes(window.location.hostname);
        if (isLocal) {
          try {
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 1000);
            const res = await fetch(`http://localhost:4322/api/public/posts?_t=${Date.now()}`, { signal: controller.signal });
            clearTimeout(timeoutId);
            if (res.ok) {
              const data = await res.json();
              if (data.success && Array.isArray(data.posts)) {
                data.posts.forEach((p: any) => {
                  livePostsMap[p.slug] = p;
                });
              }
            }
          } catch(e) {}
        }

        // 4. Deleted slugs check
        let deletedSlugs: string[] = [];
        try {
          deletedSlugs = JSON.parse(localStorage.getItem('rkmidigi_deleted_posts') || '[]');
        } catch(e) {}

        // 5. Publish / Draft toggle overrides
        let toggles: Record<string, boolean> = {};
        try {
          toggles = JSON.parse(localStorage.getItem('rkmidigi_post_toggles') || '{}');
        } catch(e) {}

        const allWrappers = document.querySelectorAll('.post-wrapper');
        const existingSlugs = new Set<string>();

        allWrappers.forEach(w => {
          const slug = w.getAttribute('data-slug');
          if (!slug) return;
          existingSlugs.add(slug);

          if (deletedSlugs.includes(slug)) {
            w.remove();
            return;
          }

          let isPub = true;
          if (typeof toggles[slug] === 'boolean') {
            isPub = toggles[slug];
          } else if (livePostsMap[slug] && typeof livePostsMap[slug].published === 'boolean') {
            isPub = livePostsMap[slug].published !== false;
          }

          w.setAttribute('data-published', isPub ? 'true' : 'false');
          if (!isPub) {
            w.classList.add('hidden');
            (w as HTMLElement).style.display = 'none';
          }
        });

        // 6. Dynamically inject any custom / Supabase posts not present in initial HTML
        Object.values(livePostsMap).forEach((p: any) => {
          if (!p.slug || existingSlugs.has(p.slug) || deletedSlugs.includes(p.slug)) return;

          let isPub = p.published !== false;
          if (typeof toggles[p.slug] === 'boolean') {
            isPub = toggles[p.slug];
          }
          if (!isPub) return;

          if (postsGrid) {
            existingSlugs.add(p.slug);
            const cardDiv = document.createElement('div');
            cardDiv.className = 'post-wrapper transition-all duration-200';
            cardDiv.setAttribute('data-slug', p.slug);
            cardDiv.setAttribute('data-category', p.category || 'AI Governance');
            cardDiv.setAttribute('data-has-video', p.youtubeUrl ? 'true' : 'false');
            cardDiv.setAttribute('data-title', (p.title || '').toLowerCase());
            cardDiv.setAttribute('data-summary', (p.summary || '').toLowerCase());
            cardDiv.setAttribute('data-tags', (Array.isArray(p.tags) ? p.tags.join(' ') : '').toLowerCase());
            cardDiv.setAttribute('data-published', 'true');

            const dateStr = p.date ? new Date(p.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
            const tagsHtml = (Array.isArray(p.tags) ? p.tags : []).slice(0, 2).map((t: string) => 
              `<span class="text-[11px] text-slate-600 bg-slate-100 px-2 py-0.5 rounded border border-slate-200">#${t}</span>`
            ).join('');

            cardDiv.innerHTML = `
              <article class="flex flex-col bg-white border border-slate-200 rounded-xl overflow-hidden hover:border-slate-400 shadow-sm hover:shadow-md transition-all duration-200 group">
                <a href="/blog/${p.slug}" class="relative aspect-video overflow-hidden bg-slate-100 block">
                  ${p.image ? `<img src="${p.image}" alt="${p.title}" class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300" />` : `
                    <div class="w-full h-full flex items-center justify-center bg-slate-100 text-slate-400">
                      <svg class="w-12 h-12 stroke-current opacity-40" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
                    </div>
                  `}
                  <div class="absolute top-3 left-3">
                    <span class="px-2.5 py-1 rounded text-[11px] font-bold tracking-wide uppercase bg-slate-100 text-slate-800 shadow-sm border border-slate-300">
                      ${p.category || 'AI Governance'}
                    </span>
                  </div>
                  ${p.youtubeUrl ? `
                    <div class="absolute bottom-3 right-3 flex items-center gap-1.5 px-2 py-0.5 rounded bg-red-600 text-white text-[11px] font-bold shadow-sm">
                      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                      <span>VIDEO</span>
                    </div>
                  ` : ''}
                </a>
                <div class="flex-1 p-5 sm:p-6 flex flex-col justify-between">
                  <div>
                    <div class="flex items-center gap-2 text-xs text-slate-500 font-mono mb-2">
                      <time>${dateStr}</time>
                      <span>•</span>
                      <span>${p.readTime || '4 min read'}</span>
                    </div>
                    <h3 class="text-base sm:text-lg font-black text-black group-hover:text-[#16A34A] transition-colors leading-snug line-clamp-2">
                      <a href="/blog/${p.slug}">${p.title}</a>
                    </h3>
                    <p class="mt-2 text-sm text-slate-700 line-clamp-2 leading-relaxed font-normal">${p.summary || ''}</p>
                  </div>
                  <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between">
                    <div class="flex flex-wrap gap-1.5">${tagsHtml}</div>
                    <a href="/blog/${p.slug}" class="text-xs font-bold text-[#16A34A] hover:text-[#15803D] flex items-center gap-1">
                      Read Article
                      <svg class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </a>
                  </div>
                </div>
              </article>
            `;
            postsGrid.prepend(cardDiv);
          }
        });

        updateBadgeCounts();
        applyFilter();
      }

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          buttons.forEach(b => {
            b.classList.remove('active-filter', 'bg-[#112649]', 'text-white', 'border-[#112649]', 'shadow-sm');
            b.classList.add('bg-white', 'text-slate-700', 'border-slate-300');
            const badge = b.querySelector('.tab-badge') || b.querySelector('span:last-child');
            if (badge) {
              badge.className = 'tab-badge text-[11px] px-1.5 py-0.2 rounded-full font-mono font-bold bg-slate-100 text-slate-600';
            }
          });

          btn.classList.add('active-filter', 'bg-[#112649]', 'text-white', 'border-[#112649]', 'shadow-sm');
          btn.classList.remove('bg-white', 'text-slate-700', 'border-slate-300');
          const activeBadge = btn.querySelector('.tab-badge') || btn.querySelector('span:last-child');
          if (activeBadge) {
            activeBadge.className = 'tab-badge text-[11px] px-1.5 py-0.2 rounded-full font-mono font-bold bg-slate-700 text-white';
          }

          currentCategory = btn.getAttribute('data-category') || 'All';
          applyFilter();
        });
      });

      if (searchInput) {
        searchInput.addEventListener('input', applyFilter);
      }

      function resetAll() {
        currentCategory = 'All';
        if (searchInput) searchInput.value = '';
        buttons.forEach((b, idx) => {
          if (idx === 0) {
            b.classList.add('active-filter', 'bg-[#112649]', 'text-white', 'border-[#112649]', 'shadow-sm');
            b.classList.remove('bg-white', 'text-slate-700', 'border-slate-300');
          } else {
            b.classList.remove('active-filter', 'bg-[#112649]', 'text-white', 'border-[#112649]', 'shadow-sm');
            b.classList.add('bg-white', 'text-slate-700', 'border-slate-300');
          }
        });
        applyFilter();
      }

      if (resetBtn) resetBtn.addEventListener('click', resetAll);
      if (emptyResetBtn) emptyResetBtn.addEventListener('click', resetAll);

      // Initial setup
      applyFilter();
      syncLivePosts();

      // 1. Instant tab-to-tab sync via BroadcastChannel
      try {
        const bc = new BroadcastChannel('rkmidigi_blog_channel');
        bc.onmessage = () => { syncLivePosts(); };
      } catch(e) {}

      // 2. Storage event listener for cross-tab updates
      window.addEventListener('storage', (e) => {
        if (e.key === 'rkmidigi_post_toggle' || e.key === 'rkmidigi_post_update' || e.key === 'rkmidigi_custom_posts') {
          syncLivePosts();
        }
      });

      // 3. Re-sync immediately on window focus / tab visibility
      window.addEventListener('focus', () => { syncLivePosts(); });
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') {
          syncLivePosts();
        }
      });

      // 4. Background polling every 3 seconds
      setInterval(syncLivePosts, 3000);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBlogLiveSync);
    } else {
      initBlogLiveSync();
    }
  </script>
</BaseLayout>