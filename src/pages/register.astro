---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Student Registration — RKMIDIGILABS Academy" 
  description="Create your student account to access AI Governance, ISO 42001, and GRC masterclasses."
>
  <div class="min-h-[calc(100vh-160px)] bg-slate-50 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full bg-white rounded-3xl p-8 sm:p-10 border border-slate-200 shadow-xl space-y-6">
      
      <!-- Brand & Header -->
      <div class="text-center space-y-2">
        <div class="w-12 h-12 rounded-xl overflow-hidden bg-white p-0.5 shadow-sm mx-auto border border-slate-300">
          <img src="/images/rkmidigilabs-logo.jpg" alt="RKMIDIGILABS Logo" class="w-full h-full object-contain" />
        </div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight">Create Student Account</h1>
        <p class="text-xs text-slate-500">Join RKMIDIGILABS Academy to access on-demand video masterclasses and compliance toolkits.</p>
      </div>

      <!-- Alert Box -->
      <div id="auth-alert" class="hidden p-3.5 rounded-xl text-xs font-bold"></div>

      <!-- Registration Form -->
      <form id="register-form" class="space-y-4 text-xs">
        <div>
          <label for="reg-name" class="block font-bold text-slate-700 mb-1">Full Name</label>
          <input 
            type="text" 
            id="reg-name" 
            required 
            placeholder="e.g. Rajesh Kumar" 
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-emerald-500 focus:border-transparent text-slate-900"
          />
        </div>

        <div>
          <label for="reg-email" class="block font-bold text-slate-700 mb-1">Email Address</label>
          <input 
            type="email" 
            id="reg-email" 
            required 
            placeholder="you@company.com" 
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-emerald-500 focus:border-transparent text-slate-900"
          />
        </div>

        <div>
          <label for="reg-phone" class="block font-bold text-slate-700 mb-1">Phone Number (Optional)</label>
          <input 
            type="tel" 
            id="reg-phone" 
            placeholder="+91 98765 43210" 
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-emerald-500 focus:border-transparent text-slate-900"
          />
        </div>

        <div>
          <label for="reg-password" class="block font-bold text-slate-700 mb-1">Password (min 6 characters)</label>
          <input 
            type="password" 
            id="reg-password" 
            required 
            minlength="6"
            placeholder="••••••••" 
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-emerald-500 focus:border-transparent text-slate-900"
          />
        </div>

        <button 
          type="submit" 
          id="submit-btn"
          class="w-full py-3 px-4 rounded-xl font-bold text-sm bg-[#16A34A] hover:bg-[#15803D] text-white transition-colors shadow-md flex items-center justify-center gap-2 cursor-pointer mt-2"
        >
          <span>Register Account</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </button>
      </form>

      <!-- Footer Link -->
      <div class="pt-4 border-t border-slate-100 text-center text-xs text-slate-500 space-y-2">
        <p>Already have an account? <a href="/login" class="font-bold text-emerald-700 hover:underline">Log in here</a></p>
        <p><a href="/courses" class="text-slate-400 hover:underline">← Return to Course Catalog</a></p>
      </div>

    </div>
  </div>

  <script>
    import { supabase } from '../lib/supabase';

    const form = document.getElementById('register-form') as HTMLFormElement;
    const alertEl = document.getElementById('auth-alert');
    const submitBtn = document.getElementById('submit-btn');

    function showAlert(msg: string, isError = true) {
      if (!alertEl) return;
      alertEl.textContent = msg;
      alertEl.className = `p-3.5 rounded-xl text-xs font-bold ${
        isError ? 'bg-red-50 text-red-800 border border-red-200' : 'bg-emerald-50 text-emerald-800 border border-emerald-200'
      }`;
      alertEl.classList.remove('hidden');
    }

    // Auto-redirect if already logged in
    supabase.auth.getUser().then(({ data: { user } }) => {
      if (user) window.location.href = '/dashboard';
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const nameInput = document.getElementById('reg-name') as HTMLInputElement;
      const emailInput = document.getElementById('reg-email') as HTMLInputElement;
      const phoneInput = document.getElementById('reg-phone') as HTMLInputElement;
      const passInput = document.getElementById('reg-password') as HTMLInputElement;

      const fullName = nameInput.value.trim();
      const email = emailInput.value.trim();
      const phone = phoneInput.value.trim();
      const password = passInput.value;

      if (!fullName || !email || !password) return;

      if (submitBtn) {
        submitBtn.setAttribute('disabled', 'true');
        submitBtn.innerHTML = '<span>Creating Account...</span>';
      }
      if (alertEl) alertEl.classList.add('hidden');

      try {
        const { data, error } = await supabase.auth.signUp({
          email,
          password,
          options: {
            data: {
              full_name: fullName,
              phone: phone
            }
          }
        });

        if (error) {
          showAlert(error.message, true);
        } else if (data.user) {
          showAlert('Account created successfully! Redirecting to Student Dashboard...', false);
          setTimeout(() => {
            window.location.href = '/dashboard';
          }, 1200);
        }
      } catch (err: any) {
        showAlert(err.message || 'Registration failed. Please check network connection.', true);
      } finally {
        if (submitBtn) {
          submitBtn.removeAttribute('disabled');
          submitBtn.innerHTML = '<span>Register Account</span><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>';
        }
      }
    });
  </script>
</BaseLayout>
