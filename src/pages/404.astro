---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="RKMIDIGILABS">
  
  <!-- Instant Pre-paint Script: Suppresses 404 screen immediately if path is /blog/* -->
  <script is:inline>
    (function() {
      if (typeof window !== 'undefined' && window.location.pathname.startsWith('/blog/')) {
        document.documentElement.classList.add('is-resolving-article');
        document.title = 'Loading Article... | RKMIDIGILABS';
      }
    })();
  </script>

  <style>
    /* Suppress 404 UI before browser paint when resolving an article */
    html.is-resolving-article #standard-404-container {
      display: none !important;
    }
    html.is-resolving-article #article-loading-skeleton {
      display: block !important;
    }
  </style>

  <!-- Article Loading Skeleton (Smoothly displayed when resolving any dynamic article route) -->
  <div id="article-loading-skeleton" class="hidden max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-16 animate-pulse">
    <!-- Breadcrumb Skeleton -->
    <div class="h-4 w-36 bg-slate-200 rounded mb-6"></div>
    
    <!-- Header Skeleton -->
    <div class="space-y-4 mb-8">
      <div class="flex items-center gap-3">
        <div class="h-6 w-28 bg-slate-200 rounded"></div>
        <div class="h-4 w-24 bg-slate-200 rounded"></div>
      </div>
      <div class="h-10 w-3/4 bg-slate-200 rounded"></div>
      <div class="h-4 w-full bg-slate-200 rounded"></div>
      <div class="h-4 w-2/3 bg-slate-200 rounded"></div>
    </div>

    <!-- Media Box Skeleton -->
    <div class="aspect-video w-full rounded-2xl bg-slate-200 mb-10 flex items-center justify-center">
      <svg class="w-12 h-12 text-slate-400 animate-spin" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
      </svg>
    </div>

    <!-- Body Paragraph Skeletons -->
    <div class="space-y-3">
      <div class="h-4 w-full bg-slate-200 rounded"></div>
      <div class="h-4 w-full bg-slate-200 rounded"></div>
      <div class="h-4 w-5/6 bg-slate-200 rounded"></div>
      <div class="h-4 w-4/6 bg-slate-200 rounded"></div>
    </div>
  </div>

  <!-- Dynamic Blog Post Container (Populated client-side if a published custom post is requested) -->
  <article id="dynamic-post-container" class="hidden max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-16">
    
    <!-- Breadcrumb -->
    <div class="mb-6">
      <a href="/blog" class="inline-flex items-center gap-1.5 text-xs font-mono font-bold text-[#16A34A] hover:underline">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        Back to Blog & Articles
      </a>
    </div>

    <!-- Metadata Header -->
    <header class="mb-8">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span id="dyn-category" class="px-2.5 py-1 rounded text-xs font-bold uppercase tracking-wide bg-slate-100 text-slate-800 border border-slate-300">
          AI Governance
        </span>
        <div class="flex items-center gap-2 text-xs font-mono text-slate-500">
          <span>•</span>
          <span id="dyn-date">--</span>
          <span>•</span>
          <span id="dyn-readtime">4 min read</span>
        </div>
      </div>

      <h1 id="dyn-title" class="text-2xl sm:text-4xl lg:text-5xl font-black text-black tracking-tight leading-tight">
        Article Title
      </h1>

      <p id="dyn-summary" class="mt-4 text-base sm:text-lg text-slate-700 leading-relaxed font-normal">
        Summary
      </p>
    </header>

    <!-- YouTube Video Player -->
    <div id="dyn-video-box" class="hidden mb-10">
      <div class="aspect-video w-full rounded-2xl overflow-hidden border border-slate-300 shadow-sm bg-black">
        <iframe id="dyn-video-iframe" class="w-full h-full" frameborder="0" allowfullscreen allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>
      </div>
    </div>

    <!-- Top Cover Image -->
    <div id="dyn-image-box" class="hidden mb-10 rounded-2xl overflow-hidden border border-slate-300 shadow-sm aspect-video max-h-[440px] bg-slate-100">
      <img id="dyn-image-img" src="" alt="" class="w-full h-full object-cover" />
    </div>

    <!-- Social Share Intent Buttons -->
    <div class="my-8 py-3.5 px-4 rounded-xl border border-slate-200 bg-slate-50 flex flex-wrap items-center justify-between gap-3 text-xs">
      <div class="flex items-center gap-2 font-bold text-slate-700 font-mono">
        <span>Share Analysis:</span>
      </div>
      <div class="flex items-center gap-2">
        <button type="button" id="dyn-share-linkedin" class="px-3 py-1.5 rounded-lg bg-[#0077B5] hover:bg-[#005f93] text-white font-bold text-xs cursor-pointer">LinkedIn</button>
        <button type="button" id="dyn-share-twitter" class="px-3 py-1.5 rounded-lg bg-black hover:bg-slate-800 text-white font-bold text-xs cursor-pointer">X (Twitter)</button>
        <button type="button" id="dyn-share-whatsapp" class="px-3 py-1.5 rounded-lg bg-[#25D366] hover:bg-[#1ebc59] text-white font-bold text-xs cursor-pointer">WhatsApp</button>
      </div>
    </div>

    <!-- Article Content -->
    <div id="dyn-body" class="prose prose-slate max-w-none text-slate-800 text-base leading-relaxed">
    </div>

    <!-- Tags -->
    <div id="dyn-tags-container" class="mt-8 pt-6 border-t border-slate-200 flex flex-wrap items-center gap-2">
    </div>

    <!-- Author & Corporate Profile CTA -->
    <div class="mt-12 p-6 rounded-2xl border border-slate-200 bg-white shadow-sm flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-slate-100 p-1 border border-slate-300 shrink-0">
          <img src="/images/rkmidigilabs-logo.jpg" alt="RKMIDIGILABS Logo" class="w-full h-full object-contain" />
        </div>
        <div>
          <h3 class="text-sm font-black text-black">Published by RKMIDIGILABS</h3>
          <p class="text-xs text-slate-500 font-mono">ISO 42001 & EU AI Act Enterprise Practice</p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <a href="/company-profile" class="px-4 py-2 rounded-lg text-xs font-bold bg-[#112649] text-white hover:bg-[#1a3666] shadow-xs">Corporate Profile ↗</a>
        <a href="/contact" class="px-4 py-2 rounded-lg text-xs font-bold bg-[#16A34A] text-white hover:bg-[#15803D] shadow-xs">Book Advisory Call</a>
      </div>
    </div>

  </article>

  <!-- Standard 404 View (Default when page is truly not found) -->
  <div id="standard-404-container" class="max-w-xl mx-auto px-4 py-24 text-center">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-slate-100 border border-slate-300 text-slate-800 font-black text-2xl mb-6">
      404
    </div>
    <h1 class="text-3xl font-black text-black tracking-tight mb-3">
      Page Not Found
    </h1>
    <p class="text-slate-600 text-sm mb-8">
      The blog article, service, or regulatory framework page you are looking for has moved or does not exist.
    </p>
    <a 
      href="/" 
      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg font-bold text-sm bg-[#16A34A] text-white hover:bg-[#15803D] transition-colors"
    >
      Return to Homepage →
    </a>
  </div>
</BaseLayout>

<script>
  import { supabase } from '../lib/supabase';

  function extractYouTubeId(url: string): string | null {
    if (!url) return null;
    let cleanUrl = url.trim();
    const iframeSrc = cleanUrl.match(/src=["']([^"']+)["']/i);
    if (iframeSrc && iframeSrc[1]) cleanUrl = iframeSrc[1];

    const patterns = [
      /(?:youtu\.be\/|youtube(?:-nocookie)?\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=|shorts\/|live\/))([a-zA-Z0-9_-]{11})/i,
      /[?&]v=([a-zA-Z0-9_-]{11})/i,
      /^([a-zA-Z0-9_-]{11})$/
    ];

    for (const pattern of patterns) {
      const match = cleanUrl.match(pattern);
      if (match && match[1]) return match[1];
    }
    return null;
  }

  function formatMarkdown(md: string) {
    if (!md) return '';
    let text = md;

    // Process images first before escaping: ![alt](url)
    text = text.replace(/!\[(.*?)\]\((.*?)\)/gim, '<figure class="my-8"><img src="$2" alt="$1" class="w-full max-h-[550px] object-contain rounded-xl border border-slate-300 shadow-sm bg-slate-50" /><figcaption class="text-xs text-slate-500 mt-2 text-center font-mono">$1</figcaption></figure>');

    // Process links: [text](url)
    text = text.replace(/\[(.*?)\]\((.*?)\)/gim, '<a href="$2" target="_blank" rel="noopener noreferrer" class="text-[#16A34A] hover:underline font-bold">$1</a>');

    // Headers
    text = text.replace(/^### (.*$)/gim, '<h3 class="text-xl font-black text-black mt-8 mb-3">$1</h3>');
    text = text.replace(/^## (.*$)/gim, '<h2 class="text-2xl font-black text-black mt-10 mb-4">$1</h2>');
    text = text.replace(/^# (.*$)/gim, '<h1 class="text-3xl font-black text-black mt-10 mb-4">$1</h1>');

    // Blockquotes
    text = text.replace(/^> (.*$)/gim, '<blockquote class="border-l-4 border-[#16A34A] pl-4 py-1.5 my-4 italic text-slate-700 bg-slate-50 rounded-r-lg">$1</blockquote>');

    // Bold & Italics
    text = text.replace(/\*\*(.*?)\*\*/gim, '<strong class="font-bold text-black">$1</strong>');
    text = text.replace(/\*(.*?)\*/gim, '<em class="italic text-slate-800">$1</em>');

    // Lists
    text = text.replace(/^\- (.*$)/gim, '<li class="ml-6 list-disc text-slate-700 my-1">$1</li>');

    // Code blocks & inline code
    text = text.replace(/`([^`]+)`/gim, '<code class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-800 font-mono text-xs border border-slate-200">$1</code>');

    // Paragraphs
    text = text.replace(/\n\n+/g, '</p><p class="my-4 text-slate-700 text-base leading-relaxed">');
    return '<p class="my-4 text-slate-700 text-base leading-relaxed">' + text + '</p>';
  }

  async function resolveDynamicBlogPost() {
    const path = window.location.pathname;
    if (!path.startsWith('/blog/')) {
      document.documentElement.classList.remove('is-resolving-article');
      return;
    }

    const slug = path.replace(/^\/blog\//, '').replace(/\/$/, '');
    if (!slug) {
      window.location.replace('/blog');
      return;
    }

    const standard404 = document.getElementById('standard-404-container');
    const dynamicPost = document.getElementById('dynamic-post-container');
    const skeleton = document.getElementById('article-loading-skeleton');

    function renderPost(p: any) {
      if (skeleton) skeleton.style.display = 'none';
      if (standard404) standard404.style.display = 'none';
      if (dynamicPost) dynamicPost.classList.remove('hidden');

      document.title = `${p.title} | RKMIDIGILABS`;

      const elTitle = document.getElementById('dyn-title');
      const elCategory = document.getElementById('dyn-category');
      const elDate = document.getElementById('dyn-date');
      const elReadTime = document.getElementById('dyn-readtime');
      const elSummary = document.getElementById('dyn-summary');
      const elBody = document.getElementById('dyn-body');
      const videoBox = document.getElementById('dyn-video-box');
      const videoIframe = document.getElementById('dyn-video-iframe') as HTMLIFrameElement;
      const imageBox = document.getElementById('dyn-image-box');
      const imageImg = document.getElementById('dyn-image-img') as HTMLImageElement;
      const tagsContainer = document.getElementById('dyn-tags-container');

      if (elTitle) elTitle.textContent = p.title;
      if (elCategory) elCategory.textContent = p.category || 'AI Governance';
      if (elDate) elDate.textContent = p.date || new Date().toISOString().split('T')[0];
      if (elReadTime) elReadTime.textContent = p.readTime || '4 min read';
      if (elSummary) elSummary.textContent = p.summary || '';

      const ytid = extractYouTubeId(p.youtubeUrl);
      if (ytid && videoBox && videoIframe) {
        videoIframe.src = `https://www.youtube-nocookie.com/embed/${ytid}`;
        videoBox.classList.remove('hidden');
      } else if (p.image && imageBox && imageImg) {
        imageImg.src = p.image;
        imageImg.alt = p.title;
        imageBox.classList.remove('hidden');
      }

      if (elBody) {
        elBody.innerHTML = formatMarkdown(p.body || p.summary || '');
      }

      if (tagsContainer) {
        const tags = Array.isArray(p.tags) ? p.tags : [];
        tagsContainer.innerHTML = `
          <span class="text-xs font-mono text-slate-500 mr-2">Filed under:</span>
          ${tags.map((t: string) => `
            <span class="text-xs text-slate-700 bg-slate-100 px-2.5 py-1 rounded border border-slate-200">
              #${t}
            </span>
          `).join('')}
        `;
      }

      // Share buttons
      const postUrl = window.location.href;
      const shareText = `📢 ${p.title}\n\n${p.summary ? p.summary + '\n\n' : ''}${postUrl}`;
      
      document.getElementById('dyn-share-linkedin')?.addEventListener('click', () => {
        window.open(`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`, '_blank', 'width=600,height=600');
      });
      document.getElementById('dyn-share-twitter')?.addEventListener('click', () => {
        window.open(`https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}`, '_blank', 'width=600,height=600');
      });
      document.getElementById('dyn-share-whatsapp')?.addEventListener('click', () => {
        window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(shareText)}`, '_blank', 'width=800,height=700');
      });
    }

    let post: any = null;

    // 1. Instant local storage check (0ms)
    try {
      const customPosts = JSON.parse(localStorage.getItem('rkmidigi_custom_posts') || '[]');
      if (Array.isArray(customPosts)) {
        post = customPosts.find((p: any) => p.slug === slug);
      }
      if (!post) {
        const cached = localStorage.getItem(`rkmidigi_post_edit_${slug}`);
        if (cached) post = JSON.parse(cached);
      }
    } catch(e) {}

    if (post) {
      renderPost(post);
      return;
    }

    // 2. Query Supabase
    try {
      const { data, error } = await supabase.from('posts').select('*').eq('slug', slug).maybeSingle();
      if (data && !error) {
        post = {
          title: data.title,
          slug: data.slug,
          category: data.category,
          date: data.date,
          readTime: data.read_time,
          featured: data.featured,
          youtubeUrl: data.youtube_url,
          image: data.image,
          summary: data.summary,
          tags: Array.isArray(data.tags) ? data.tags : [],
          body: data.body,
          author: data.author || 'RKMIDIGILABS'
        };

        // Cache in localStorage for instant retrieval on subsequent reloads
        try {
          const list = JSON.parse(localStorage.getItem('rkmidigi_custom_posts') || '[]');
          if (!list.find((item: any) => item.slug === post.slug)) {
            list.unshift(post);
            localStorage.setItem('rkmidigi_custom_posts', JSON.stringify(list));
          }
        } catch(e) {}

        renderPost(post);
        return;
      }
    } catch(e) {}

    // 3. True 404
    document.documentElement.classList.remove('is-resolving-article');
    if (skeleton) skeleton.style.display = 'none';
    if (standard404) standard404.style.display = 'block';
    document.title = 'Page Not Found (404) | RKMIDIGILABS';
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', resolveDynamicBlogPost);
  } else {
    resolveDynamicBlogPost();
  }
</script>
