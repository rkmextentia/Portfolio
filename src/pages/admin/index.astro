      return;
    }

    try {
      const res = await fetch(`${API_BASE}/api/admin/posts/${slug}`, {
        method: 'DELETE',
        headers: { 'Authorization': `Bearer ${token}` }
      });
      const data = await res.json();
      if (data.success) {
        showToast(`Post "${slug}" was deleted.`);
        fetchPosts();

        // Broadcast deletion
        try {
          const bc = new BroadcastChannel('rkmidigi_blog_channel');
          bc.postMessage({ type: 'POST_DELETED', slug, timestamp: Date.now() });
        } catch(e) {}
        try {
          localStorage.setItem('rkmidigi_post_toggle', JSON.stringify({ slug, deleted: true, timestamp: Date.now() }));
        } catch(e) {}
      } else {
        showToast(data.error || 'Failed to delete post.', true);
