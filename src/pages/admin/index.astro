                  ${course.category || 'Executive Education'}
                </span>
                <span class="px-2.5 py-0.5 rounded text-[10px] font-mono font-bold bg-slate-100 text-slate-700 border border-slate-300">
                  Level: ${course.level || 'Practitioner'}
                </span>
              </div>
              <h3 class="text-lg font-black text-black tracking-tight">${course.title}</h3>
              <p class="text-xs text-slate-500 font-mono">${course.subtitle || ''}</p>
            </div>

            <!-- Price & Actions -->
            <div class="flex flex-wrap items-center gap-3">
              <div class="text-right pr-2">
                <div class="text-lg font-black text-slate-900">₹${(course.priceInr || 4999).toLocaleString('en-IN')}</div>
