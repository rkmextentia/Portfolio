  // Toggle Publish Status
  async function togglePublishPost(slug: string, btn?: HTMLElement) {
    const post = allPosts.find(p => p.slug === slug);
    if (!post) return;

    if (btn) {
      btn.classList.add('opacity-50', 'pointer-events-none');
    }

    post.published = !post.published;
    updateStats(allPosts);

    if (btn) {
      const isPub = post.published;
      btn.className = `publish-toggle-btn inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold transition-all cursor-pointer shadow-xs ${
        isPub 
          ? 'bg-emerald-100 text-emerald-800 border border-emerald-300 hover:bg-amber-100 hover:text-amber-900 hover:border-amber-300' 
          : 'bg-amber-100 text-amber-900 border border-amber-300 hover:bg-emerald-100 hover:text-emerald-800 hover:border-emerald-300'
      }`;
      btn.title = isPub 
        ? 'Status: Published. Click to Unpublish (set to Draft)' 
        : 'Status: Unpublished. Click to Publish (make Live)';
      btn.innerHTML = `<span class="w-2 h-2 rounded-full ${isPub ? 'bg-emerald-500' : 'bg-amber-500'}"></span><span class="btn-label">${isPub ? 'Published' : 'Unpublished'}</span>`;
    }

    // Persist to localStorage
    try {
      const toggles = JSON.parse(localStorage.getItem('rkmidigi_post_toggles') || '{}');
      toggles[slug] = post.published;
      localStorage.setItem('rkmidigi_post_toggles', JSON.stringify(toggles));
      localStorage.setItem('rkmidigi_post_toggle', JSON.stringify({ slug, published: post.published, timestamp: Date.now() }));
    } catch(e) {}

    // Broadcast to open tabs
    try {
      const bc = new BroadcastChannel('rkmidigi_blog_channel');
      bc.postMessage({ type: 'POST_PUBLISH_TOGGLED', slug, published: post.published, timestamp: Date.now() });
    } catch(e) {}

    // Update in Supabase if exists
    try {
      await supabase.from('posts').update({ published: post.published }).eq('slug', slug);
    } catch(e) {}

    // If local Node server running, update local file
    if (isLocal) {
      try {
        await fetch(`${API_BASE}/api/admin/posts/${slug}/toggle-publish`, {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}` }
        });
      } catch (err) {}
    }

    showToast(post.published ? '✅ Post marked as Published!' : '⚠️ Post marked as Unpublished (Draft)!');
    applyFilter();

    if (btn) {
      btn.classList.remove('opacity-50', 'pointer-events-none');
    }
  }

