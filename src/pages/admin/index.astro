  function switchTab(tabId) {
    currentTab = tabId;
    tabs.forEach(t => {
      const btn = document.getElementById(`tab-btn-${t}`);
      const section = document.getElementById(`section-${t}`);
      if (t === tabId) {
        btn?.classList.remove('bg-white', 'text-slate-700', 'hover:bg-slate-50', 'border-slate-300');
        btn?.classList.add('bg-[#112649]', 'text-white', 'border-[#112649]', 'shadow-sm');
        section?.classList.remove('hidden');
      } else {
        btn?.classList.remove('bg-[#112649]', 'text-white', 'border-[#112649]', 'shadow-sm');
        btn?.classList.add('bg-white', 'text-slate-700', 'hover:bg-slate-50', 'border-slate-300');
        section?.classList.add('hidden');
