---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Admin Dashboard — RKMIDIGILABS Studio" 
  description="Manage, edit, preview, and publish blog articles and YouTube videos for RKMIDIGILABS."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Top Bar with User Info & Actions -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-200">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg overflow-hidden bg-white p-0.5 shadow-sm shrink-0 border border-slate-300">
          <img src="/images/rkmidigilabs-logo.jpg" alt="RKMIDIGILABS Logo" class="w-full h-full object-contain" />
        </div>
        <div>
          <h1 class="text-2xl font-black text-black tracking-tight">RKMIDIGILABS Admin Studio</h1>
          <p class="text-xs text-slate-500 font-mono">Full Control Content Management & Publishing Hub</p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2.5">
        <!-- Live API Server Status Badge -->
        <a 
          href="http://localhost:4322/api/admin/health" 
          target="_blank"
          title="Click to check live API health on port 4322" 
          class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-[11px] font-mono font-bold bg-emerald-50 text-emerald-800 border border-emerald-200 hover:bg-emerald-100 transition-colors"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>API 4322 Online</span>
        </a>

        <a 
          href="/" 
          target="_blank" 
          class="px-3 py-1.5 rounded-lg text-xs font-bold bg-white text-slate-700 hover:bg-slate-100 border border-slate-300 shadow-sm transition-colors flex items-center gap-1.5"
        >
          <span>View Site</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>

        <button 
          type="button" 
          id="rebuild-btn" 
          class="px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-100 text-slate-800 hover:bg-slate-200 border border-slate-300 shadow-sm transition-colors flex items-center gap-1.5"
        >
          <svg class="w-3.5 h-3.5 text-[#16A34A]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          <span>Rebuild</span>
        </button>

        <button 
          type="button" 
          id="social-settings-btn" 
          class="px-3 py-1.5 rounded-lg text-xs font-bold bg-blue-50 hover:bg-blue-100 text-blue-800 border border-blue-200 shadow-sm transition-colors flex items-center gap-1.5"
          title="Manage Social Media Accounts & Webhooks"
        >
          <svg class="w-3.5 h-3.5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
          <span class="hidden sm:inline">Social Accounts</span>
        </button>

        <!-- Inquiries Button -->
        <button 
          type="button" 
          id="inquiries-btn" 
          class="px-3 py-1.5 rounded-lg text-xs font-bold bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-200 shadow-sm transition-colors flex items-center gap-1.5"
          title="View Client Service Inquiries delivered to rkmvedant@gmail.com"
        >
          <svg class="w-3.5 h-3.5 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          <span class="hidden sm:inline">Inquiries</span>
          <span id="inquiries-count-badge" class="px-1.5 py-0.2 rounded-full text-[10px] font-mono bg-amber-200 text-amber-900 font-black">0</span>
        </button>

        <a 
          href="/admin/new" 
          class="px-3.5 py-1.5 rounded-lg text-xs font-bold bg-[#16A34A] hover:bg-[#15803D] text-white shadow-sm transition-all flex items-center gap-1.5"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          <span>+ New Post</span>
        </a>

        <!-- Profile Button -->
        <button 
          type="button" 
          id="profile-btn" 
          class="px-3 py-1.5 rounded-lg text-xs font-bold bg-white hover:bg-slate-50 border border-slate-300 shadow-sm transition-colors flex items-center gap-1.5 text-slate-800"
          title="View Administrator Profile & Organization Details"
        >
          <span class="w-5 h-5 rounded-full bg-[#112649] text-white flex items-center justify-center text-[10px] font-black">RK</span>
          <span class="hidden md:inline">Profile</span>
          <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </button>

        <!-- Logout Button -->
        <button 
          type="button" 
          id="logout-btn" 
          class="px-3 py-1.5 rounded-lg text-xs font-bold bg-red-50 hover:bg-red-100 text-red-700 border border-red-200 shadow-sm transition-colors flex items-center gap-1.5"
          title="Sign Out of Admin"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          <span>Log Out</span>
        </button>
      </div>
    </div>

    <!-- Live Status Banner -->
    <div id="status-toast" class="hidden my-4 p-3 rounded-lg bg-emerald-50 border border-emerald-300 text-xs font-bold text-emerald-800 flex items-center justify-between">
      <span id="status-text">Action completed successfully.</span>
      <button type="button" onclick="document.getElementById('status-toast').classList.add('hidden')" class="text-emerald-600 hover:text-emerald-950 font-black">✕</button>
    </div>

    <!-- Quick Stats Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 my-8">
      <div class="p-5 rounded-xl bg-white border border-slate-200 shadow-sm">
        <span class="text-xs font-mono font-bold uppercase text-slate-500">Total Articles</span>
        <div id="stat-total" class="text-3xl font-black text-black mt-2">--</div>
        <span class="text-[11px] text-slate-400">Total Markdown files</span>
      </div>

      <div class="p-5 rounded-xl bg-white border border-slate-200 shadow-sm">
        <span class="text-xs font-mono font-bold uppercase text-slate-500">Live Published</span>
        <div id="stat-published" class="text-3xl font-black text-[#16A34A] mt-2">--</div>
        <span class="text-[11px] text-slate-400">Visible on public blog</span>
      </div>

      <div class="p-5 rounded-xl bg-white border border-slate-200 shadow-sm">
        <span class="text-xs font-mono font-bold uppercase text-slate-500">Drafts / Unpublished</span>
        <div id="stat-drafts" class="text-3xl font-black text-amber-600 mt-2">--</div>
        <span class="text-[11px] text-slate-400">Hidden from public</span>
      </div>

      <div class="p-5 rounded-xl bg-white border border-slate-200 shadow-sm">
        <span class="text-xs font-mono font-bold uppercase text-slate-500">Video Episodes</span>
        <div id="stat-videos" class="text-3xl font-black text-red-600 mt-2">--</div>
        <span class="text-[11px] text-slate-400">YouTube facade embeds</span>
      </div>
    </div>

    <!-- Posts Filter & Search -->
    <div class="bg-white border border-slate-200 rounded-xl p-4 mb-6 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-sm">
      <div class="w-full sm:w-80 relative">
        <input 
          type="text" 
          id="search-input" 
          placeholder="Search by title, tag, or slug..." 
          class="w-full pl-9 pr-3 py-2 rounded-lg border border-slate-300 text-xs font-medium focus:outline-none focus:ring-2 focus:ring-[#16A34A] focus:border-transparent"
        />
        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </div>

      <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
        <div class="flex items-center gap-1.5">
          <span class="text-xs font-mono text-slate-500 font-bold shrink-0">Status:</span>
          <select 
            id="status-filter"
            class="px-3 py-2 rounded-lg border border-slate-300 text-xs font-bold text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-[#16A34A]"
          >
            <option value="All">All Statuses</option>
            <option value="Published">Published Only</option>
            <option value="Unpublished">Unpublished (Drafts)</option>
          </select>
        </div>

        <div class="flex items-center gap-1.5">
          <span class="text-xs font-mono text-slate-500 font-bold shrink-0">Category:</span>
          <select 
            id="category-filter"
            class="px-3 py-2 rounded-lg border border-slate-300 text-xs font-bold text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-[#16A34A]"
          >
            <option value="All">All Categories</option>
            <option value="AI Governance">AI Governance</option>
            <option value="Enterprise GRC">Enterprise GRC</option>
            <option value="Corporate Training">Corporate Training</option>
            <option value="Regulatory Alerts">Regulatory Alerts</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Posts Table -->
    <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-100 text-slate-700 uppercase font-mono tracking-wider border-b border-slate-200">
            <tr>
              <th class="py-3 px-4">Title & Details</th>
              <th class="py-3 px-4">Category</th>
              <th class="py-3 px-4">Published Date</th>
              <th class="py-3 px-4">Format</th>
              <th class="py-3 px-4">Publish Status</th>
              <th class="py-3 px-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="posts-table-body" class="divide-y divide-slate-100 font-medium">
            <tr>
              <td colspan="6" class="py-8 text-center text-slate-500">
                Loading posts from RKMIDIGILABS content store...
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Profile & Account Modal -->
    <div id="profile-modal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-black/50 backdrop-blur-sm flex items-center justify-center p-4">
      <div class="bg-white rounded-2xl shadow-2xl border border-slate-300 max-w-lg w-full overflow-hidden">
        
        <!-- Modal Header -->
        <div class="bg-[#112649] p-6 text-white flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-xl bg-white p-1 shrink-0 border border-slate-300">
              <img src="/images/rkmidigilabs-logo.jpg" alt="RKMIDIGILABS Logo" class="w-full h-full object-contain" />
            </div>
            <div>
              <h2 class="text-base font-black text-white">Administrator Profile</h2>
              <p class="text-xs text-slate-300 font-mono">Organization & Account Credentials</p>
            </div>
          </div>
          <button type="button" id="close-profile-btn" class="text-slate-300 hover:text-white p-1.5 rounded-lg hover:bg-white/10 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <!-- Modal Body -->
        <div class="p-6 space-y-4 text-xs">
          
          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 space-y-1.5">
            <div class="flex items-center justify-between">
              <span class="font-mono uppercase font-bold text-slate-500 text-[10px]">Organization</span>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">Active Practice</span>
            </div>
            <div class="text-base font-black text-black">RKMIDIGILABS</div>
            <div class="text-slate-600 text-[11px]">Executive AI Governance, Enterprise GRC & Masterclasses</div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="p-3 rounded-lg border border-slate-200 bg-white">
              <span class="text-[10px] font-mono uppercase text-slate-500 block mb-1">Official Email</span>
              <a href="mailto:rkmvedant@gmail.com" class="font-bold text-black hover:text-[#16A34A] block truncate">
                rkmvedant@gmail.com
              </a>
            </div>
            <div class="p-3 rounded-lg border border-slate-200 bg-white">
              <span class="text-[10px] font-mono uppercase text-slate-500 block mb-1">Mobile / WhatsApp</span>
              <a href="tel:+919371650121" class="font-bold text-black hover:text-[#16A34A] block">
                +91 9371650121
              </a>
            </div>
          </div>

          <div class="p-3.5 rounded-lg border border-slate-200 bg-slate-50 space-y-2">
            <div class="flex items-center justify-between text-[11px]">
              <span class="text-slate-500 font-mono">Access Role:</span>
              <strong class="text-black">Super Administrator (Full Master Control)</strong>
            </div>
            <div class="flex items-center justify-between text-[11px]">
              <span class="text-slate-500 font-mono">Admin API Server:</span>
              <strong class="text-[#16A34A]">http://localhost:4322 (Healthy)</strong>
            </div>
            <div class="flex items-center justify-between text-[11px]">
              <span class="text-slate-500 font-mono">Master Passcode:</span>
              <span class="text-slate-600 font-mono text-[11px]">Configured in .env file</span>
            </div>
          </div>

        </div>

        <!-- Modal Footer -->
        <div class="p-4 bg-slate-50 border-t border-slate-200 flex items-center justify-between gap-3">
          <button 
            type="button" 
            id="modal-logout-btn" 
            class="px-4 py-2 rounded-lg text-xs font-bold bg-red-50 hover:bg-red-100 text-red-700 border border-red-200 transition-colors flex items-center gap-1.5"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
            <span>Log Out</span>
          </button>

          <button 
            type="button" 
            id="modal-close-btn" 
            class="px-4 py-2 rounded-lg text-xs font-bold bg-[#112649] hover:bg-[#1a3666] text-white shadow-sm transition-colors"
          >
            Close
          </button>
        </div>

      </div>
    </div>

    <!-- Social Settings Modal -->
    <div id="social-settings-modal" class="hidden fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs flex items-center justify-center p-4">
      <div class="bg-white rounded-2xl border border-slate-300 shadow-2xl max-w-lg w-full overflow-hidden animate-in fade-in zoom-in-95 duration-150">
        
        <div class="bg-[#112649] text-white p-5 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
            </div>
            <div>
              <h3 class="font-extrabold text-sm tracking-tight">Connected Social Media Accounts</h3>
              <p class="text-[11px] text-slate-300">RKMIDIGILABS Channels & Webhook Integration</p>
            </div>
          </div>
          <button type="button" id="close-social-settings-btn" class="p-1 rounded text-slate-300 hover:text-white hover:bg-[#1a3666]">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <form id="social-settings-form" class="p-6 space-y-4 text-xs max-h-[75vh] overflow-y-auto">
          <div>
            <label class="block font-bold text-slate-700 mb-1">LinkedIn Company / Profile URL</label>
            <input type="text" id="cfg-linkedin" class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs font-mono focus:ring-2 focus:ring-[#16A34A] focus:outline-none" placeholder="https://www.linkedin.com/company/rkmidigilabs" />
          </div>

          <div>
            <label class="block font-bold text-slate-700 mb-1">X (Twitter) Profile URL / Handle</label>
            <input type="text" id="cfg-twitter" class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs font-mono focus:ring-2 focus:ring-[#16A34A] focus:outline-none" placeholder="https://x.com/rkmidigilabs" />
          </div>

          <div>
            <label class="block font-bold text-slate-700 mb-1">YouTube Channel URL</label>
            <input type="text" id="cfg-youtube" class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs font-mono focus:ring-2 focus:ring-[#16A34A] focus:outline-none" placeholder="https://www.youtube.com/@rkmidigilabs" />
          </div>

          <div>
            <label class="block font-bold text-slate-700 mb-1">Facebook Page URL</label>
            <input type="text" id="cfg-facebook" class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs font-mono focus:ring-2 focus:ring-[#16A34A] focus:outline-none" placeholder="https://www.facebook.com/rkmidigilabs" />
          </div>

          <div>
            <label class="block font-bold text-slate-700 mb-1">WhatsApp Business Hotline</label>
            <input type="text" id="cfg-whatsapp" class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs font-mono focus:ring-2 focus:ring-[#16A34A] focus:outline-none" placeholder="+91 9371650121" />
          </div>

          <div>
            <label class="block font-bold text-slate-700 mb-1">Company Brochure & Profile Destination URL</label>
            <input type="text" id="cfg-brochure" class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs font-mono focus:ring-2 focus:ring-[#16A34A] focus:outline-none" placeholder="http://localhost:4321/company-profile" />
          </div>

          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 space-y-2">
            <div class="flex items-center justify-between">
              <span class="font-bold text-slate-700">Automated Webhook Cross-Posting</span>
              <label class="flex items-center gap-1.5 cursor-pointer">
                <input type="checkbox" id="cfg-webhook-enabled" class="rounded text-[#16A34A] focus:ring-[#16A34A]" />
                <span class="text-[11px] font-bold text-slate-700">Enable</span>
              </label>
            </div>
            <p class="text-[11px] text-slate-500 leading-normal">
              Provide a webhook endpoint (from Buffer, Zapier, Make, or custom API) to automatically broadcast new posts to all social media profiles.
            </p>
            <input type="url" id="cfg-webhook-url" class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs font-mono focus:ring-2 focus:ring-[#16A34A] focus:outline-none" placeholder="https://hooks.zapier.com/hooks/catch/..." />
          </div>

          <div class="flex items-center justify-end gap-3 pt-2">
            <button type="button" id="cancel-social-settings-btn" class="px-4 py-2 rounded-lg text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700">
              Cancel
            </button>
            <button type="submit" class="px-4 py-2 rounded-lg text-xs font-bold bg-[#16A34A] hover:bg-[#15803D] text-white shadow-sm">
              Save Configuration
            </button>
          </div>
        </form>

      </div>
    </div>

    <!-- Social Push / Share Modal -->
    <div id="social-push-modal" class="hidden fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs flex items-center justify-center p-4">
      <div class="bg-white rounded-2xl border border-slate-300 shadow-2xl max-w-xl w-full overflow-hidden animate-in fade-in zoom-in-95 duration-150">
        
        <div class="bg-[#112649] text-white p-5 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-[#16A34A] flex items-center justify-center text-white font-bold">
              🚀
            </div>
            <div>
              <h3 class="font-extrabold text-sm tracking-tight">Social Media Broadcast & Push</h3>
              <p class="text-[11px] text-slate-300">Share to LinkedIn, X, Facebook & WhatsApp</p>
            </div>
          </div>
          <button type="button" id="close-social-push-btn" class="p-1 rounded text-slate-300 hover:text-white hover:bg-[#1a3666]">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <div class="p-6 space-y-4 text-xs max-h-[75vh] overflow-y-auto">
          
          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
            <span class="text-[10px] font-mono font-bold uppercase text-slate-500 block mb-1">Target Article</span>
            <div id="push-post-title" class="font-bold text-black text-sm">--</div>
            <div id="push-post-url" class="text-[11px] text-slate-500 font-mono mt-0.5">--</div>
          </div>

          <div>
