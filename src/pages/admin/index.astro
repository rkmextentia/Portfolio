  // Push Data to Supabase Button Action
  const pushToSupabaseBtn = document.getElementById('push-to-supabase-btn');
  pushToSupabaseBtn?.addEventListener('click', async () => {
    if (pushToSupabaseBtn) {
      pushToSupabaseBtn.setAttribute('disabled', 'true');
      pushToSupabaseBtn.textContent = 'Pushing Data...';
    }
    showToast('Pushing 3 Masterclasses and 24 Lessons to Supabase cloud database...');

    try {
      const coursesToSeed = staticCourses || [];
      for (const course of coursesToSeed) {
        await supabase.from('courses').upsert({
          id: course.id,
          slug: course.slug,
          title: course.title,
          subtitle: course.subtitle,
          summary: course.summary,
          description: course.description,
          category: course.category,
          level: course.level,
          price_inr: course.priceInr,
          original_price_inr: course.originalPriceInr,
          duration_hours: course.durationHours,
          total_lessons: (course.lessons || []).length,
          thumbnail_url: course.thumbnailUrl,
          featured: course.featured,
          is_published: true
        });

        for (const l of (course.lessons || [])) {
          await supabase.from('lessons').upsert({
            id: l.id,
            course_id: course.id,
            order_index: l.orderIndex,
            title: l.title,
            duration: l.duration,
            description: l.description,
            video_url: l.videoUrl,
            is_free_preview: l.isFreePreview
          });
        }
      }

      showToast('All 3 Masterclasses and 24 Video Lessons successfully pushed to Supabase PostgreSQL!');
      await fetchCoursesFromSupabase();
      renderCourses();
    } catch (err) {
      showToast('Error pushing data: ' + (err.message || 'Check database connection'), true);
    } finally {
      if (pushToSupabaseBtn) {
        pushToSupabaseBtn.removeAttribute('disabled');
        pushToSupabaseBtn.innerHTML = '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg><span>Push Data to Supabase</span>';
      }
    }
  });

  // Lesson Edit Modal Handler
  const lessonModal = document.getElementById('lesson-edit-modal');
  const lessonForm = document.getElementById('lesson-edit-form');
  const closeLessonModalBtn = document.getElementById('close-lesson-modal-btn');
  const cancelLessonModalBtn = document.getElementById('cancel-lesson-modal-btn');

  function openLessonEditModal(courseId, lessonId) {
    const courses = activeCourses.length > 0 ? activeCourses : getCustomCourses();
    const course = courses.find(c => c.id === courseId);
    if (!course) return;

    (document.getElementById('edit-lesson-course-id') as HTMLInputElement).value = courseId;
    const nameEl = document.getElementById('edit-lesson-course-name');
    if (nameEl) nameEl.textContent = course.title;

    if (lessonId === 'new') {
      (document.getElementById('edit-lesson-id') as HTMLInputElement).value = `les-${Date.now()}`;
      (document.getElementById('edit-lesson-title') as HTMLInputElement).value = '';
      (document.getElementById('edit-lesson-duration') as HTMLInputElement).value = '15:00';
      (document.getElementById('edit-lesson-free') as HTMLInputElement).checked = false;
      (document.getElementById('edit-lesson-video') as HTMLInputElement).value = '';
      (document.getElementById('edit-lesson-desc') as HTMLTextAreaElement).value = '';
    } else {
      const lesson = (course.lessons || []).find(l => l.id === lessonId);
      if (!lesson) return;
      (document.getElementById('edit-lesson-id') as HTMLInputElement).value = lesson.id;
      (document.getElementById('edit-lesson-title') as HTMLInputElement).value = lesson.title || '';
      (document.getElementById('edit-lesson-duration') as HTMLInputElement).value = lesson.duration || '15:00';
      (document.getElementById('edit-lesson-free') as HTMLInputElement).checked = !!lesson.isFreePreview;
      (document.getElementById('edit-lesson-video') as HTMLInputElement).value = lesson.videoUrl || '';
      (document.getElementById('edit-lesson-desc') as HTMLTextAreaElement).value = lesson.description || '';
    }

    lessonModal?.classList.remove('hidden');
  }

  window.openLessonEdit = openLessonEditModal;

  function closeLessonEditModal() {
    lessonModal?.classList.add('hidden');
  }

  closeLessonModalBtn?.addEventListener('click', closeLessonEditModal);
  cancelLessonModalBtn?.addEventListener('click', closeLessonEditModal);

  lessonForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const courseId = (document.getElementById('edit-lesson-course-id') as HTMLInputElement).value;
    const lessonId = (document.getElementById('edit-lesson-id') as HTMLInputElement).value;
    const title = (document.getElementById('edit-lesson-title') as HTMLInputElement).value.trim();
    const duration = (document.getElementById('edit-lesson-duration') as HTMLInputElement).value.trim();
    const isFree = (document.getElementById('edit-lesson-free') as HTMLInputElement).checked;
    const videoUrl = (document.getElementById('edit-lesson-video') as HTMLInputElement).value.trim();
    const description = (document.getElementById('edit-lesson-desc') as HTMLTextAreaElement).value.trim();

    const courses = activeCourses.length > 0 ? activeCourses : getCustomCourses();
    const course = courses.find(c => c.id === courseId);
    if (course) {
      if (!Array.isArray(course.lessons)) course.lessons = [];
      const idx = course.lessons.findIndex(l => l.id === lessonId);
      const updatedLesson = {
        id: lessonId,
        orderIndex: idx >= 0 ? course.lessons[idx].orderIndex : course.lessons.length + 1,
        title,
        duration,
        isFreePreview: isFree,
        videoUrl,
        description
      };

      if (idx >= 0) {
        course.lessons[idx] = updatedLesson;
      } else {
        course.lessons.push(updatedLesson);
      }

      saveCustomCourses(courses);
      renderCourses();

      // Sync to Supabase
      try {
        await supabase.from('lessons').upsert({
          id: updatedLesson.id,
          course_id: courseId,
          order_index: updatedLesson.orderIndex,
          title: updatedLesson.title,
          duration: updatedLesson.duration,
          description: updatedLesson.description,
          video_url: updatedLesson.videoUrl,
          is_free_preview: updatedLesson.isFreePreview
        });
      } catch (e) {}

      // If local server active, also sync
      try {
        await fetch(`${API_BASE}/api/admin/courses/lessons`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
          body: JSON.stringify({ courseId, lesson: updatedLesson })
        });
      } catch (err) {}

      closeLessonEditModal();
      showToast(`Lesson "${title}" updated successfully!`);
    }
  });

  // ==========================================
  // SUPABASE STUDENTS & ENROLLMENTS MANAGER
  // ==========================================
  let allStudents = [];
  let allEnrollments = [];

  async function fetchStudentsAndEnrollments() {
    const tbody = document.getElementById('students-table-body');
    if (!tbody) return;

    tbody.innerHTML = `<tr><td colspan="5" class="py-8 text-center text-xs text-slate-500 font-mono">Syncing with Supabase Cloud Database...</td></tr>`;

    try {
      allStudents = await getAdminStudentProfiles();
      allEnrollments = await getAdminEnrollments();
    } catch (e) {
      console.warn('Could not query Supabase helpers:', e);
    }

    renderStudentsTable();
  }

  function renderStudentsTable() {
    const tbody = document.getElementById('students-table-body');
    const statStudents = document.getElementById('stat-students');
    const statEnrollments = document.getElementById('stat-enrollments');
    const statRevenue = document.getElementById('stat-revenue');
    const tabStudentsBadge = document.getElementById('tab-students-count');
    if (!tbody) return;

    // Filter by search & course
    const searchVal = ((document.getElementById('student-search-input') as HTMLInputElement)?.value || '').toLowerCase().trim();
    const courseFilter = (document.getElementById('student-course-filter') as HTMLSelectElement)?.value || 'All';

    let filtered = allStudents.filter(s => {
      const matchSearch = !searchVal || 
        (s.email || '').toLowerCase().includes(searchVal) || 
        (s.full_name || '').toLowerCase().includes(searchVal);
      
      const enrolledCourses = allEnrollments
        .filter(e => e.student_email?.toLowerCase() === s.email?.toLowerCase() && e.status === 'active')
        .map(e => e.course_id);

      const matchCourse = courseFilter === 'All' || enrolledCourses.includes(courseFilter);
      return matchSearch && matchCourse;
    });

    // Update Stats
    const totalStudents = allStudents.length;
    const activeEnrollments = allEnrollments.filter(e => e.status === 'active');
    const totalRev = activeEnrollments.reduce((sum, e) => sum + (e.amount_inr || 4999), 0);

    if (statStudents) statStudents.textContent = totalStudents.toString();
    if (statEnrollments) statEnrollments.textContent = activeEnrollments.length.toString();
    if (statRevenue) statRevenue.textContent = `Est. Rev: ₹${totalRev.toLocaleString('en-IN')}`;
    if (tabStudentsBadge) tabStudentsBadge.textContent = `${totalStudents} Active`;

    if (filtered.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="5" class="py-8 text-center text-xs text-slate-500">
            No registered students found matching filter.
          </td>
        </tr>
      `;
      return;
    }

    const coursesMap = new Map((staticCourses || []).map(c => [c.id, c.title]));

    tbody.innerHTML = filtered.map(s => {
      const userEnrollments = allEnrollments.filter(e => e.student_email?.toLowerCase() === s.email?.toLowerCase());
      const enrolledBadges = userEnrollments.length > 0
        ? userEnrollments.map(e => {
            const title = coursesMap.get(e.course_id) || e.course_id;
            const isRevoked = e.status === 'revoked';
            return `
              <span class="px-2 py-0.5 rounded text-[10px] font-bold ${
                isRevoked 
                  ? 'bg-red-100 text-red-700 border border-red-200 line-through' 
                  : 'bg-emerald-100 text-emerald-800 border border-emerald-200'
              }">
                ${title.split('Masterclass')[0].split('Bootcamp')[0].trim()} (${e.status})
              </span>
            `;
          }).join(' ')
        : '<span class="text-slate-400 font-mono text-[11px]">No active enrollments</span>';

      const initial = (s.full_name || s.email || 'S').charAt(0).toUpperCase();

      return `
        <tr class="hover:bg-slate-50 transition-colors">
          <td class="py-3 px-4">
            <div class="flex items-center gap-2.5">
              <div class="w-7 h-7 rounded-full bg-[#112649] text-white flex items-center justify-center font-bold text-xs shrink-0">
                ${initial}
              </div>
              <div>
                <div class="font-bold text-slate-900">${s.full_name || 'Student Account'}</div>
                <div class="text-[11px] text-slate-500 font-mono">${s.email}</div>
              </div>
            </div>
          </td>
          <td class="py-3 px-4">
            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold ${
              s.role === 'admin' ? 'bg-purple-100 text-purple-800 border border-purple-300' : 'bg-slate-100 text-slate-700'
            }">
              ${(s.role || 'student').toUpperCase()}
            </span>
          </td>
          <td class="py-3 px-4">
            <div class="flex flex-wrap gap-1">
              ${enrolledBadges}
            </div>
          </td>
          <td class="py-3 px-4 font-mono text-slate-500 text-[11px]">
            ${(s.created_at || '').split('T')[0] || '2026-09-01'}
          </td>
          <td class="py-3 px-4 text-right">
            <div class="flex items-center justify-end gap-1.5">
              <button 
                type="button" 
                onclick="window.quickEnroll('${s.email}', '${s.full_name || ''}')"
                class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-[#16A34A] hover:bg-[#15803D] text-white shadow-xs cursor-pointer"
                title="Grant course access"
              >
                + Enroll
              </button>
              <a 
                href="mailto:${s.email}?subject=RKMIDIGILABS Academy Access" 
                class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-white text-slate-700 border border-slate-300 hover:bg-slate-100"
                title="Send email"
              >
                Email
              </a>
            </div>
          </td>
        </tr>
      `;
    }).join('');
  }

  document.getElementById('student-search-input')?.addEventListener('input', renderStudentsTable);
  document.getElementById('student-course-filter')?.addEventListener('change', renderStudentsTable);
  document.getElementById('refresh-students-btn')?.addEventListener('click', fetchStudentsAndEnrollments);

  // Manual Course Enrollment Modal Handlers
  const enrollModal = document.getElementById('enroll-student-modal');
  const enrollForm = document.getElementById('enroll-student-form');
  const openEnrollBtn = document.getElementById('open-enroll-modal-btn');
  const closeEnrollBtn = document.getElementById('close-enroll-modal-btn');
  const cancelEnrollBtn = document.getElementById('cancel-enroll-modal-btn');

  function openEnrollModal(prefillEmail = '', prefillName = '') {
    (document.getElementById('enroll-email') as HTMLInputElement).value = prefillEmail;
    (document.getElementById('enroll-name') as HTMLInputElement).value = prefillName;
    (document.getElementById('enroll-payment-ref') as HTMLInputElement).value = 'MANUAL-UPI-' + Date.now().toString().slice(-6);
    enrollModal?.classList.remove('hidden');
  }

  window.quickEnroll = openEnrollModal;

  openEnrollBtn?.addEventListener('click', () => openEnrollModal());
  closeEnrollBtn?.addEventListener('click', () => enrollModal?.classList.add('hidden'));
  cancelEnrollBtn?.addEventListener('click', () => enrollModal?.classList.add('hidden'));

  enrollForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (document.getElementById('enroll-email') as HTMLInputElement).value.trim();
    const name = (document.getElementById('enroll-name') as HTMLInputElement).value.trim();
    const courseId = (document.getElementById('enroll-course-select') as HTMLSelectElement).value;
    const paymentRef = (document.getElementById('enroll-payment-ref') as HTMLInputElement).value.trim();

    if (!email || !courseId) return;

    const submitBtn = document.getElementById('submit-enroll-btn');
    if (submitBtn) {
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.textContent = 'Activating...';
    }

    try {
      await adminGrantCourseAccess(email, courseId, paymentRef, name || 'Student');
      enrollModal?.classList.add('hidden');
      showToast(`Access granted to ${email} for course!`);
      await fetchStudentsAndEnrollments();
    } catch (err: any) {
      showToast(err.message || 'Failed to grant enrollment', true);
    } finally {
      if (submitBtn) {
        submitBtn.removeAttribute('disabled');
        submitBtn.textContent = 'Activate Access';
      }
    }
  });

  // Background fetch of inquiries count
  fetchInquiries();

  // Initial fetch of posts, courses, and students immediately on load
  fetchPosts();
  fetchCoursesFromSupabase().then(() => renderCourses());
  fetchStudentsAndEnrollments();
</script>
</BaseLayout>