        templateViewerContent.innerHTML = data.html;
      } else {
        templateViewerContent.innerHTML = `<div class="p-8 text-center text-xs text-red-500">${data.error || 'Failed to load template.'}</div>`;
      }
    } catch (e) {
      templateViewerContent.innerHTML = '<div class="p-8 text-center text-xs text-red-500">Error loading email template archive.</div>';
    }
  }

  (window as any).viewInquiryTemplate = openTemplateViewer;

  function openInquiriesModal() {
    fetchInquiries();
    inquiriesModal?.classList.remove('hidden');
  }
  function closeInquiriesModal() {
    inquiriesModal?.classList.add('hidden');
  }

  inquiriesBtn?.addEventListener('click', openInquiriesModal);
  closeInquiriesBtn?.addEventListener('click', closeInquiriesModal);
  doneInquiriesBtn?.addEventListener('click', closeInquiriesModal);

  closeTemplateViewerBtn?.addEventListener('click', () => {
    templateViewerModal?.classList.add('hidden');
  });

  // Background fetch of inquiries count
  fetchInquiries();

  // Initial fetch
  fetchPosts();
</script>
</BaseLayout>