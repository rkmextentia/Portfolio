---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { COURSES } from '../../lib/courses-data';

const staticCollection = await getCollection('blog');
const staticPosts = staticCollection.map(p => ({
  slug: p.slug,
  title: p.data.title,
  date: p.data.date.toISOString().split('T')[0],
  category: p.data.category,
  tags: p.data.tags,
  youtubeUrl: p.data.youtubeUrl,
  image: p.data.image,
  summary: p.data.summary,
  featured: p.data.featured,
  published: p.data.published,
  readTime: p.data.readTime,
  author: p.data.author
}));
---

<BaseLayout 
  title="Admin Dashboard — RKMIDIGILABS Studio" 
  description="Manage, edit, preview, and publish blog articles and YouTube videos for RKMIDIGILABS."
>
  <script id="admin-static-data" type="application/json" set:html={JSON.stringify({ staticPosts, staticCourses: COURSES })} />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Top Bar with User Info & Actions -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-200">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg overflow-hidden bg-white p-0.5 shadow-sm shrink-0 border border-slate-300">
          <img src="/images/rkmidigilabs-logo.jpg" alt="RKMIDIGILABS Logo" class="w-full h-full object-contain" />
        </div>
        <div>
          <h1 class="text-2xl font-black text-black tracking-tight">RKMIDIGILABS Admin Studio</h1>
          <p class="text-xs text-slate-500 font-mono">Full Control Content Management & Publishing Hub</p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2.5">
        <!-- Live Studio Status Badge -->
        <div 
          id="system-mode-badge"
          class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-[11px] font-mono font-bold bg-emerald-50 text-emerald-800 border border-emerald-200 shadow-2xs"
          title="Studio Connected & Live"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span id="system-mode-text">Studio Live & Synced</span>
        </div>

        <a 
          href="/" 
          target="_blank" 
          class="px-3 py-1.5 rounded-lg text-xs font-bold bg-white text-slate-700 hover:bg-slate-100 border border-slate-300 shadow-sm transition-colors flex items-center gap-1.5"
        >
          <span>View Site</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>

        <button 
          type="button" 
          id="rebuild-btn" 
          class="px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-100 text-slate-800 hover:bg-slate-200 border border-slate-300 shadow-sm transition-colors flex items-center gap-1.5"
        >
          <svg class="w-3.5 h-3.5 text-[#16A34A]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          <span>Rebuild</span>
        </button>

        <button 
          type="button" 
          id="social-settings-btn" 
          class="px-3 py-1.5 rounded-lg text-xs font-bold bg-blue-50 hover:bg-blue-100 text-blue-800 border border-blue-200 shadow-sm transition-colors flex items-center gap-1.5"
          title="Manage Social Media Accounts & Webhooks"
        >
          <svg class="w-3.5 h-3.5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
          <span class="hidden sm:inline">Social Accounts</span>
        </button>

        <!-- Inquiries Button -->
        <button 
          type="button" 
          id="inquiries-btn" 
          class="px-3 py-1.5 rounded-lg text-xs font-bold bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-200 shadow-sm transition-colors flex items-center gap-1.5"
          title="View Client Service Inquiries delivered to rkmvedant@gmail.com"
        >
          <svg class="w-3.5 h-3.5 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          <span class="hidden sm:inline">Inquiries</span>
          <span id="inquiries-count-badge" class="px-1.5 py-0.2 rounded-full text-[10px] font-mono bg-amber-200 text-amber-900 font-black">0</span>
        </button>

        <a 
          href="/admin/new" 
          class="px-3.5 py-1.5 rounded-lg text-xs font-bold bg-[#16A34A] hover:bg-[#15803D] text-white shadow-sm transition-all flex items-center gap-1.5"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          <span>+ New Post</span>
        </a>

        <!-- Profile Button -->
        <button 
          type="button" 
          id="profile-btn" 
          class="px-3 py-1.5 rounded-lg text-xs font-bold bg-white hover:bg-slate-50 border border-slate-300 shadow-sm transition-colors flex items-center gap-1.5 text-slate-800"
          title="View Administrator Profile & Organization Details"
        >
          <span class="w-5 h-5 rounded-full bg-[#112649] text-white flex items-center justify-center text-[10px] font-black">RK</span>
          <span class="hidden md:inline">Profile</span>
          <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </button>

        <!-- Logout Button -->
        <button 
          type="button" 
          id="logout-btn" 
          class="px-3 py-1.5 rounded-lg text-xs font-bold bg-red-50 hover:bg-red-100 text-red-700 border border-red-200 shadow-sm transition-colors flex items-center gap-1.5"
          title="Sign Out of Admin"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          <span>Log Out</span>
        </button>
      </div>
    </div>

    <!-- Live Status Banner -->
    <div id="status-toast" class="hidden my-4 p-3 rounded-lg bg-emerald-50 border border-emerald-300 text-xs font-bold text-emerald-800 flex items-center justify-between">
      <span id="status-text">Action completed successfully.</span>
      <button type="button" onclick="document.getElementById('status-toast').classList.add('hidden')" class="text-emerald-600 hover:text-emerald-950 font-black">✕</button>
    </div>

    <!-- Enhanced 5-Metric Stats Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-3.5 my-8">
      <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-sm">
        <span class="text-[11px] font-mono font-bold uppercase text-slate-500">Blog Articles</span>
        <div id="stat-total" class="text-2xl font-black text-black mt-1.5">--</div>
        <span class="text-[10px] text-slate-400">Total Publications</span>
      </div>

      <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-sm">
        <span class="text-[11px] font-mono font-bold uppercase text-slate-500">Live Published</span>
        <div id="stat-published" class="text-2xl font-black text-[#16A34A] mt-1.5">--</div>
        <span class="text-[10px] text-slate-400">Public & Searchable</span>
      </div>

      <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-sm">
        <span class="text-[11px] font-mono font-bold uppercase text-emerald-700">Masterclasses</span>
        <div id="stat-courses" class="text-2xl font-black text-emerald-600 mt-1.5">3</div>
        <span class="text-[10px] text-slate-400">Active Video Curricula</span>
      </div>

      <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-sm">
        <span class="text-[11px] font-mono font-bold uppercase text-blue-700">Students Registered</span>
        <div id="stat-students" class="text-2xl font-black text-blue-600 mt-1.5">--</div>
        <span class="text-[10px] text-slate-400">Supabase Profiles</span>
      </div>

      <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-sm col-span-2 lg:col-span-1">
        <span class="text-[11px] font-mono font-bold uppercase text-amber-700">Active Enrollments</span>
        <div id="stat-enrollments" class="text-2xl font-black text-amber-600 mt-1.5">--</div>
        <span class="text-[10px] text-slate-400" id="stat-revenue">Est. Rev: ₹0</span>
      </div>
    </div>

    <!-- Main Navigation Tab Bar -->
    <div class="flex items-center gap-2 border-b border-slate-200 mb-6 overflow-x-auto pb-2">
      <button 
        type="button" 
        id="tab-btn-articles" 
        class="admin-tab-btn px-4 py-2.5 rounded-lg text-xs font-bold transition-all flex items-center gap-2 border bg-[#112649] text-white border-[#112649] shadow-sm shrink-0"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
        <span>Blog & Media</span>
      </button>

      <button 
        type="button" 
        id="tab-btn-courses" 
        class="admin-tab-btn px-4 py-2.5 rounded-lg text-xs font-bold transition-all flex items-center gap-2 border bg-white text-slate-700 hover:bg-slate-50 border-slate-300 shrink-0"
      >
        <svg class="w-4 h-4 text-[#16A34A]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
        <span>Academy Courses & Videos</span>
        <span class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-emerald-100 text-emerald-800 font-black">3 Live</span>
      </button>

      <button 
        type="button" 
        id="tab-btn-students" 
        class="admin-tab-btn px-4 py-2.5 rounded-lg text-xs font-bold transition-all flex items-center gap-2 border bg-white text-slate-700 hover:bg-slate-50 border-slate-300 shrink-0"
      >
        <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        <span>Students & Enrollments</span>
        <span id="tab-students-count" class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-blue-100 text-blue-800 font-black">Supabase</span>
      </button>

      <button 
        type="button" 
        id="tab-btn-inquiries" 
        class="admin-tab-btn px-4 py-2.5 rounded-lg text-xs font-bold transition-all flex items-center gap-2 border bg-white text-slate-700 hover:bg-slate-50 border-slate-300 shrink-0"
      >
        <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        <span>Client Inquiries</span>
        <span id="tab-inquiries-badge" class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-amber-100 text-amber-800 font-black">0</span>
      </button>
    </div>

    <!-- TAB 1: Articles & Media Section -->
    <div id="section-articles" class="space-y-6">
      <!-- Posts Filter & Search -->
      <div class="bg-white border border-slate-200 rounded-xl p-4 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-sm">
        <div class="w-full sm:w-80 relative">
          <input 
            type="text" 
            id="search-input" 
            placeholder="Search by title, tag, or slug..." 
            class="w-full pl-9 pr-3 py-2 rounded-lg border border-slate-300 text-xs font-medium focus:outline-none focus:ring-2 focus:ring-[#16A34A] focus:border-transparent"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </div>

        <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
          <div class="flex items-center gap-1.5">
            <span class="text-xs font-mono text-slate-500 font-bold shrink-0">Status:</span>
            <select 
              id="status-filter"
              class="px-3 py-2 rounded-lg border border-slate-300 text-xs font-bold text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-[#16A34A]"
            >
              <option value="All">All Statuses</option>
              <option value="Published">Published Only</option>
              <option value="Unpublished">Unpublished (Drafts)</option>
            </select>
          </div>

          <div class="flex items-center gap-1.5">
            <span class="text-xs font-mono text-slate-500 font-bold shrink-0">Category:</span>
            <select 
              id="category-filter"
              class="px-3 py-2 rounded-lg border border-slate-300 text-xs font-bold text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-[#16A34A]"
            >
              <option value="All">All Categories</option>
              <option value="AI Governance">AI Governance</option>
              <option value="Enterprise GRC">Enterprise GRC</option>
              <option value="Corporate Training">Corporate Training</option>
              <option value="Regulatory Alerts">Regulatory Alerts</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Posts Table -->
      <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-100 text-slate-700 uppercase font-mono tracking-wider border-b border-slate-200">
              <tr>
                <th class="py-3 px-4">Title & Details</th>
                <th class="py-3 px-4">Category</th>
                <th class="py-3 px-4">Published Date</th>
                <th class="py-3 px-4">Format</th>
                <th class="py-3 px-4">Publish Status</th>
                <th class="py-3 px-4 text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="posts-table-body" class="divide-y divide-slate-100 font-medium">
              <tr>
                <td colspan="6" class="py-8 text-center text-slate-500">
                  Loading posts from RKMIDIGILABS content store...
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- TAB 2: Academy Masterclasses & Video Courses Section -->
    <div id="section-courses" class="hidden space-y-6">
      <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">ACADEMY CMS</span>
            <span class="text-xs font-mono text-slate-500">Curriculum & Video Streaming Hub</span>
          </div>
          <h2 class="text-xl font-black text-black">Masterclasses, Video Lessons & Pricing</h2>
          <p class="text-xs text-slate-600 mt-1">Configure video streaming links (YouTube unlisted / Vimeo / MP4), module syllabi, and INR pricing.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2.5">
          <button 
            type="button" 
            id="push-to-supabase-btn" 
            class="px-3.5 py-2 rounded-lg text-xs font-bold bg-blue-600 hover:bg-blue-700 text-white shadow-sm flex items-center gap-1.5 transition-all cursor-pointer"
            title="Push all masterclasses and video lessons to Supabase cloud database"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
            <span>Push Data to Supabase</span>
          </button>
          <a href="/courses" target="_blank" class="px-3.5 py-2 rounded-lg text-xs font-bold bg-white text-slate-700 hover:bg-slate-100 border border-slate-300 shadow-sm flex items-center gap-1.5 transition-colors">
            <span>View Public Academy ↗</span>
          </a>
        </div>
      </div>

      <!-- Courses List Container -->
      <div id="admin-courses-container" class="space-y-6">
        <!-- Rendered dynamically via JavaScript -->
      </div>
    </div>

    <!-- TAB 3: Students & Enrollments Section -->
    <div id="section-students" class="hidden space-y-6">
      <!-- Supabase Cloud Connection Status Banner -->
      <div class="p-5 rounded-2xl bg-[#112649] text-white shadow-md flex flex-col sm:flex-row sm:items-center justify-between gap-4 border border-slate-700">
        <div class="flex items-center gap-3.5">
          <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center border border-white/20 shrink-0">
            <span class="w-3 h-3 rounded-full bg-emerald-400 animate-pulse"></span>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono font-bold text-emerald-400">SUPABASE LIVE POSTGRESQL</span>
              <span class="px-2 py-0.2 rounded text-[10px] font-mono font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">dovtttobiciiekppuvbw</span>
            </div>
            <p class="text-xs text-slate-300 mt-0.5">Real-time student registry, login credentials, and course purchase records.</p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button type="button" id="refresh-students-btn" class="px-3.5 py-2 rounded-lg text-xs font-bold bg-white/10 hover:bg-white/20 text-white border border-white/20 transition-all flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
            <span>Sync Supabase</span>
          </button>
          <button type="button" id="open-enroll-modal-btn" class="px-4 py-2 rounded-lg text-xs font-bold bg-[#16A34A] hover:bg-[#15803D] text-white shadow-sm flex items-center gap-1.5 transition-all">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
            <span>+ Grant Course Access</span>
          </button>
        </div>
      </div>

      <!-- Students Filter & Search -->
      <div class="bg-white border border-slate-200 rounded-xl p-4 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-sm">
        <div class="w-full sm:w-80 relative">
          <input 
            type="text" 
            id="student-search-input" 
            placeholder="Search by student name or email..." 
            class="w-full pl-9 pr-3 py-2 rounded-lg border border-slate-300 text-xs font-medium focus:outline-none focus:ring-2 focus:ring-[#16A34A] focus:border-transparent"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </div>

        <div class="flex items-center gap-2 w-full sm:w-auto">
          <span class="text-xs font-mono text-slate-500 font-bold shrink-0">Course Filter:</span>
          <select id="student-course-filter" class="px-3 py-2 rounded-lg border border-slate-300 text-xs font-bold text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-[#16A34A]">
            <option value="All">All Courses</option>
            <option value="course-iso-42001">ISO 42001 Lead Implementer</option>
            <option value="course-eu-ai-act">EU AI Act Bootcamp</option>
            <option value="course-nist-ai-rmf">NIST AI RMF Accelerator</option>
          </select>
        </div>
      </div>

      <!-- Students Table -->
      <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-100 text-slate-700 uppercase font-mono tracking-wider border-b border-slate-200">
              <tr>
                <th class="py-3 px-4">Student Name & Contact</th>
                <th class="py-3 px-4">Role</th>
                <th class="py-3 px-4">Enrolled Masterclasses</th>
                <th class="py-3 px-4">Registered Date</th>
                <th class="py-3 px-4 text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="students-table-body" class="divide-y divide-slate-100 font-medium">
              <tr>
                <td colspan="5" class="py-8 text-center text-slate-500">
                  Connecting to Supabase student registry...
                </td>
