<script id="admin-static-data" type="application/json" set:html={JSON.stringify({ staticPosts, staticCourses: COURSES })} />

<script>
  import { 
    supabase, 
    getAdminStudentProfiles, 
    getAdminEnrollments, 
    adminGrantCourseAccess, 
    adminRevokeCourseAccess 
  } from '../../lib/supabase';

  const staticDataEl = document.getElementById('admin-static-data');
  const { staticPosts = [], staticCourses = [] } = staticDataEl 
    ? JSON.parse(staticDataEl.textContent || '{}') 
    : { staticPosts: [], staticCourses: [] };
  const API_PORT = 4322;
  const isLocal = ['localhost', '127.0.0.1', '::1'].includes(window.location.hostname) || 
                  window.location.hostname.startsWith('192.168.') || 
                  window.location.hostname.startsWith('10.') || 
                  window.location.hostname.endsWith('.local');
  const API_BASE = isLocal 
    ? `${window.location.protocol}//${window.location.hostname}:${API_PORT}` 
    : window.location.origin;

  const token = localStorage.getItem('rkmidigi_admin_token') || sessionStorage.getItem('rkmidigi_admin_token');
  if (!token) {
    window.location.href = '/admin/login';
  }

  // Logout
  function handleLogout() {
    localStorage.removeItem('rkmidigi_admin_token');
    localStorage.removeItem('rkmidigi_admin_user');
    sessionStorage.removeItem('rkmidigi_admin_token');
    sessionStorage.removeItem('rkmidigi_admin_user');
    window.location.href = '/admin/login?logged_out=1';
  }

  const logoutBtn = document.getElementById('logout-btn');
  const modalLogoutBtn = document.getElementById('modal-logout-btn');
  if (logoutBtn) logoutBtn.addEventListener('click', handleLogout);
  if (modalLogoutBtn) modalLogoutBtn.addEventListener('click', handleLogout);

  // Profile modal toggle
  const profileBtn = document.getElementById('profile-btn');
  const profileModal = document.getElementById('profile-modal');
  const closeProfileBtn = document.getElementById('close-profile-btn');
  const modalCloseBtn = document.getElementById('modal-close-btn');

  function openProfile() { if (profileModal) profileModal.classList.remove('hidden'); }
  function closeProfile() { if (profileModal) profileModal.classList.add('hidden'); }

  if (profileBtn) profileBtn.addEventListener('click', openProfile);
  if (closeProfileBtn) closeProfileBtn.addEventListener('click', closeProfile);
  if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeProfile);
  if (profileModal) {
    profileModal.addEventListener('click', (e) => {
      if (e.target === profileModal) closeProfile();
    });
  }
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeProfile();
  });

  let allPosts = [];

  function showToast(message, isError = false) {
    const toast = document.getElementById('status-toast');
    const text = document.getElementById('status-text');
    if (toast && text) {
      text.textContent = message;
      toast.className = `my-4 p-3 rounded-lg border text-xs font-bold flex items-center justify-between ${
        isError ? 'bg-amber-50 border-amber-300 text-amber-900' : 'bg-emerald-50 border-emerald-300 text-emerald-800'
      }`;
      toast.classList.remove('hidden');
      setTimeout(() => { toast.classList.add('hidden'); }, 6000);
    }
  }

  async function fetchPosts() {
    let posts = [...(staticPosts || [])];

    // 1. Load newly created custom posts from localStorage
    try {
      const customPosts = JSON.parse(localStorage.getItem('rkmidigi_custom_posts') || '[]');
      if (Array.isArray(customPosts)) {
        for (const cp of customPosts) {
          if (!posts.some(p => p.slug === cp.slug)) {
            posts.unshift(cp);
          }
        }
      }
    } catch(e) {}

    // 2. Apply any drafted local edits from localStorage
    posts = posts.map(p => {
      try {
        const edited = localStorage.getItem(`rkmidigi_post_edit_${p.slug}`);
        if (edited) {
          return { ...p, ...JSON.parse(edited) };
        }
      } catch(e) {}
      return p;
    });

    // 3. Apply any publish / unpublished toggle states
    try {
      const toggles = JSON.parse(localStorage.getItem('rkmidigi_post_toggles') || '{}');
      posts = posts.map(p => {
        if (typeof toggles[p.slug] === 'boolean') {
          return { ...p, published: toggles[p.slug] };
        }
        return p;
      });
    } catch(e) {}

    // 4. Filter out any locally deleted posts
    try {
      const deletedSlugs = JSON.parse(localStorage.getItem('rkmidigi_deleted_posts') || '[]');
      if (Array.isArray(deletedSlugs)) {
        posts = posts.filter(p => !deletedSlugs.includes(p.slug));
      }
    } catch(e) {}

    // 5. Query Supabase posts table if available
    try {
      const { data: sbPosts, error } = await supabase.from('posts').select('*');
      if (!error && Array.isArray(sbPosts) && sbPosts.length > 0) {
        for (const sp of sbPosts) {
          const mapped = {
            slug: sp.slug,
            title: sp.title,
            category: sp.category,
            date: sp.date,
            readTime: sp.read_time,
            featured: sp.featured,
            published: sp.published,
            youtubeUrl: sp.youtube_url,
            image: sp.image,
            summary: sp.summary,
            tags: Array.isArray(sp.tags) ? sp.tags : [],
            body: sp.body,
            author: sp.author
          };
          const idx = posts.findIndex(p => p.slug === mapped.slug);
          if (idx > -1) {
            posts[idx] = { ...posts[idx], ...mapped };
          } else {
            posts.unshift(mapped);
          }
        }
      }
    } catch(e) {}

    // 6. If local Node API is active on localhost:4322, sync from disk
    if (isLocal) {
      try {
        const res = await fetch(`${API_BASE}/api/admin/posts`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (res.ok) {
          const data = await res.json();
          if (data.success && Array.isArray(data.posts) && data.posts.length > 0) {
            posts = data.posts;
          }
        }
      } catch (err) {}
    }

    allPosts = posts;
    updateStats(allPosts);
    renderPosts(allPosts);
  }

  function updateStats(posts) {
    const totalEl = document.getElementById('stat-total');
    const publishedEl = document.getElementById('stat-published');
    const draftsEl = document.getElementById('stat-drafts');
    const videosEl = document.getElementById('stat-videos');

    if (totalEl) totalEl.textContent = posts.length.toString();
    if (publishedEl) publishedEl.textContent = posts.filter(p => p.published !== false).length.toString();
    if (draftsEl) draftsEl.textContent = posts.filter(p => p.published === false).length.toString();
    if (videosEl) videosEl.textContent = posts.filter(p => !!p.youtubeUrl).length.toString();
  }

  function renderPosts(posts) {
    const tbody = document.getElementById('posts-table-body');
    if (!tbody) return;

    if (posts.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="6" class="py-12 text-center text-slate-500">
            <p class="text-sm font-bold text-slate-700">No blog posts found.</p>
            <p class="text-xs text-slate-400 mt-1">Click "+ New Post / Video" above to create your first article.</p>
          </td>
        </tr>
      `;
      return;
    }

    tbody.innerHTML = posts.map(post => {
      const hasVideo = !!post.youtubeUrl;
      const isFeatured = post.featured;
      const isPublished = post.published !== false;

      return `
        <tr class="hover:bg-slate-50/80 transition-colors">
          <td class="py-3.5 px-4">
            <div class="flex items-center gap-2.5">
              ${isFeatured ? `<span class="px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800 text-[10px] font-bold uppercase tracking-wider">FEATURED</span>` : ''}
              ${!isPublished ? `<span class="px-1.5 py-0.5 rounded bg-amber-100 text-amber-900 text-[10px] font-bold uppercase tracking-wider">DRAFT</span>` : ''}
              <a href="/admin/edit?slug=${encodeURIComponent(post.slug)}" class="font-bold text-black hover:text-[#16A34A] transition-colors leading-snug">
                ${post.title}
              </a>
            </div>
            <div class="text-[11px] text-slate-500 font-mono mt-1">
              Slug: /blog/${post.slug} • ${post.readTime || '4 min read'}
            </div>
          </td>

          <td class="py-3.5 px-4 whitespace-nowrap">
            <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-slate-100 text-slate-800 border border-slate-300">
              ${post.category}
            </span>
          </td>

          <td class="py-3.5 px-4 whitespace-nowrap text-slate-600 font-mono text-xs">
            ${post.date || 'N/A'}
          </td>

          <td class="py-3.5 px-4 whitespace-nowrap">
            ${hasVideo ? `
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-bold bg-red-100 text-red-700 border border-red-200">
                <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                VIDEO
              </span>
            ` : `
              <span class="text-[11px] text-slate-400 font-mono">Article Only</span>
            `}
          </td>

          <!-- Single Publish / Unpublish Toggle Button -->
          <td class="py-3.5 px-4 whitespace-nowrap">
            <button 
              type="button" 
              onclick="togglePublishPost('${post.slug}', this)"
              id="pub-btn-${post.slug}"
              class="publish-toggle-btn inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold transition-all cursor-pointer shadow-xs ${
                isPublished 
                  ? 'bg-emerald-100 text-emerald-800 border border-emerald-300 hover:bg-amber-100 hover:text-amber-900 hover:border-amber-300' 
                  : 'bg-amber-100 text-amber-900 border border-amber-300 hover:bg-emerald-100 hover:text-emerald-800 hover:border-emerald-300'
              }"
              title="${isPublished ? 'Status: Published. Click to Unpublish (set to Draft)' : 'Status: Unpublished. Click to Publish (make Live)'}"
            >
              <span class="w-2 h-2 rounded-full ${isPublished ? 'bg-emerald-500' : 'bg-amber-500'}"></span>
              <span class="btn-label">${isPublished ? 'Published' : 'Unpublished'}</span>
            </button>
          </td>

          <td class="py-3.5 px-4 text-right whitespace-nowrap space-x-2">
            <button 
              type="button" 
              onclick="openSocialPushModal('${post.slug}')"
              class="inline-block px-2.5 py-1 rounded bg-[#112649] hover:bg-[#1d3d75] text-white font-bold text-xs transition-colors shadow-xs"
              title="Broadcast & Push to Social Media"
            >
              🚀 Push
            </button>
            <a 
              href="/admin/edit?slug=${encodeURIComponent(post.slug)}" 
              class="inline-block px-2.5 py-1 rounded bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs transition-colors"
            >
              Edit
            </a>
            <a 
              href="/blog/${post.slug}/" 
              target="_blank" 
              class="inline-block px-2.5 py-1 rounded bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs transition-colors"
            >
              View ↗
            </a>
            <button 
              type="button" 
              onclick="deletePost('${post.slug}', '${post.title.replace(/'/g, "\\'")}')"
