  // Delete post
  (window as any).deletePost = async (slug: string, title: string) => {
    if (!confirm(`Are you sure you want to remove the post "${title}" from the active post store?`)) {
      return;
    }

    // Persist removal in localStorage
    try {
      const deletedSlugs = JSON.parse(localStorage.getItem('rkmidigi_deleted_posts') || '[]');
      if (!deletedSlugs.includes(slug)) {
        deletedSlugs.push(slug);
        localStorage.setItem('rkmidigi_deleted_posts', JSON.stringify(deletedSlugs));
      }
      const customPosts = JSON.parse(localStorage.getItem('rkmidigi_custom_posts') || '[]');
      const filtered = customPosts.filter((p: any) => p.slug !== slug);
      localStorage.setItem('rkmidigi_custom_posts', JSON.stringify(filtered));
    } catch(e) {}

    // Broadcast deletion
    try {
      const bc = new BroadcastChannel('rkmidigi_blog_channel');
      bc.postMessage({ type: 'POST_DELETED', slug, timestamp: Date.now() });
    } catch(e) {}

    // Delete in Supabase if exists
    try {
      await supabase.from('posts').delete().eq('slug', slug);
    } catch(e) {}

    // If local server running, delete local markdown file
    if (isLocal) {
      try {
        await fetch(`${API_BASE}/api/admin/posts/${slug}`, {
          method: 'DELETE',
          headers: { 'Authorization': `Bearer ${token}` }
        });
      } catch (err) {}
    }

    // Immediately remove from in-memory allPosts and re-render
    allPosts = allPosts.filter(p => p.slug !== slug);
    updateStats(allPosts);
    renderPosts(allPosts);
    showToast(`🗑️ Post "${title}" was removed.`);
  };

