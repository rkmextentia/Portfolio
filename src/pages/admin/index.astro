  // ==========================================
  // ACADEMY COURSES & VIDEO LESSONS (SUPABASE)
  // ==========================================
  let activeCourses = [];

  function getCustomCourses() {
    try {
      const saved = localStorage.getItem('rkmidigi_custom_courses');
      if (saved) {
        const parsed = JSON.parse(saved);
        if (Array.isArray(parsed) && parsed.length > 0) return parsed;
      }
    } catch (e) {}
    return staticCourses || [];
  }

  function saveCustomCourses(courses) {
    try {
      localStorage.setItem('rkmidigi_custom_courses', JSON.stringify(courses));
    } catch (e) {}
  }

  async function fetchCoursesFromSupabase() {
    try {
      const { data, error } = await supabase
        .from('courses')
        .select('*, lessons(*)')
        .order('price_inr', { ascending: false });

      if (!error && Array.isArray(data) && data.length > 0) {
        activeCourses = data.map(c => ({
          id: c.id,
          slug: c.slug,
          title: c.title,
          subtitle: c.subtitle || '',
          summary: c.summary || '',
          description: c.description || '',
          category: c.category || 'AI Governance',
          level: c.level || 'Practitioner',
          priceInr: Number(c.price_inr || 4999),
          originalPriceInr: Number(c.original_price_inr || 14999),
          durationHours: c.duration_hours || '6 Hours',
          totalLessons: (c.lessons || []).length || c.total_lessons || 8,
          thumbnailUrl: c.thumbnail_url || '/images/rkmidigilabs-logo.jpg',
          featured: !!c.featured,
          lessons: (c.lessons || []).sort((a, b) => (a.order_index || 0) - (b.order_index || 0)).map(l => ({
            id: l.id,
            orderIndex: l.order_index,
            title: l.title,
            duration: l.duration,
            description: l.description || '',
            videoUrl: l.video_url,
            isFreePreview: !!l.is_free_preview
          }))
        }));
        return activeCourses;
      }
    } catch (err) {
      console.warn('Could not query Supabase courses:', err);
    }

    activeCourses = getCustomCourses();
    return activeCourses;
  }

