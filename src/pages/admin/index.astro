  async function openTemplateViewer(inqId) {
    if (!templateViewerModal || !templateViewerContent) return;
    if (templateViewerRef) templateViewerRef.textContent = inqId;
    templateViewerContent.innerHTML = '<div class="p-8 text-center text-xs text-slate-500">Loading formatted email template...</div>';
    templateViewerModal.classList.remove('hidden');

    try {
      const res = await fetch(`${API_BASE}/api/admin/inquiries/${inqId}`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      const data = await res.json();
      if (data.success && data.html) {
        templateViewerContent.innerHTML = data.html;
      } else {
        templateViewerContent.innerHTML = `<div class="p-8 text-center text-xs text-red-500">${data.error || 'Failed to load template.'}</div>`;
      }
    } catch (e) {
      templateViewerContent.innerHTML = '<div class="p-8 text-center text-xs text-red-500">Error loading email template archive.</div>';
    }
  }

