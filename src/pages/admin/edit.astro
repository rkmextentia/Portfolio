<script>
  import { supabase } from '../../lib/supabase';
  import { idbSavePost, idbGetPost } from '../../lib/idb';
  import { compressImageFile } from '../../lib/image-compress';

  const API_PORT = 4322;
  const isLocal = ['localhost', '127.0.0.1', '::1'].includes(window.location.hostname) || 
                  window.location.hostname.startsWith('192.168.') || 
                  window.location.hostname.startsWith('10.') || 
                  window.location.hostname.endsWith('.local');
  const API_BASE = isLocal 
    ? `${window.location.protocol}//${window.location.hostname}:${API_PORT}` 
    : window.location.origin;

  const token = sessionStorage.getItem('rkmidigi_admin_token');
  const expires = parseInt(sessionStorage.getItem('rkmidigi_admin_expires') || '0', 10);
  if (!token || Date.now() > expires) {
    sessionStorage.removeItem('rkmidigi_admin_token');
    sessionStorage.removeItem('rkmidigi_admin_user');
    sessionStorage.removeItem('rkmidigi_admin_expires');
    window.location.replace('/admin/login?auth_prompt=1');
  }

  // Logout
  function handleLogout() {
    localStorage.removeItem('rkmidigi_admin_token');
    localStorage.removeItem('rkmidigi_admin_user');
    sessionStorage.removeItem('rkmidigi_admin_token');
    sessionStorage.removeItem('rkmidigi_admin_user');
    sessionStorage.removeItem('rkmidigi_admin_expires');
    window.location.href = '/admin/login?logged_out=1';
  }

  const logoutBtn = document.getElementById('logout-btn');
  const modalLogoutBtn = document.getElementById('modal-logout-btn');
  if (logoutBtn) logoutBtn.addEventListener('click', handleLogout);
  if (modalLogoutBtn) modalLogoutBtn.addEventListener('click', handleLogout);

  // Profile modal toggle
  const profileBtn = document.getElementById('profile-btn');
  const profileModal = document.getElementById('profile-modal');
  const closeProfileBtn = document.getElementById('close-profile-btn');
  const modalCloseBtn = document.getElementById('modal-close-btn');

  function openProfile() { if (profileModal) profileModal.classList.remove('hidden'); }
  function closeProfile() { if (profileModal) profileModal.classList.add('hidden'); }

  if (profileBtn) profileBtn.addEventListener('click', openProfile);
  if (closeProfileBtn) closeProfileBtn.addEventListener('click', closeProfile);
  if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeProfile);
  if (profileModal) {
    profileModal.addEventListener('click', (e) => {
      if (e.target === profileModal) closeProfile();
    });
  }
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeProfile();
  });

  const urlParams = new URLSearchParams(window.location.search);
  const slug = urlParams.get('slug');

  if (!slug) {
    alert('No article slug provided.');
    window.location.href = '/admin';
  }

  // Header and slug elements
  const headerSlug = document.getElementById('header-slug');
  const slugText = document.getElementById('slug-text');
  const liveLink = document.getElementById('live-link') as HTMLAnchorElement;
  if (headerSlug) headerSlug.textContent = slug || '';
  if (slugText) slugText.textContent = slug || '';
  if (liveLink) liveLink.href = `/blog/${slug}`;

  // Form Elements
  const loadingBox = document.getElementById('loading-box');
  const editorContainer = document.getElementById('editor-container');

  const titleInput = document.getElementById('post-title') as HTMLInputElement;
  const catSelect = document.getElementById('post-category') as HTMLSelectElement;
  const readTimeInput = document.getElementById('post-readtime') as HTMLInputElement;
  const featuredInput = document.getElementById('post-featured') as HTMLInputElement;
  const videoInput = document.getElementById('post-video') as HTMLInputElement;
  const postImage = document.getElementById('post-image') as HTMLInputElement;
  const imageFileInput = document.getElementById('image-file-input') as HTMLInputElement;
  const uploadImageBtn = document.getElementById('upload-image-btn') as HTMLButtonElement;
  const imagePreviewBox = document.getElementById('image-preview-box');
  const imagePreviewThumb = document.getElementById('image-preview-thumb') as HTMLImageElement;
  const imagePreviewName = document.getElementById('image-preview-name');
  const imagePreviewUrl = document.getElementById('image-preview-url');
  const setAsCoverBtn = document.getElementById('set-as-cover-btn');
  const summaryInput = document.getElementById('post-summary') as HTMLTextAreaElement;
  const tagsInput = document.getElementById('post-tags') as HTMLInputElement;
  const bodyInput = document.getElementById('post-body') as HTMLTextAreaElement;

  const videoPreviewBox = document.getElementById('video-preview-box');
  const videoIframe = document.getElementById('video-iframe') as HTMLIFrameElement;
  const summaryCounter = document.getElementById('summary-counter');

  // Preview elements
  const prevTitle = document.getElementById('prev-title');
  const prevCategory = document.getElementById('prev-category');
  const prevReadTime = document.getElementById('prev-readtime');
  const prevSummary = document.getElementById('prev-summary');
  const prevVideoBox = document.getElementById('prev-video-box');
  const prevThumbImg = document.getElementById('prev-thumb-img') as HTMLImageElement;
  const prevBadgeVideo = document.getElementById('prev-badge-video');
  const prevTagsContainer = document.getElementById('prev-tags-container');

  const toast = document.getElementById('editor-toast');
  const toastText = document.getElementById('toast-text');
  const saveBtn = document.getElementById('save-btn');
  const deleteBtn = document.getElementById('delete-btn');
  const downloadBtn = document.getElementById('download-md-btn');
  const togglePublishBtn = document.getElementById('toggle-publish-btn');

  let postDate = '';
  let currentPublished = true;

  function renderPublishButton() {
    if (!togglePublishBtn) return;
    togglePublishBtn.className = `px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 shadow-xs cursor-pointer ${
      currentPublished 
        ? 'bg-emerald-100 text-emerald-800 border border-emerald-300 hover:bg-amber-100 hover:text-amber-900 hover:border-amber-300' 
        : 'bg-amber-100 text-amber-900 border border-amber-300 hover:bg-emerald-100 hover:text-emerald-800 hover:border-emerald-300'
    }`;
    togglePublishBtn.title = currentPublished 
      ? 'Status: Published. Click to Unpublish (set to Draft)' 
      : 'Status: Unpublished. Click to Publish (make Live)';
    togglePublishBtn.innerHTML = `
      <span class="w-2 h-2 rounded-full ${currentPublished ? 'bg-emerald-500' : 'bg-amber-500'}"></span>
      <span>${currentPublished ? 'Published' : 'Unpublished'}</span>
    `;
  }

  if (togglePublishBtn) {
    togglePublishBtn.addEventListener('click', async () => {
      togglePublishBtn.classList.add('opacity-50', 'pointer-events-none');
      currentPublished = !currentPublished;
      renderPublishButton();

      // Broadcast and cache in localStorage
      try {
        const bc = new BroadcastChannel('rkmidigi_blog_channel');
        bc.postMessage({ type: 'POST_PUBLISH_TOGGLED', slug, published: currentPublished, timestamp: Date.now() });
      } catch(e) {}
      try {
        localStorage.setItem('rkmidigi_post_toggle', JSON.stringify({ slug, published: currentPublished, timestamp: Date.now() }));
      } catch(e) {}

      // If running locally, also attempt local API update
      if (isLocal) {
        try {
          await fetch(`${API_BASE}/api/admin/posts/${slug}/toggle-publish`, {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${token}` }
          });
        } catch (err) {}
      }

      showToast(currentPublished ? 'Post status: Published!' : 'Post status: Unpublished (Draft)!');
      togglePublishBtn.classList.remove('opacity-50', 'pointer-events-none');
    });
  }

  function showToast(msg: string, isError = false) {
    if (toast && toastText) {
      toastText.textContent = msg;
      toast.className = `my-4 p-3 rounded-lg border text-xs font-bold flex items-center justify-between ${
        isError ? 'bg-red-50 border-red-300 text-red-800' : 'bg-emerald-50 border-emerald-300 text-emerald-800'
      }`;
      toast.classList.remove('hidden');
      setTimeout(() => { toast.classList.add('hidden'); }, 6000);
    }
  }

  function extractYouTubeId(url: string): string | null {
    if (!url) return null;
    let cleanUrl = url.trim();
    const iframeSrc = cleanUrl.match(/src=["']([^"']+)["']/i);
    if (iframeSrc && iframeSrc[1]) cleanUrl = iframeSrc[1];

    const patterns = [
      /(?:youtu\.be\/|youtube(?:-nocookie)?\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=|shorts\/|live\/))([a-zA-Z0-9_-]{11})/i,
      /[?&]v=([a-zA-Z0-9_-]{11})/i,
      /^([a-zA-Z0-9_-]{11})$/
    ];

    for (const pattern of patterns) {
      const match = cleanUrl.match(pattern);
      if (match && match[1]) return match[1];
    }
    return null;
  }

  function updateCoverPreview() {
    const ytid = videoInput ? extractYouTubeId(videoInput.value.trim()) : null;
    const imgUrl = postImage ? postImage.value.trim() : '';

    if (ytid) {
      if (videoPreviewBox && videoIframe) {
        videoIframe.src = `https://www.youtube-nocookie.com/embed/${ytid}`;
        videoPreviewBox.classList.remove('hidden');
      }
      if (prevVideoBox && prevThumbImg) {
        prevThumbImg.src = `https://img.youtube.com/vi/${ytid}/hqdefault.jpg`;
        prevVideoBox.classList.remove('hidden');
      }
      if (prevBadgeVideo) prevBadgeVideo.classList.remove('hidden');
    } else {
      if (videoPreviewBox) videoPreviewBox.classList.add('hidden');
      if (imgUrl) {
        if (prevVideoBox && prevThumbImg) {
          prevThumbImg.src = imgUrl;
          prevVideoBox.classList.remove('hidden');
        }
        if (prevBadgeVideo) prevBadgeVideo.classList.add('hidden');
      } else {
        if (prevVideoBox) prevVideoBox.classList.add('hidden');
      }
    }
  }

  function populateEditor(p: any) {
    postDate = p.date || '';

    titleInput.value = p.title || '';
    if (prevTitle) prevTitle.textContent = p.title || '';

    catSelect.value = p.category || 'AI Governance';
    if (prevCategory) prevCategory.textContent = catSelect.value;

    readTimeInput.value = p.readTime || '4 min read';
    if (prevReadTime) prevReadTime.textContent = readTimeInput.value;

    featuredInput.checked = p.featured === true || p.featured === 'true';

    videoInput.value = p.youtubeUrl || '';
    postImage.value = p.image || '';

    if (p.image && imagePreviewBox && imagePreviewThumb && imagePreviewName && imagePreviewUrl) {
      imagePreviewThumb.src = p.image;
      imagePreviewName.textContent = p.image.split('/').pop() || 'diagram';
      imagePreviewUrl.textContent = p.image;
      imagePreviewBox.classList.remove('hidden');
    }

    updateCoverPreview();

    summaryInput.value = p.summary || '';
    if (prevSummary) prevSummary.textContent = p.summary || '';
    if (summaryCounter) summaryCounter.textContent = `${summaryInput.value.length} / 220 chars`;

    const tags = Array.isArray(p.tags) ? p.tags : [];
    tagsInput.value = tags.join(', ');
    if (prevTagsContainer) {
      prevTagsContainer.innerHTML = tags.map((t: string) => `
        <span class="text-[10px] bg-slate-100 text-slate-700 px-2 py-0.5 rounded border border-slate-200">#${t}</span>
      `).join('');
    }

    bodyInput.value = p.body || '';
    currentPublished = p.published !== false && p.published !== 'false';
    renderPublishButton();
    updateSocialCopy(true);

    if (loadingBox) loadingBox.classList.add('hidden');
    if (editorContainer) editorContainer.classList.remove('hidden');
  }

  async function loadPost() {
    let post: any = null;

    // Tier 1: Look in static posts bundled at build time from content/blog/
    try {
      const staticEl = document.getElementById('admin-static-posts');
      if (staticEl && staticEl.textContent) {
        const posts = JSON.parse(staticEl.textContent);
        post = posts.find((item: any) => item.slug === slug);
      }
    } catch (e) {}

    // Tier 2: Check for custom posts list & locally drafted edits in localStorage
    try {
      const customPosts = JSON.parse(localStorage.getItem('rkmidigi_custom_posts') || '[]');
      const cp = customPosts.find((p: any) => p.slug === slug);
      if (cp) {
        post = { ...(post || {}), ...cp };
      }

      const cached = localStorage.getItem(`rkmidigi_post_edit_${slug}`);
      if (cached) {
        const parsed = JSON.parse(cached);
        post = { ...(post || {}), ...parsed };
      }

      const toggle = localStorage.getItem('rkmidigi_post_toggle');
      if (toggle) {
        const t = JSON.parse(toggle);
        if (t.slug === slug && typeof t.published === 'boolean') {
          if (post) post.published = t.published;
        }
      }
    } catch (e) {}

    // Tier 2.5: Check IndexedDB (unlimited persistent storage)
    if (!post || !post.body) {
      try {
        const idbPost = await idbGetPost(slug);
        if (idbPost) {
          post = { ...(post || {}), ...idbPost };
        }
      } catch(e) {}
    }

    // Tier 3: Supabase cloud fetch if not yet loaded
    if (!post || !post.body) {
      try {
        const sbPromise = supabase.from('posts').select('*').eq('slug', slug).maybeSingle();
        const timeoutPromise = new Promise(resolve => setTimeout(resolve, 1500));
        const res: any = await Promise.race([sbPromise, timeoutPromise]);
        if (res && res.data) {
          const sp = res.data;
          post = {
            slug: sp.slug,
            title: sp.title,
            category: sp.category,
            date: sp.date,
            readTime: sp.read_time,
            featured: sp.featured,
            published: sp.published,
            youtubeUrl: sp.youtube_url,
            image: sp.image,
            summary: sp.summary,
            tags: Array.isArray(sp.tags) ? sp.tags : [],
            body: sp.body,
            author: sp.author || 'RKMIDIGILABS'
          };
        }
      } catch(e) {}
    }

    // Tier 4: If running locally with Node server, fetch live disk version
    if (isLocal) {
      try {
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 1500);
        const res = await fetch(`${API_BASE}/api/admin/posts/${slug}`, {
          headers: { 'Authorization': `Bearer ${token}` },
          signal: controller.signal
        });
        clearTimeout(timeoutId);
        if (res.ok) {
          const data = await res.json();
          if (data.success && data.post) {
            post = data.post;
          }
        }
      } catch (err) {}
    }

    if (post) {
      populateEditor(post);
    } else {
      if (loadingBox) {
        loadingBox.innerHTML = `
          <div class="py-8 text-center">
            <p class="text-red-600 font-bold mb-2">Article not found: <span class="font-mono">${slug}</span></p>
            <p class="text-xs text-slate-500 mb-4">Please verify the article slug or create a new article in Admin Studio.</p>
            <a href="/admin" class="text-xs font-bold text-[#16A34A] underline hover:text-[#15803D]">← Return to Admin Studio</a>
          </div>
        `;
      }
    }
  }

  // Event Listeners for live sync
  if (titleInput) {
    titleInput.addEventListener('input', () => {
      if (prevTitle) prevTitle.textContent = titleInput.value || 'Article Title';
    });
  }
  if (catSelect) {
    catSelect.addEventListener('change', () => {
      if (prevCategory) prevCategory.textContent = catSelect.value;
    });
  }
  if (readTimeInput) {
    readTimeInput.addEventListener('input', () => {
      if (prevReadTime) prevReadTime.textContent = readTimeInput.value;
    });
  }
  if (summaryInput) {
    summaryInput.addEventListener('input', () => {
      if (summaryCounter) summaryCounter.textContent = `${summaryInput.value.length} / 220 chars`;
      if (prevSummary) prevSummary.textContent = summaryInput.value;
    });
  }
  if (tagsInput) {
    tagsInput.addEventListener('input', () => {
      const tags = tagsInput.value.split(',').map(t => t.trim()).filter(Boolean);
      if (prevTagsContainer) {
        prevTagsContainer.innerHTML = tags.map(t => `
          <span class="text-[10px] bg-slate-100 text-slate-700 px-2 py-0.5 rounded border border-slate-200">#${t}</span>
        `).join('');
      }
    });
  }
  ['input', 'change', 'paste', 'blur'].forEach(evt => {
    videoInput?.addEventListener(evt, () => setTimeout(updateCoverPreview, 50));
    postImage?.addEventListener(evt, () => setTimeout(updateCoverPreview, 50));
  });

  // Image upload handling (Universal Browser & Cloud Support)
  if (uploadImageBtn && imageFileInput) {
    uploadImageBtn.addEventListener('click', async () => {
      const file = imageFileInput.files?.[0];
      if (!file) {
        alert('Please choose an image file first (PNG, JPG, WebP, GIF).');
        return;
      }

      uploadImageBtn.setAttribute('disabled', 'true');
      uploadImageBtn.innerHTML = `<span>Optimizing & Uploading...</span>`;

      try {
        // Automatically optimize image (max 1280px width, 82% quality) to ensure lightweight payload (< 120KB)
        const fileData = await compressImageFile(file);
        let uploadedUrl = fileData; // Guaranteed fallback (Data URL)

        // 1. Try Supabase storage if available
        try {
          const fileExt = file.name.split('.').pop() || 'png';
          const fileName = `${Date.now()}_${Math.random().toString(36).substring(2, 8)}.${fileExt}`;
          const filePath = `articles/${fileName}`;

          const { data, error } = await supabase.storage
            .from('blog-images')
            .upload(filePath, file, { cacheControl: '3600', upsert: true });

          if (!error && data) {
            const { data: publicData } = supabase.storage.from('blog-images').getPublicUrl(filePath);
            if (publicData?.publicUrl) {
              uploadedUrl = publicData.publicUrl;
            }
          }
        } catch (storageErr) {}

        // 2. If running locally, also sync with local filesystem
        if (isLocal) {
          try {
            const res = await fetch(`${API_BASE}/api/admin/upload`, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
              },
              body: JSON.stringify({ fileName: file.name, fileData })
            });
            if (res.ok) {
              const localRes = await res.json();
              if (localRes.url && !uploadedUrl.startsWith('http')) {
                uploadedUrl = localRes.url;
              }
            }
          } catch(e) {}
        }

        // 3. Update preview and inputs immediately
        if (imagePreviewBox && imagePreviewThumb && imagePreviewName && imagePreviewUrl) {
          imagePreviewThumb.src = uploadedUrl;
          imagePreviewName.textContent = file.name;
          imagePreviewUrl.textContent = uploadedUrl.startsWith('data:') ? `Optimized Image (${Math.round(uploadedUrl.length / 1024)} KB)` : uploadedUrl;
          imagePreviewBox.classList.remove('hidden');
        }

        if (postImage) {
          postImage.value = uploadedUrl;
          updateCoverPreview();
        }

        // 4. Insert Markdown snippet into post body at cursor
        if (bodyInput) {
          const snippet = `\n![${file.name}](${uploadedUrl})\n`;
          const start = bodyInput.selectionStart || 0;
          const end = bodyInput.selectionEnd || 0;
          const text = bodyInput.value;
          bodyInput.value = text.substring(0, start) + snippet + text.substring(end);
          bodyInput.focus();
          bodyInput.selectionStart = bodyInput.selectionEnd = start + snippet.length;
        }

        showToast(`✅ Image uploaded and inserted into article!`);
      } catch (err) {
        showToast('Failed to process image file.', true);
      } finally {
        uploadImageBtn.removeAttribute('disabled');
        uploadImageBtn.innerHTML = `<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg><span>Upload & Insert</span>`;
      }
    });
  }

  if (setAsCoverBtn) {
    setAsCoverBtn.addEventListener('click', () => {
      if (imagePreviewThumb && postImage) {
        postImage.value = imagePreviewThumb.src || '';
        updateCoverPreview();
        showToast('✅ Set as cover image!');
      }
    });
  }

  // Toolbar insertion helper
  (window as any).insertMd = (prefix: string, suffix: string) => {
    if (!bodyInput) return;
    const start = bodyInput.selectionStart;
    const end = bodyInput.selectionEnd;
    const text = bodyInput.value;
    const selected = text.substring(start, end);
    const replacement = prefix + selected + suffix;
    bodyInput.value = text.substring(0, start) + replacement + text.substring(end);
    bodyInput.focus();
    bodyInput.selectionStart = start + prefix.length;
    bodyInput.selectionEnd = start + prefix.length + selected.length;
  };

  // Download raw markdown file
  if (downloadBtn) {
    downloadBtn.addEventListener('click', () => {
      const title = titleInput.value.trim() || 'untitled-post';
      const category = catSelect.value;
      const readTime = readTimeInput.value || '4 min read';
      const featured = featuredInput.checked;
      const video = videoInput.value.trim();
      const image = postImage ? postImage.value.trim() : '';
      const summary = summaryInput.value.trim();
      const tags = tagsInput.value.split(',').map(t => t.trim()).filter(Boolean);
      const body = bodyInput.value;

      let md = '---\n';
      md += `title: "${title.replace(/"/g, '\\"')}"\n`;
      md += `date: ${postDate || new Date().toISOString().split('T')[0]}\n`;
      md += `category: "${category}"\n`;
      md += `tags: ${JSON.stringify(tags)}\n`;
      if (video) md += `youtubeUrl: "${video}"\n`;
      if (image) md += `image: "${image}"\n`;
      md += `summary: "${summary.replace(/"/g, '\\"')}"\n`;
      md += `featured: ${featured}\n`;
      md += `published: ${currentPublished}\n`;
      md += `readTime: "${readTime}"\n`;
      md += `author: "RKMIDIGILABS"\n`;
      md += '---\n\n';
      md += body;

      const blob = new Blob([md], { type: 'text/markdown' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `${slug}.md`;
      a.click();
    });
  }

  // --- Social Media Studio Logic ---
  const socialCopyArea = document.getElementById('social-custom-copy') as HTMLTextAreaElement;
  const refreshSocialCopyBtn = document.getElementById('refresh-social-copy-btn');
  const socialCharCount = document.getElementById('social-char-count');
  const autoWebhookPush = document.getElementById('auto-webhook-push') as HTMLInputElement;

  function generateDefaultSocialCopy() {
    const title = titleInput?.value.trim() || 'Analysis Update';
    const summary = summaryInput?.value.trim() || '';
    const brochureUrl = `${window.location.origin}/company-profile`;
    const postUrl = `${window.location.origin}/blog/${slug}`;
    const rawTags = tagsInput?.value.split(',').map(t => t.trim()).filter(Boolean) || [];
    const hashtags = (rawTags.length ? rawTags.map(t => '#' + t.replace(/\s+/g, '')) : ['#AIGovernance', '#RKMIDIGILABS']).join(' ');

    return `📢 ${title}\n\n${summary ? summary + '\n\n' : ''}📖 Article Analysis: ${postUrl}\n🏢 Company Profile & Corporate Brochure: ${brochureUrl}\n\n${hashtags}`;
  }

  function updateSocialCopy(manual = false) {
    if (!socialCopyArea) return;
    if (!manual && socialCopyArea.dataset.manualEdited === 'true') return;
    const copy = generateDefaultSocialCopy();
    socialCopyArea.value = copy;
    if (socialCharCount) socialCharCount.textContent = `${copy.length} chars`;
  }

  socialCopyArea?.addEventListener('input', () => {
    socialCopyArea.dataset.manualEdited = 'true';
    if (socialCharCount) socialCharCount.textContent = `${socialCopyArea.value.length} chars`;
  });

  refreshSocialCopyBtn?.addEventListener('click', () => {
    if (socialCopyArea) socialCopyArea.dataset.manualEdited = 'false';
    updateSocialCopy(true);
    showToast('Refreshed social post copy!');
  });

  titleInput?.addEventListener('input', () => updateSocialCopy());
  summaryInput?.addEventListener('input', () => updateSocialCopy());
  tagsInput?.addEventListener('input', () => updateSocialCopy());

  // Launch buttons
  document.getElementById('launch-linkedin-btn')?.addEventListener('click', () => {
    const url = `${window.location.origin}/blog/${slug}`;
    window.open(`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`, '_blank', 'width=600,height=600');
  });

  document.getElementById('launch-twitter-btn')?.addEventListener('click', () => {
    const text = socialCopyArea?.value || generateDefaultSocialCopy();
    window.open(`https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}`, '_blank', 'width=600,height=600');
  });

  document.getElementById('launch-whatsapp-btn')?.addEventListener('click', () => {
    const text = socialCopyArea?.value || generateDefaultSocialCopy();
    window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(text)}`, '_blank', 'width=800,height=700');
  });

  document.getElementById('launch-facebook-btn')?.addEventListener('click', () => {
    const url = `${window.location.origin}/blog/${slug}`;
    window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`, '_blank', 'width=600,height=600');
  });

  document.getElementById('launch-all-social-btn')?.addEventListener('click', () => {
    const text = socialCopyArea?.value || generateDefaultSocialCopy();
    const url = `${window.location.origin}/blog/${slug}`;

    window.open(`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`, '_blank');
    window.open(`https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}`, '_blank');
    window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(text)}`, '_blank');
    window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`, '_blank');
    showToast('Launched LinkedIn, X, WhatsApp, and Facebook share windows!');
  });

  // Save changes
  if (saveBtn) {
    saveBtn.addEventListener('click', async () => {
      const title = titleInput.value.trim();
      if (!title) {
        alert('Article Title is required.');
        titleInput.focus();
        return;
      }

      const category = catSelect.value;
      const readTime = readTimeInput.value || '4 min read';
      const featured = featuredInput.checked;
      const youtubeUrl = videoInput.value.trim();
      const image = postImage ? postImage.value.trim() : '';
      const summary = summaryInput.value.trim();
      const tags = tagsInput.value.split(',').map(t => t.trim()).filter(Boolean);
      const body = bodyInput.value;

      saveBtn.setAttribute('disabled', 'true');
      saveBtn.innerHTML = `<span>Saving Changes...</span>`;

      try {
        const postData = {
          title,
          slug,
          date: postDate || new Date().toISOString().split('T')[0],
          category,
          readTime,
          featured,
          youtubeUrl,
          image,
          summary,
          tags,
          published: currentPublished,
          body,
          author: 'RKMIDIGILABS'
        };

        // 1. Persistent storage in IndexedDB (unlimited quota, handles large images & markdown)
        try {
          await idbSavePost(postData);
        } catch (idbErr) {
          console.warn('idbSavePost error:', idbErr);
        }

        // 2. Cache to localStorage instantly (with QuotaExceededError protection)
        try {
          // Update custom posts array if present
          const customPosts = JSON.parse(localStorage.getItem('rkmidigi_custom_posts') || '[]');
          const cpIdx = customPosts.findIndex((p: any) => p.slug === slug);
          if (cpIdx > -1) {
            customPosts[cpIdx] = { ...customPosts[cpIdx], ...postData };
          } else {
            customPosts.unshift(postData);
          }

          try {
            localStorage.setItem('rkmidigi_custom_posts', JSON.stringify(customPosts));
            localStorage.setItem(`rkmidigi_post_edit_${slug}`, JSON.stringify(postData));
          } catch (quotaErr) {
            console.warn('localStorage quota reached, storing lightweight index in localStorage', quotaErr);
            const lightPosts = customPosts.map((p: any) => ({
              ...p,
              body: p.body && p.body.length > 3000 ? p.body.substring(0, 500) + '\n\n[Content stored in IndexedDB]' : p.body,
              image: p.image && p.image.length > 3000 ? '' : p.image
            }));
            try {
              localStorage.setItem('rkmidigi_custom_posts', JSON.stringify(lightPosts));
            } catch(e2) {}
          }
          localStorage.setItem('rkmidigi_post_update', JSON.stringify({ slug, published: currentPublished, timestamp: Date.now() }));
        } catch(e) {}

        // 2. Broadcast to other open tabs
        try {
          const bc = new BroadcastChannel('rkmidigi_blog_channel');
          bc.postMessage({ type: 'POST_UPDATED', slug, published: currentPublished, timestamp: Date.now() });
        } catch(e) {}

        // 3. Supabase upsert (bounded by 1500ms timeout)
        const supabaseSync = Promise.race([
          supabase.from('posts').upsert({
            slug,
            title,
            category,
            date: postData.date,
            read_time: readTime,
            featured,
            published: currentPublished,
            youtube_url: youtubeUrl || null,
            image: image || null,
            summary,
            tags,
            body,
            author: 'RKMIDIGILABS'
          }),
          new Promise(res => setTimeout(res, 1500))
        ]).catch(() => {});

        // 4. If running locally with Node server, write to file on disk
        const localSync = isLocal ? (async () => {
          try {
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 1500);
            const res = await fetch(`${API_BASE}/api/admin/posts/${slug}`, {
              method: 'PUT',
              headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
              },
              body: JSON.stringify(postData),
              signal: controller.signal
            });
            clearTimeout(timeoutId);
            return await res.json();
          } catch (err) {
            return null;
          }
        })() : Promise.resolve(null);

        await Promise.allSettled([supabaseSync, localSync]);

        showToast(`✅ Changes saved successfully! Available at /blog/${slug}`);
      } catch (err: any) {
        console.error('Save error:', err);
        showToast('⚠️ Changes saved to browser cache.', true);
      } finally {
        saveBtn.removeAttribute('disabled');
        saveBtn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg><span>Save Changes</span>`;
      }
    });
  }

  // Delete
  if (deleteBtn) {
    deleteBtn.addEventListener('click', async () => {
      if (!confirm(`Are you sure you want to remove "${titleInput.value}" from the active post view?`)) {
        return;
      }

      deleteBtn.setAttribute('disabled', 'true');

      try {
        localStorage.setItem(`rkmidigi_post_deleted_${slug}`, 'true');
        const deletedSlugs = JSON.parse(localStorage.getItem('rkmidigi_deleted_posts') || '[]');
        if (!deletedSlugs.includes(slug)) {
          deletedSlugs.push(slug);
          localStorage.setItem('rkmidigi_deleted_posts', JSON.stringify(deletedSlugs));
        }

        const customPosts = JSON.parse(localStorage.getItem('rkmidigi_custom_posts') || '[]');
        const filtered = customPosts.filter((p: any) => p.slug !== slug);
        localStorage.setItem('rkmidigi_custom_posts', JSON.stringify(filtered));

        const bc = new BroadcastChannel('rkmidigi_blog_channel');
        bc.postMessage({ type: 'POST_DELETED', slug, timestamp: Date.now() });

        // Supabase deletion with timeout
        await Promise.race([
          supabase.from('posts').delete().eq('slug', slug),
          new Promise(res => setTimeout(res, 1500))
        ]).catch(() => {});

        if (isLocal) {
          try {
            const controller = new AbortController();
            setTimeout(() => controller.abort(), 1500);
            await fetch(`${API_BASE}/api/admin/posts/${slug}`, {
              method: 'DELETE',
              headers: { 'Authorization': `Bearer ${token}` },
              signal: controller.signal
            });
          } catch (err) {}
        }
      } catch (e) {}

      alert('Post removed.');
      window.location.href = '/admin';
    });
  }

  loadPost();
</script>
</BaseLayout>