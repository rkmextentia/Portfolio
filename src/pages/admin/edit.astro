---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const staticCollection = await getCollection('blog');
const staticPosts = staticCollection.map(p => ({
  slug: p.slug,
  title: p.data.title,
  category: p.data.category,
  date: p.data.date,
  readTime: p.data.readTime,
  summary: p.data.summary,
  featured: p.data.featured ?? false,
  youtubeUrl: p.data.youtubeUrl || '',
  image: p.data.image || '',
  tags: p.data.tags || [],
  published: p.data.published ?? true,
  body: p.body || ''
}));
---

<BaseLayout 
  title="Edit Article — RKMIDIGILABS Studio" 
  description="Edit blog articles and video posts for RKMIDIGILABS."
>
  <script id="admin-static-posts" type="application/json" set:html={JSON.stringify(staticPosts)} />
  <!-- Immediate Pre-Render Route Guard: Forces login prompt if no active unexpired session exists -->
  <script is:inline>
    (function() {
      try {
        const token = sessionStorage.getItem('rkmidigi_admin_token');
        const expires = parseInt(sessionStorage.getItem('rkmidigi_admin_expires') || '0', 10);
        if (!token || Date.now() > expires) {
          sessionStorage.removeItem('rkmidigi_admin_token');
          sessionStorage.removeItem('rkmidigi_admin_user');
          sessionStorage.removeItem('rkmidigi_admin_expires');
          localStorage.removeItem('rkmidigi_admin_token');
          localStorage.removeItem('rkmidigi_admin_user');
          window.location.replace('/admin/login?auth_prompt=1');
        }
      } catch(e) {
        window.location.replace('/admin/login?auth_prompt=1');
      }
    })();
  </script>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Header with Back Link & Action Buttons -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-200">
      <div class="flex items-center gap-3">
        <a 
          href="/admin" 
          class="p-2 rounded-lg text-slate-500 hover:text-black hover:bg-slate-100 transition-colors"
          title="Back to Dashboard"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        </a>
        <div>
          <h1 class="text-xl sm:text-2xl font-black text-black tracking-tight">Edit Article / Video Episode</h1>
          <p class="text-xs text-slate-500 font-mono">Editing: <span id="header-slug" class="text-black font-bold"></span></p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <button 
          type="button" 
          id="delete-btn"
          class="px-3 py-1.5 rounded-lg text-xs font-bold text-red-600 hover:bg-red-50 border border-red-200 transition-colors"
        >
          Delete
        </button>

        <button 
          type="button" 
          id="download-md-btn"
          class="px-3 py-1.5 rounded-lg text-xs font-bold bg-white text-slate-700 hover:bg-slate-100 border border-slate-300 shadow-sm transition-colors flex items-center gap-1.5"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
          <span class="hidden sm:inline">Export .md</span>
        </button>

        <button 
          type="button" 
          id="toggle-publish-btn"
          class="px-3 py-1.5 rounded-lg text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-300 hover:bg-amber-50 hover:text-amber-900 hover:border-amber-300 transition-all flex items-center gap-1.5 shadow-xs cursor-pointer"
          title="Toggle between Published and Unpublished (Draft)"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Published</span>
        </button>

        <button 
          type="button" 
          id="save-btn"
          class="px-4 py-1.5 rounded-lg text-xs font-bold bg-[#16A34A] hover:bg-[#15803D] text-white shadow-md transition-all flex items-center gap-1.5"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span>Save</span>
        </button>

        <!-- Profile Button -->
        <button 
          type="button" 
          id="profile-btn" 
          class="px-3 py-1.5 rounded-lg text-xs font-bold bg-white hover:bg-slate-50 border border-slate-300 shadow-sm transition-colors flex items-center gap-1.5 text-slate-800"
          title="View Administrator Profile & Organization Details"
        >
          <span class="w-5 h-5 rounded-full bg-[#112649] text-white flex items-center justify-center text-[10px] font-black">RK</span>
          <span class="hidden md:inline">Profile</span>
          <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </button>

        <!-- Logout Button -->
        <button 
          type="button" 
          id="logout-btn" 
          class="px-3 py-1.5 rounded-lg text-xs font-bold bg-red-50 hover:bg-red-100 text-red-700 border border-red-200 shadow-sm transition-colors flex items-center gap-1.5"
          title="Sign Out of Admin"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          <span class="hidden sm:inline">Log Out</span>
        </button>
      </div>
    </div>

    <!-- Alert / Toast Banner -->
    <div id="editor-toast" class="hidden my-4 p-3 rounded-lg border text-xs font-bold flex items-center justify-between">
      <span id="toast-text"></span>
      <button type="button" onclick="document.getElementById('editor-toast').classList.add('hidden')" class="font-black ml-4">✕</button>
    </div>

    <!-- Loading Box -->
    <div id="loading-box" class="py-16 text-center text-slate-500 font-mono text-sm">
      Loading article content from server...
    </div>

    <!-- Main Editor & Live Preview Grid -->
    <div id="editor-container" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-8 mt-6">
      
      <!-- Left Column: Form Controls (7 Cols) -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Post Title -->
        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm space-y-4">
          <div>
            <label for="post-title" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
              Article Title <span class="text-red-500">*</span>
            </label>
            <input 
              type="text" 
              id="post-title" 
              required
              class="w-full px-4 py-2.5 rounded-lg border border-slate-300 text-sm font-bold text-black focus:ring-2 focus:ring-[#16A34A] focus:outline-none"
            />
          </div>

          <div>
            <span class="block text-xs font-mono text-slate-500">
              Live Path: <a id="live-link" href="#" target="_blank" class="text-[#16A34A] hover:underline font-bold">/blog/<span id="slug-text"></span> ↗</a>
            </span>
          </div>
        </div>

        <!-- Category, Date & Featured Settings -->
        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label for="post-category" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
              Category
            </label>
            <select 
              id="post-category"
              class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs font-bold text-slate-800 bg-white focus:ring-2 focus:ring-[#16A34A] focus:outline-none"
            >
              <option value="AI Governance">AI Governance</option>
              <option value="Enterprise GRC">Enterprise GRC</option>
              <option value="Corporate Training">Corporate Training</option>
              <option value="Regulatory Alerts">Regulatory Alerts</option>
            </select>
          </div>

          <div>
            <label for="post-readtime" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
              Read Time
            </label>
            <input 
              type="text" 
              id="post-readtime" 
              class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs font-mono text-slate-700 focus:ring-2 focus:ring-[#16A34A] focus:outline-none"
            />
          </div>

          <div class="flex flex-col justify-between">
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
              Homepage Pin
            </label>
            <label class="flex items-center gap-2 cursor-pointer pt-1">
              <input type="checkbox" id="post-featured" class="w-4 h-4 text-[#16A34A] rounded border-slate-300 focus:ring-[#16A34A]" />
              <span class="text-xs font-bold text-slate-700">Feature on Home</span>
            </label>
          </div>
        </div>

        <!-- YouTube Video URL with Live Preview -->
        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm space-y-3">
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="post-video" class="text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-1.5">
                <svg class="w-4 h-4 text-red-600 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                <span>YouTube Video URL</span>
              </label>
              <span class="text-[11px] text-slate-400">Leave blank for text article</span>
            </div>
            <input 
              type="url" 
              id="post-video" 
              placeholder="https://www.youtube.com/watch?v=..." 
              class="w-full px-4 py-2.5 rounded-lg border border-slate-300 text-xs font-mono text-slate-800 focus:ring-2 focus:ring-[#16A34A] focus:outline-none"
            />
          </div>

          <!-- Real-Time Video Preview Container -->
          <div id="video-preview-box" class="hidden p-3 rounded-lg bg-slate-50 border border-slate-200">
            <span class="text-[10px] font-mono uppercase font-bold text-slate-500 mb-2 block">Live Video Preview:</span>
            <div class="relative aspect-video rounded-lg overflow-hidden bg-black shadow-sm">
              <iframe 
                id="video-iframe" 
                class="w-full h-full" 
                src="" 
                title="YouTube Video Preview" 
                frameborder="0" 
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                allowfullscreen
              ></iframe>
            </div>
          </div>
        </div>

        <!-- Article Image / Diagram Upload with Instant Preview -->
        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm space-y-3">
          <div class="flex items-center justify-between">
            <label class="text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-1.5">
              <svg class="w-4 h-4 text-[#16A34A] fill-none stroke-current" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <span>Article Image / Diagram / Infographic</span>
            </label>
            <span class="text-[11px] text-slate-400">PNG, JPG, WebP</span>
          </div>

          <!-- File Picker & Direct Upload Button -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
            <input 
              type="file" 
              id="image-file-input" 
              accept="image/png, image/jpeg, image/webp, image/gif" 
              class="block w-full text-xs text-slate-500 file:mr-3 file:py-2 file:px-3.5 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-slate-100 file:text-slate-800 hover:file:bg-slate-200 cursor-pointer border border-slate-200 rounded-lg p-1"
            />
            <button 
              type="button" 
              id="upload-image-btn" 
              class="shrink-0 px-3.5 py-2 rounded-lg text-xs font-bold bg-[#112649] hover:bg-[#1a3666] text-white shadow-sm transition-colors flex items-center justify-center gap-1.5"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
              <span>Upload & Insert</span>
            </button>
          </div>

          <!-- Cover Image URL input -->
          <div>
            <label for="post-image" class="block text-[11px] font-mono text-slate-500 mb-1">
              Cover Image Path (optional, for card preview):
            </label>
            <input 
              type="text" 
              id="post-image" 
              placeholder="e.g. /images/blog/diagram.png" 
              class="w-full px-3 py-1.5 rounded-lg border border-slate-300 text-xs font-mono text-slate-800 focus:ring-2 focus:ring-[#16A34A] focus:outline-none"
            />
          </div>

          <!-- Uploaded Image Preview Thumbnail -->
          <div id="image-preview-box" class="hidden p-3 rounded-lg bg-slate-50 border border-slate-200 flex items-center gap-4">
            <img id="image-preview-thumb" src="" alt="Uploaded preview" class="w-20 h-14 object-cover rounded border border-slate-300" />
            <div class="text-xs space-y-1">
              <div class="font-bold text-black" id="image-preview-name">diagram.png</div>
              <div class="text-[11px] text-slate-500 font-mono" id="image-preview-url">/images/blog/...</div>
              <button type="button" id="set-as-cover-btn" class="text-[11px] font-bold text-[#16A34A] hover:underline">
                Set as Cover Image
              </button>
            </div>
          </div>
        </div>

        <!-- Executive Summary & Tags -->
        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm space-y-4">
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="post-summary" class="text-xs font-bold uppercase tracking-wider text-slate-700">
                Executive Summary (Google SEO & Social Snippet)
              </label>
              <span id="summary-counter" class="text-[11px] font-mono text-slate-400">0 / 220 chars</span>
            </div>
            <textarea 
              id="post-summary" 
              rows="2" 
              maxlength="300"
              class="w-full px-3.5 py-2 rounded-lg border border-slate-300 text-xs text-slate-800 focus:ring-2 focus:ring-[#16A34A] focus:outline-none"
            ></textarea>
          </div>

          <div>
            <label for="post-tags" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
              Tags (Comma-Separated)
            </label>
            <input 
              type="text" 
              id="post-tags" 
              class="w-full px-3.5 py-2 rounded-lg border border-slate-300 text-xs font-mono text-slate-800 focus:ring-2 focus:ring-[#16A34A] focus:outline-none"
            />
          </div>
        </div>

        <!-- Social Media Cross-Posting & Ad Broadcast Studio -->
        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-slate-200">
            <div class="flex items-center gap-2">
              <span class="w-7 h-7 rounded-lg bg-[#112649] text-white flex items-center justify-center text-sm font-bold">🚀</span>
              <div>
                <h3 class="text-xs font-bold uppercase tracking-wider text-black">Social Media Cross-Posting & Ad Studio</h3>
                <p class="text-[11px] text-slate-500">Push directly to LinkedIn, X, Facebook, and WhatsApp Broadcast</p>
              </div>
            </div>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" id="auto-webhook-push" class="rounded text-[#16A34A] focus:ring-[#16A34A]" checked />
              <span class="text-xs font-bold text-slate-700">Auto-Push on Save</span>
            </label>
          </div>

          <!-- Channel Selection -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
            <label class="flex items-center gap-2 p-2 rounded-lg bg-slate-50 border border-slate-200 cursor-pointer hover:bg-slate-100">
              <input type="checkbox" id="ch-linkedin" checked class="rounded text-[#0077B5] focus:ring-[#0077B5]" />
              <span class="font-bold text-slate-800">LinkedIn</span>
            </label>
            <label class="flex items-center gap-2 p-2 rounded-lg bg-slate-50 border border-slate-200 cursor-pointer hover:bg-slate-100">
              <input type="checkbox" id="ch-twitter" checked class="rounded text-black focus:ring-black" />
              <span class="font-bold text-slate-800">X (Twitter)</span>
            </label>
            <label class="flex items-center gap-2 p-2 rounded-lg bg-slate-50 border border-slate-200 cursor-pointer hover:bg-slate-100">
              <input type="checkbox" id="ch-whatsapp" checked class="rounded text-[#25D366] focus:ring-[#25D366]" />
              <span class="font-bold text-slate-800">WhatsApp</span>
            </label>
            <label class="flex items-center gap-2 p-2 rounded-lg bg-slate-50 border border-slate-200 cursor-pointer hover:bg-slate-100">
              <input type="checkbox" id="ch-facebook" checked class="rounded text-[#1877F2] focus:ring-[#1877F2]" />
              <span class="font-bold text-slate-800">Facebook</span>
            </label>
          </div>

          <!-- Social Copy & Brochure Link -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="social-custom-copy" class="text-xs font-bold uppercase tracking-wider text-slate-700">
                Custom Social Post / Ad Copy
              </label>
              <button type="button" id="refresh-social-copy-btn" class="text-[11px] font-bold text-[#16A34A] hover:underline flex items-center gap-1">
                <span>↻ Refresh from Title/Summary</span>
              </button>
            </div>
            <textarea 
              id="social-custom-copy" 
              rows="3" 
              class="w-full px-3.5 py-2 rounded-lg border border-slate-300 text-xs font-mono text-slate-800 focus:ring-2 focus:ring-[#16A34A] focus:outline-none"
              placeholder="Auto-generated social teaser including link to company brochure and hashtags..."
            ></textarea>
            <div class="flex items-center justify-between mt-1.5 text-[11px] text-slate-500">
              <span>Includes link to <strong>Company Profile & Brochure</strong> (/company-profile)</span>
              <span id="social-char-count">0 chars</span>
            </div>
          </div>

          <!-- 1-Click Instant Push Launchers -->
          <div class="pt-2 border-t border-slate-200">
            <span class="text-[11px] font-mono font-bold text-slate-500 uppercase block mb-2">Instant 1-Click Launch Now (Test or Immediate Push):</span>
            <div class="flex flex-wrap items-center gap-2">
              <button type="button" id="launch-linkedin-btn" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-[#0077B5] hover:bg-[#005f93] text-white flex items-center gap-1.5 transition-all">
                <span>LinkedIn</span>
              </button>
              <button type="button" id="launch-twitter-btn" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-black hover:bg-slate-800 text-white flex items-center gap-1.5 transition-all">
                <span>X (Twitter)</span>
              </button>
              <button type="button" id="launch-whatsapp-btn" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-[#25D366] hover:bg-[#1ebc59] text-white flex items-center gap-1.5 transition-all">
                <span>WhatsApp</span>
              </button>
              <button type="button" id="launch-facebook-btn" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-[#1877F2] hover:bg-[#0c65d8] text-white flex items-center gap-1.5 transition-all">
                <span>Facebook</span>
              </button>
              <button type="button" id="launch-all-social-btn" class="px-3.5 py-1.5 rounded-lg text-xs font-bold bg-[#112649] hover:bg-[#1a3666] text-white flex items-center gap-1.5 transition-all ml-auto">
                <span>🚀 Launch All Channels</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Markdown Body Editor with Quick Toolbar -->
        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm space-y-3">
          <div class="flex items-center justify-between">
            <label for="post-body" class="text-xs font-bold uppercase tracking-wider text-slate-700">
              Article Content (Markdown)
            </label>
            <span class="text-[11px] text-slate-400">Supports headers, lists, checklists</span>
          </div>

          <!-- Markdown Toolbar -->
          <div class="flex flex-wrap items-center gap-1 p-1.5 bg-slate-100 rounded-lg border border-slate-200 text-xs font-mono">
            <button type="button" onclick="insertMd('**', '**')" class="px-2 py-1 rounded bg-white hover:bg-slate-200 font-bold">B</button>
            <button type="button" onclick="insertMd('*', '*')" class="px-2 py-1 rounded bg-white hover:bg-slate-200 italic">I</button>
            <button type="button" onclick="insertMd('\n### ', '\n')" class="px-2 py-1 rounded bg-white hover:bg-slate-200 font-bold">H3</button>
            <button type="button" onclick="insertMd('\n- ', '')" class="px-2 py-1 rounded bg-white hover:bg-slate-200">• List</button>
            <button type="button" onclick="insertMd('\n- [ ] ', '')" class="px-2 py-1 rounded bg-white hover:bg-slate-200">☑ Check</button>
            <button type="button" onclick="insertMd('\n> ', '\n')" class="px-2 py-1 rounded bg-white hover:bg-slate-200">❝ Quote</button>
            <button type="button" onclick="insertMd('\n```\n', '\n```\n')" class="px-2 py-1 rounded bg-white hover:bg-slate-200">&lt;/&gt;</button>
          </div>

          <textarea 
            id="post-body" 
            rows="14" 
            class="w-full p-4 rounded-lg border border-slate-300 font-mono text-xs leading-relaxed text-slate-800 focus:ring-2 focus:ring-[#16A34A] focus:outline-none"
          ></textarea>
        </div>

      </div>

      <!-- Right Column: Live Article Preview (5 Cols) -->
      <div class="lg:col-span-5">
        <div class="sticky top-24 space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-600 font-mono">Live Visual Preview</span>
            <span class="text-[10px] px-2 py-0.5 rounded bg-slate-200 text-slate-700 font-bold uppercase">Real-Time</span>
          </div>

          <div class="bg-white rounded-xl border border-slate-300 shadow-sm p-6 overflow-hidden">
            <!-- Preview Category & Read Time -->
            <div class="flex items-center gap-2 mb-3 text-xs">
