---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Staff Portal Authentication — RKMIDIGILABS" 
  description="Secure Content Management Administration Portal for RKMIDIGILABS."
>
  <div class="min-h-[75vh] flex items-center justify-center px-4 py-12 bg-slate-50">
    <div class="w-full max-w-md bg-white border border-slate-300 rounded-2xl shadow-xl overflow-hidden">
      
      <!-- Card Header in Corporate Navy #112649 -->
      <div class="bg-[#112649] px-6 py-8 text-center text-white border-b border-[#1d3d75]">
        <div class="w-12 h-12 mx-auto mb-3 bg-white p-1 rounded-xl shadow-sm border border-slate-300">
          <img src="/images/rkmidigilabs-logo.jpg" alt="RKMIDIGILABS Logo" class="w-full h-full object-contain" />
        </div>
        <h1 class="text-xl font-black text-white tracking-tight">RKMIDIGILABS Staff Portal</h1>
        <p class="text-xs text-slate-300 mt-1 font-mono uppercase tracking-wider">Restricted Administration Gateway</p>
      </div>

      <!-- Login Form -->
      <div class="p-6 sm:p-8">
        
        <div id="logged-out-alert" class="hidden p-3 rounded-lg bg-emerald-50 border border-emerald-300 text-xs text-emerald-800 font-bold mb-4 flex items-center gap-2">
          <svg class="w-4 h-4 text-[#16A34A] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span>You have been signed out successfully.</span>
        </div>

        <div id="lockout-alert" class="hidden p-3.5 rounded-lg bg-red-50 border border-red-300 text-xs text-red-800 font-bold mb-4">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-red-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            <span>Too many failed attempts. Account temporarily locked.</span>
          </div>
          <p class="mt-1 font-mono text-[11px] text-red-700" id="lockout-timer-text">Please wait 5 minutes before trying again.</p>
        </div>

        <form id="login-form" class="space-y-4">
          <!-- Username Field -->
          <div>
            <label for="admin-username" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
              Admin Username or Email <span class="text-red-500">*</span>
            </label>
            <div class="relative">
              <input 
                type="text" 
                id="admin-username" 
                name="username"
                placeholder="e.g. admin or rkmvedant@gmail.com" 
                required
                autocomplete="username"
                class="w-full px-4 py-3 rounded-lg border border-slate-300 bg-white text-black text-sm focus:outline-none focus:ring-2 focus:ring-[#16A34A] focus:border-transparent transition-all font-medium"
              />
            </div>
          </div>

          <!-- Password Field -->
          <div>
            <label for="admin-password" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
              Admin Password <span class="text-red-500">*</span>
            </label>
            <div class="relative">
              <input 
                type="password" 
                id="admin-password" 
                name="password"
                placeholder="Enter administrator password" 
                required
                autocomplete="current-password"
                class="w-full px-4 py-3 rounded-lg border border-slate-300 bg-white text-black font-mono text-sm focus:outline-none focus:ring-2 focus:ring-[#16A34A] focus:border-transparent transition-all pr-16"
              />
              <button 
                type="button" 
                id="toggle-visibility"
                class="absolute right-3 top-3 text-slate-400 hover:text-slate-700 text-xs font-bold px-1.5 py-0.5 rounded cursor-pointer"
              >
                SHOW
              </button>
            </div>
          </div>

          <div id="error-alert" class="hidden p-3 rounded-lg bg-red-50 border border-red-200 text-xs text-red-700 font-semibold">
            Invalid username or password. Please verify your credentials.
          </div>

          <button 
            type="submit" 
            id="submit-btn"
            class="w-full py-3.5 px-4 rounded-lg font-bold text-sm bg-[#16A34A] hover:bg-[#15803D] text-white transition-all shadow-md flex items-center justify-center gap-2 cursor-pointer mt-2"
          >
            <span>Verify Credentials & Enter Studio</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </button>
        </form>

        <div class="mt-6 pt-5 border-t border-slate-200 text-center">
          <a href="/" class="text-xs font-bold text-slate-600 hover:text-black">
            ← Return to Public Website
          </a>
        </div>
      </div>

    </div>
  </div>

<script>
  const API_PORT = 4322;
  const isLocal = ['localhost', '127.0.0.1', '::1'].includes(window.location.hostname) || 
                  window.location.hostname.startsWith('192.168.') || 
                  window.location.hostname.startsWith('10.') || 
                  window.location.hostname.endsWith('.local');
  const API_BASE = isLocal 
    ? `${window.location.protocol}//${window.location.hostname}:${API_PORT}` 
    : window.location.origin;

  const urlParams = new URLSearchParams(window.location.search);
  const isAuthPrompt = urlParams.has('auth_prompt') || urlParams.has('logged_out');

  // If prompted for auth or logged out, purge all tokens so no stale bypass occurs
  if (isAuthPrompt) {
    localStorage.removeItem('rkmidigi_admin_token');
    localStorage.removeItem('rkmidigi_admin_user');
    sessionStorage.removeItem('rkmidigi_admin_token');
    sessionStorage.removeItem('rkmidigi_admin_user');
    sessionStorage.removeItem('rkmidigi_admin_expires');
  }

  if (urlParams.get('logged_out')) {
    const loAlert = document.getElementById('logged-out-alert');
    if (loAlert) loAlert.classList.remove('hidden');
  } else if (!isAuthPrompt) {
    // Only auto-redirect if an active unexpired sessionStorage exists
    const token = sessionStorage.getItem('rkmidigi_admin_token');
    const expires = parseInt(sessionStorage.getItem('rkmidigi_admin_expires') || '0', 10);
    if (token && Date.now() < expires) {
      window.location.href = '/admin';
    }
  }

  const form = document.getElementById('login-form') as HTMLFormElement;
  const userInput = document.getElementById('admin-username') as HTMLInputElement;
  const passInput = document.getElementById('admin-password') as HTMLInputElement;
  const toggleBtn = document.getElementById('toggle-visibility');
  const errorAlert = document.getElementById('error-alert');
  const lockoutAlert = document.getElementById('lockout-alert');
  const lockoutText = document.getElementById('lockout-timer-text');
  const submitBtn = document.getElementById('submit-btn');

  // Lockout check
  function checkLockout(): boolean {
    const lockoutUntil = parseInt(sessionStorage.getItem('rkmidigi_lockout_until') || '0', 10);
    if (lockoutUntil && Date.now() < lockoutUntil) {
      const remainingSecs = Math.ceil((lockoutUntil - Date.now()) / 1000);
      if (lockoutAlert && lockoutText) {
        lockoutAlert.classList.remove('hidden');
        lockoutText.textContent = `Security lockout active. Please wait ${remainingSecs} seconds.`;
      }
      if (submitBtn) submitBtn.setAttribute('disabled', 'true');
      return true;
    }
    if (lockoutAlert) lockoutAlert.classList.add('hidden');
    if (submitBtn) submitBtn.removeAttribute('disabled');
    return false;
  }

  checkLockout();
  setInterval(checkLockout, 1000);

  if (toggleBtn && passInput) {
    toggleBtn.addEventListener('click', () => {
      const isPass = passInput.type === 'password';
      passInput.type = isPass ? 'text' : 'password';
      toggleBtn.textContent = isPass ? 'HIDE' : 'SHOW';
    });
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (checkLockout()) return;

      const username = (userInput?.value || '').trim().toLowerCase();
      const password = (passInput?.value || '').trim();

      if (!username || !password) {
        if (errorAlert) {
          errorAlert.textContent = 'Please enter both username and password.';
          errorAlert.classList.remove('hidden');
        }
        return;
      }

      if (submitBtn) {
        submitBtn.setAttribute('disabled', 'true');
        submitBtn.innerHTML = `<span>Verifying credentials...</span>`;
      }
      if (errorAlert) errorAlert.classList.add('hidden');

      // 1. If local Node API is running, attempt local server verification
      let authenticated = false;
      let userData: any = null;
      let authToken = '';

      if (isLocal) {
        try {
          const res = await fetch(`${API_BASE}/api/admin/login`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username, password })
          });
          if (res.ok) {
            const data = await res.json();
            if (data.success && data.token) {
              authenticated = true;
              authToken = data.token;
              userData = data.user || { name: 'Admin', username };
            }
          }
        } catch (err) {}
      }

      // 2. Production / Cloud Verification (Username + Password required)
      if (!authenticated) {
        const validUsernames = ['admin', 'rkmidigi', 'rkmidigilabs', 'rajesh', 'rkmvedant@gmail.com'];
        const validPassword = 'rkmidigi2026!';

        if (validUsernames.includes(username) && password === validPassword) {
          authenticated = true;
          authToken = 'rkmidigi_staff_' + btoa(username + ':' + Date.now());
          userData = { name: 'Rajesh K. M.', username, role: 'Lead Admin' };
        }
      }

      if (authenticated) {
        // Reset failed attempts
        sessionStorage.removeItem('rkmidigi_failed_attempts');
        sessionStorage.removeItem('rkmidigi_lockout_until');

        // Store session token ONLY in sessionStorage with 60-minute expiry
        // Do NOT store in permanent localStorage to avoid persistent auto-login
        const expiry = Date.now() + 60 * 60 * 1000;
        sessionStorage.setItem('rkmidigi_admin_token', authToken);
        sessionStorage.setItem('rkmidigi_admin_user', JSON.stringify(userData));
        sessionStorage.setItem('rkmidigi_admin_expires', expiry.toString());

        // Ensure old persistent localStorage tokens are removed
        localStorage.removeItem('rkmidigi_admin_token');
        localStorage.removeItem('rkmidigi_admin_user');

        window.location.href = '/admin';
      } else {
        // Track failed attempts
        const attempts = parseInt(sessionStorage.getItem('rkmidigi_failed_attempts') || '0', 10) + 1;
        sessionStorage.setItem('rkmidigi_failed_attempts', attempts.toString());

        if (attempts >= 5) {
          const lockoutUntil = Date.now() + 5 * 60 * 1000;
          sessionStorage.setItem('rkmidigi_lockout_until', lockoutUntil.toString());
          checkLockout();
        } else {
          if (errorAlert) {
            errorAlert.textContent = `Invalid username or password. (${5 - attempts} attempts remaining before temporary lockout)`;
            errorAlert.classList.remove('hidden');
          }
        }

        if (submitBtn) {
          submitBtn.removeAttribute('disabled');
          submitBtn.innerHTML = `<span>Verify Credentials & Enter Studio</span> <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>`;
        }
      }
    });
  }
</script>
</BaseLayout>
