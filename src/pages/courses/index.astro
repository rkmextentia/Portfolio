---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { COURSES } from '../../lib/courses-data';
---

<BaseLayout 
  title="AI Governance & Enterprise GRC Masterclasses — RKMIDIGILABS Academy" 
  description="Self-paced, high-definition video masterclasses on ISO/IEC 42001 Lead Implementation, EU AI Act compliance, and NIST AI RMF 1.0. Taught by Principal GRC Lead Rajesh K. M."
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-[#112649] via-[#0e1f3d] to-slate-900 text-white py-16 sm:py-20 border-b border-[#1d3d75]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono font-semibold mb-4">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          RKMIDIGILABS ACADEMY • VIDEO TUTORIALS & CERTIFICATION
        </div>
        <h1 class="text-3xl sm:text-5xl font-black tracking-tight leading-tight mb-4">
          Executive Masterclasses in <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400">AI Governance & Enterprise GRC</span>
        </h1>
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed mb-8">
          Self-paced, deep-dive video masterclasses designed for CISOs, compliance leads, AI engineers, and legal counsel. Get actionable checklists, editable policy packs, and lead implementer blueprints.
        </p>

        <!-- Quick Stats -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4 border-t border-slate-700/60 text-xs font-mono">
          <div>
            <div class="text-xl font-bold text-white">3 Flagship</div>
            <div class="text-slate-400 mt-0.5">Masterclasses</div>
          </div>
          <div>
            <div class="text-xl font-bold text-emerald-400">19+ Hours</div>
            <div class="text-slate-400 mt-0.5">HD Video Content</div>
          </div>
          <div>
            <div class="text-xl font-bold text-white">24 Modules</div>
            <div class="text-slate-400 mt-0.5">Step-by-Step Lessons</div>
          </div>
          <div>
            <div class="text-xl font-bold text-emerald-400">Lifetime</div>
            <div class="text-slate-400 mt-0.5">On-Demand Access</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Course Catalog -->
  <section class="py-16 bg-slate-50 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Catalog Controls -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-10">
        <div>
          <h2 class="text-2xl font-black text-slate-900 tracking-tight">Available Courses</h2>
          <p class="text-xs text-slate-500 font-mono mt-0.5">Select a course to preview lessons, view syllabus, and enroll.</p>
        </div>

        <div class="flex items-center gap-2">
          <a 
            href="/dashboard" 
            class="px-4 py-2 rounded-lg text-xs font-bold bg-white hover:bg-slate-100 text-[#112649] border border-slate-300 transition-colors shadow-xs flex items-center gap-1.5"
          >
            <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            Student Portal
          </a>
        </div>
      </div>

      <!-- Courses Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        {COURSES.map(course => (
          <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col group">
            
            <!-- Card Header & Badge -->
            <div class="relative bg-gradient-to-br from-[#112649] to-slate-900 p-6 text-white overflow-hidden">
              <div class="absolute -right-8 -bottom-8 w-32 h-32 bg-emerald-500/10 rounded-full blur-2xl pointer-events-none"></div>
              
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                  {course.category}
                </span>
                <span class="text-[11px] font-mono text-slate-300">
                  {course.level}
                </span>
              </div>

              <h3 class="text-lg font-black text-white leading-snug group-hover:text-emerald-300 transition-colors">
                <a href={`/courses/${course.slug}`}>
                  {course.title}
                </a>
              </h3>
              <p class="text-xs text-slate-300 mt-1 line-clamp-2">
                {course.subtitle}
              </p>

              <div class="flex items-center gap-4 mt-4 pt-3 border-t border-slate-700/60 text-[11px] font-mono text-slate-300">
                <span class="flex items-center gap-1">
                  <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  {course.durationHours}
                </span>
                <span class="flex items-center gap-1">
                  <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                  {course.totalLessons} Lessons
                </span>
              </div>
            </div>

            <!-- Card Body -->
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <p class="text-xs text-slate-600 leading-relaxed mb-4">
                  {course.summary}
                </p>

                <!-- Key Highlights -->
                <div class="space-y-1.5 mb-6">
                  <div class="text-[11px] font-bold text-slate-900 uppercase font-mono tracking-wider">What you learn:</div>
                  {course.whatYouWillLearn.slice(0, 3).map(pt => (
                    <div class="flex items-start gap-2 text-xs text-slate-600">
                      <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                      <span>{pt}</span>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Price & CTA Area -->
              <div class="pt-4 border-t border-slate-100">
                <div class="flex items-baseline justify-between mb-4">
                  <div>
                    <span class="text-2xl font-black text-slate-900">₹{course.priceInr.toLocaleString('en-IN')}</span>
                    <span class="text-xs text-slate-400 line-through ml-2 font-mono">₹{course.originalPriceInr.toLocaleString('en-IN')}</span>
                  </div>
                  <span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-[10px] font-bold">
                    SAVE {Math.round((1 - course.priceInr / course.originalPriceInr) * 100)}%
                  </span>
                </div>

                <div class="grid grid-cols-2 gap-2">
                  <a 
                    href={`/courses/${course.slug}`} 
                    class="py-2.5 px-3 rounded-xl font-bold text-xs bg-slate-100 hover:bg-slate-200 text-slate-800 text-center transition-colors"
                  >
                    View Curriculum
                  </a>
                  <a 
                    href={`/courses/${course.slug}/learn`} 
                    class="py-2.5 px-3 rounded-xl font-bold text-xs bg-[#16A34A] hover:bg-[#15803D] text-white text-center transition-colors shadow-sm flex items-center justify-center gap-1"
                  >
                    <span>Watch Preview</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                  </a>
                </div>
              </div>

            </div>

          </div>
        ))}
      </div>

      <!-- Trust & Corporate Training Banner -->
      <div class="mt-16 bg-white rounded-2xl p-8 border border-slate-200 shadow-sm flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="max-w-2xl">
          <span class="px-2.5 py-0.5 rounded bg-blue-100 text-blue-800 text-[11px] font-mono font-bold uppercase tracking-wider">
            Corporate Team Training
          </span>
          <h3 class="text-xl font-black text-slate-900 mt-2 mb-1">
            Need Custom Corporate Cohorts or Live Masterclasses for your Enterprise?
          </h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            We deliver private multi-day corporate cohorts for engineering teams, compliance departments, and executive leadership tailored to your internal AI stack and proprietary models.
          </p>
        </div>
        <div class="shrink-0 flex items-center gap-3">
          <a 
            href="/services" 
            class="px-5 py-3 rounded-xl bg-[#112649] hover:bg-[#1d3d75] text-white text-xs font-bold transition-colors shadow-sm"
          >
            Corporate Training Details
          </a>
          <button 
            type="button" 
            data-service="Corporate Training Inquiry"
            class="open-inquiry-modal-btn px-5 py-3 rounded-xl bg-[#16A34A] hover:bg-[#15803D] text-white text-xs font-bold transition-colors shadow-sm cursor-pointer"
          >
            Request Team Proposal
          </button>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
