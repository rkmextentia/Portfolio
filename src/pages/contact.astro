---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Contact RKMIDIGILABS"
  description="Connect directly with RKMIDIGILABS for corporate training, AI Governance advisory, and Enterprise GRC consulting."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
    
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-xs font-mono font-bold tracking-widest uppercase bg-slate-100 text-slate-700 border border-slate-300 px-3 py-1 rounded-full">
        Direct Communication
      </span>
      <h1 class="text-3xl sm:text-5xl font-black text-black tracking-tight mt-3">
        Contact RKMIDIGILABS
      </h1>
      <p class="mt-4 text-sm sm:text-base text-slate-700 leading-relaxed font-normal">
        Connect directly with our advisory and training team. No account registration or portal sign-in required.
      </p>
    </div>

    <!-- Direct Contact Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      
      <!-- Direct Email Card -->
      <div class="p-6 sm:p-8 rounded-xl bg-slate-50 border border-slate-200 shadow-sm flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-[#112649] text-white flex items-center justify-center mb-4 shadow-sm">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <span class="text-xs font-mono uppercase tracking-wider text-slate-500 font-bold block mb-1">Official Email</span>
          <h2 class="text-xl font-black text-black">rkmvedant@gmail.com</h2>
          <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">
            Send inquiries regarding EU AI Act assessments, NIST AI RMF implementation, or enterprise team training.
          </p>
        </div>
        <div class="mt-6 pt-6 border-t border-slate-200">
          <a 
            href="mailto:rkmvedant@gmail.com?subject=Inquiry%20to%20RKMIDIGILABS%3A%20AI%20Governance%20%26%20GRC"
            class="w-full text-center block py-3 px-4 rounded-lg font-bold text-sm bg-[#16A34A] hover:bg-[#15803D] text-white transition-colors shadow-sm"
          >
            Send Direct Email →
          </a>
        </div>
      </div>

      <!-- Mobile / Phone Card -->
      <div class="p-6 sm:p-8 rounded-xl bg-slate-50 border border-slate-200 shadow-sm flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-[#112649] text-white flex items-center justify-center mb-4 shadow-sm">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          </div>
          <span class="text-xs font-mono uppercase tracking-wider text-slate-500 font-bold block mb-1">Direct Phone / WhatsApp</span>
          <h2 class="text-xl font-black text-black">+91 9371650121</h2>
          <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">
            Available for executive consulting scheduling, corporate masterclass inquiries, and speaking events.
          </p>
        </div>
        <div class="mt-6 pt-6 border-t border-slate-200 flex items-center gap-3">
          <a 
            href="tel:+919371650121"
            class="flex-1 text-center py-3 px-4 rounded-lg font-bold text-sm bg-[#16A34A] hover:bg-[#15803D] text-white transition-colors shadow-sm"
          >
            Call: 9371650121
          </a>
          <a 
            href="https://wa.me/919371650121" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="flex-1 text-center py-3 px-4 rounded-lg font-bold text-sm bg-slate-200 hover:bg-slate-300 text-slate-800 transition-colors"
          >
            WhatsApp ↗
          </a>
        </div>
      </div>

    </div>

    <!-- Company Summary Details Box -->
    <div class="p-6 sm:p-8 rounded-xl bg-white border border-slate-300 shadow-sm mb-10">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-500">Corporate Entity</span>
          <h3 class="text-2xl font-black text-black mt-1">RKMIDIGILABS</h3>
          <p class="text-xs sm:text-sm text-slate-600 mt-1">
            Specialized in AI Governance (AIGP alignment), Enterprise GRC (ISO 27001, SOC 2), and Corporate Training.
          </p>
        </div>
        <div class="text-xs text-slate-700 font-mono space-y-1 bg-slate-50 p-4 rounded-lg border border-slate-200 shrink-0">
          <div><span class="font-bold text-slate-900">Entity:</span> RKMIDIGILABS</div>
          <div><span class="font-bold text-slate-900">Email:</span> rkmvedant@gmail.com</div>
          <div><span class="font-bold text-slate-900">Phone:</span> +91 9371650121</div>
        </div>
      </div>
    </div>

    <!-- Quick Inquiry Templates -->
    <div class="p-6 sm:p-8 rounded-xl bg-slate-100 border border-slate-300">
      <h3 class="text-xs font-bold font-mono text-slate-700 uppercase tracking-wider mb-4">
        Click to Start a Pre-Filled Email to rkmvedant@gmail.com:
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
        <a 
          href="mailto:rkmvedant@gmail.com?subject=Inquiry%3A%20EU%20AI%20Act%20Readiness%20Assessment&body=Hi%20RKMIDIGILABS%2C%0A%0AWe%20would%20like%20to%20discuss%20an%20AI%20Governance%20assessment%20for%20our%20models.%0A%0ACompany%3A%0APhone%3A"
          data-service="AI Governance Consultancy"
          class="open-inquiry-modal-btn p-3.5 rounded-lg bg-white hover:bg-slate-50 border border-slate-200 text-slate-800 hover:text-emerald-700 block transition-colors shadow-sm cursor-pointer"
        >
          <span class="font-bold block mb-1 text-black">EU AI Act Assessment</span>
          <span>Model classification, Annex III, FRIA →</span>
        </a>
        <a 
          href="mailto:rkmvedant@gmail.com?subject=Inquiry%3A%20Corporate%20AI%20Governance%20Training%20Cohort&body=Hi%20RKMIDIGILABS%2C%0A%0AWe%20would%20like%20to%20inquire%20about%20corporate%20training%20for%20our%20team.%0A%0ATeam%20Size%3A%0APreferred%20Dates%3A"
          data-service="Corporate Training Workshops"
          class="open-inquiry-modal-btn p-3.5 rounded-lg bg-white hover:bg-slate-50 border border-slate-200 text-slate-800 hover:text-emerald-700 block transition-colors shadow-sm cursor-pointer"
        >
          <span class="font-bold block mb-1 text-black">Corporate Training</span>
          <span>Executive & engineering masterclasses →</span>
        </a>
        <a 
          href="mailto:rkmvedant@gmail.com?subject=Inquiry%3A%20Enterprise%20GRC%20%26%20ISO%2042001%20Advisory&body=Hi%20RKMIDIGILABS%2C%0A%0AWe%20are%20preparing%20for%20an%20audit%20and%20need%20advisory%20support.%0A%0AFramework%3A%20ISO%2042001%20%2F%20SOC%202%20%2F%20ISO%2027001%0A"
          data-service="Enterprise GRC Advisory"
          class="open-inquiry-modal-btn p-3.5 rounded-lg bg-white hover:bg-slate-50 border border-slate-200 text-slate-800 hover:text-emerald-700 block transition-colors shadow-sm cursor-pointer"
        >
          <span class="font-bold block mb-1 text-black">ISO 42001 & SOC 2</span>
          <span>Audit readiness, controls, TPRM →</span>
        </a>
      </div>
    </div>

  </div>
</BaseLayout>