---
const navLinks = [
  { name: "Home", href: "/" },
  { name: "Courses / Academy", href: "/courses" },
  { name: "Profile & Brochure", href: "/company-profile" },
  { name: "Blog", href: "/blog" },
  { name: "Services", href: "/services" },
  { name: "Frameworks", href: "/frameworks" },
  { name: "About", href: "/about" },
];

const currentPath = Astro.url.pathname;
---

<!-- Header with background color #112649 and fonts in white color -->
<header class="sticky top-0 z-50 bg-[#112649] text-white border-b border-[#1d3d75] shadow-md transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      <!-- Brand Logo & Company Name: RKMIDIGILABS -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-lg overflow-hidden bg-white p-0.5 shadow-sm shrink-0 border border-slate-300">
          <img 
            src="/images/rkmidigilabs-logo.jpg" 
            alt="RKMIDIGILABS Logo" 
            class="w-full h-full object-contain"
          />
        </div>
        <div class="flex flex-col">
          <span class="font-extrabold text-white text-lg sm:text-xl tracking-tight leading-none group-hover:text-emerald-400 transition-colors">
            RKMIDIGILABS
          </span>
          <span class="text-[10px] sm:text-xs text-slate-300 font-mono tracking-wider uppercase mt-1">
            AI Governance • Enterprise GRC • Training
          </span>
        </div>
      </a>

      <!-- Desktop Navigation - White Fonts -->
      <nav class="hidden md:flex items-center gap-1.5">
        {navLinks.map(link => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a 
              href={link.href} 
              class={`px-3.5 py-2 rounded-lg text-sm font-medium transition-colors ${
                isActive 
                  ? 'text-white bg-[#1d3d75] font-bold border border-slate-600/50' 
                  : 'text-slate-200 hover:text-white hover:bg-[#1a3666]'
              }`}
            >
              {link.name}
            </a>
          );
        })}
      </nav>

      <!-- Action Button & Working Social Media Links (Route to Company Profile & Brochure) -->
      <div class="hidden sm:flex items-center gap-3">
        <a 
          href="/company-profile#youtube" 
          class="p-2 rounded-lg text-slate-300 hover:text-red-400 hover:bg-[#1a3666] transition-colors"
          title="RKMIDIGILABS YouTube Dispatches & Company Profile"
          aria-label="YouTube Channel"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>

        <a 
          href="/company-profile#linkedin" 
          class="p-2 rounded-lg text-slate-300 hover:text-blue-400 hover:bg-[#1a3666] transition-colors"
          title="Connect with RKMIDIGILABS on LinkedIn"
          aria-label="LinkedIn Profile"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.67a1.66 1.66 0 1 0 1.66 1.66 1.67 1.67 0 0 0-1.66-1.66z"/></svg>
        </a>

        <!-- Twitter / X -->
        <a 
          href="/company-profile#twitter" 
          class="p-2 rounded-lg text-slate-300 hover:text-white hover:bg-[#1a3666] transition-colors"
          title="Follow RKMIDIGILABS on X (Twitter)"
          aria-label="X Twitter Profile"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>

        <!-- Student Portal CTA -->
        <a 
          href="/dashboard" 
          class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-mono font-bold bg-[#1d3d75] hover:bg-[#254d93] text-emerald-300 border border-emerald-500/30 transition-all shadow-xs"
          title="Student Learning Portal & Enrolled Courses"
        >
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          <span>Student Portal</span>
        </a>

        <!-- Green Corporate Primary CTA Button -->
        <a 
          href="/contact" 
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-bold bg-[#16A34A] hover:bg-[#15803D] text-white shadow-sm transition-all"
        >
          <span>Contact Us</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex md:hidden">
        <button 
          type="button" 
          id="mobile-menu-button"
          class="p-2 rounded-lg text-slate-300 hover:text-white hover:bg-[#1a3666]" 
          aria-label="Toggle Navigation Menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-[#1d3d75] bg-[#0d1f3d] px-4 pt-3 pb-6 space-y-2 shadow-lg">
    {navLinks.map(link => (
      <a 
        href={link.href} 
        class="block px-3 py-2 rounded-md text-base font-medium text-white hover:bg-[#1d3d75]"
      >
        {link.name}
      </a>
    ))}
    <div class="pt-3 border-t border-slate-700/60">
      <div class="text-xs text-slate-300 mb-2 font-mono">
        📞 +91 9371650121 • ✉️ rkmvedant@gmail.com
      </div>
      <a 
        href="/contact" 
        class="w-full text-center block py-2.5 px-4 rounded-lg font-bold bg-[#16A34A] hover:bg-[#15803D] text-white transition-colors"
      >
        Contact RKMIDIGILABS
      </a>
    </div>
  </div>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  if (menuButton && mobileMenu) {
    menuButton.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>