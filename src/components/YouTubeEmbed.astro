---
import { getYouTubeInfo } from '../utils/youtube';

interface Props {
  url?: string;
  videoId?: string;
  title?: string;
  aspectRatio?: string;
  class?: string;
}

const {
  url,
  videoId: propVideoId,
  title = "Watch Video Breakdown",
  aspectRatio = "aspect-video",
  class: className = ""
} = Astro.props;

const effectiveId = propVideoId || (url ? getYouTubeInfo(url)?.videoId : null);
const info = effectiveId ? getYouTubeInfo(effectiveId) : null;
---

{info ? (
  <div 
    class={`relative w-full ${aspectRatio} rounded-xl overflow-hidden bg-slate-900 border border-slate-300 shadow-corporate-md group cursor-pointer ${className}`}
    data-youtube-facade
    data-video-id={info.videoId}
    data-video-title={title}
  >
    <!-- Facade High-Res Thumbnail -->
    <img 
      src={info.thumbnailMaxRes} 
      alt={title}
      loading="eager"
      decoding="async"
      class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300"
      onerror="this.onerror=null; this.src='https://img.youtube.com/vi/' + this.parentElement.dataset.videoId + '/hqdefault.jpg';"
    />

    <!-- Subtle Vignette Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-transparent to-transparent pointer-events-none"></div>

    <!-- YouTube Brand Badge -->
    <div class="absolute top-4 left-4 inline-flex items-center gap-2 px-2.5 py-1 rounded bg-white/95 text-xs font-semibold text-slate-800 shadow-sm">
      <svg class="w-4 h-4 fill-red-600" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
      <span>Video Analysis</span>
    </div>

    <!-- Center Play Button -->
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
      <div class="w-16 h-16 sm:w-18 sm:h-18 rounded-full bg-red-600 text-white flex items-center justify-center shadow-lg group-hover:scale-110 group-hover:bg-red-500 transition-transform duration-200">
        <svg class="w-8 h-8 fill-current translate-x-0.5" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
      </div>
    </div>

    <!-- Bottom Caption -->
    <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between text-xs text-white pointer-events-none">
      <span class="font-medium truncate max-w-[80%]">{title}</span>
      <span class="bg-black/60 px-2 py-0.5 rounded text-[11px] font-mono">Click to Play</span>
    </div>
  </div>
) : null}

<script>
  function initYouTubeFacades() {
    const facades = document.querySelectorAll('[data-youtube-facade]');
    facades.forEach(facade => {
      facade.addEventListener('click', function(this: HTMLElement) {
        const videoId = this.dataset.videoId;
        const videoTitle = this.dataset.videoTitle || 'YouTube Video Player';
        if (!videoId) return;

        const iframe = document.createElement('iframe');
        iframe.setAttribute('src', `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0&modestbranding=1`);
        iframe.setAttribute('title', videoTitle);
        iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');
        iframe.setAttribute('allowfullscreen', 'true');
        iframe.className = 'w-full h-full border-0 absolute inset-0';

        this.innerHTML = '';
        this.appendChild(iframe);
      }, { once: true });
    });
  }

  initYouTubeFacades();
  document.addEventListener('astro:page-load', initYouTubeFacades);
</script>